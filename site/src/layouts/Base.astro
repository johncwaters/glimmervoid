---
import '../styles/global.css';
import dashboardStylesheet from '../../../public/style.css?raw';
import { extractAnimalStyles } from '../lib/animal-styles.ts';
import { extractDemoStyles } from '../lib/demo-styles.ts';
import { extractDashboardTokens } from '../lib/dashboard-tokens.ts';
import { sitePath } from '../lib/site-path.ts';

type Props = {
  title?: string;
  description?: string;
  socialImagePath?: string;
  socialImageAlt?: string;
  pageType?: 'website' | 'article';
  publishedTime?: Date;
  structuredData?: Record<string, unknown>;
  markdownPath?: string;
};

const {
  title = 'Glimmervoid',
  description = 'Mission control that ships, for Claude Code and Codex. Not a terminal multiplexer. Grids are for watching. This is for working.',
  socialImagePath = 'capture/og.png',
  socialImageAlt = 'Glimmervoid: Mission control that ships. Grids are for watching. This is for shipping. Below, the real dashboard with one session flagged as needing you.',
  pageType = 'website',
  publishedTime,
  structuredData,
  markdownPath,
} = Astro.props;
const structuredDataJson = structuredData ? JSON.stringify({ '@context': 'https://schema.org', ...structuredData }).replace(/</g, '\\u003c') : null;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
const socialImageUrl = new URL(sitePath(socialImagePath), Astro.site).href;

const dashboardTokens = extractDashboardTokens(dashboardStylesheet);
const animalSpriteUrlsByPath = import.meta.glob<string>('../../../public/animals/*.png', { eager: true, query: '?url', import: 'default' });
const animalSpriteUrlsByFileName = Object.fromEntries(Object.entries(animalSpriteUrlsByPath).map(([spritePath, spriteUrl]) => [spritePath.split('/').at(-1) ?? spritePath, spriteUrl]));
const animalStyles = extractAnimalStyles(dashboardStylesheet, animalSpriteUrlsByFileName);
const demoStyles = extractDemoStyles(dashboardStylesheet);
---
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{title}</title>
    <meta name="description" content={description}>
    <link rel="canonical" href={canonicalUrl}>
    {markdownPath && <link rel="alternate" type="text/markdown" href={sitePath(markdownPath)}>}
    <meta property="og:type" content={pageType}>
    <meta property="og:site_name" content="Glimmervoid">
    <meta property="og:title" content={title}>
    <meta property="og:description" content={description}>
    <meta property="og:url" content={canonicalUrl}>
    <meta property="og:image" content={socialImageUrl}>
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:image:alt" content={socialImageAlt}>
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()}>}
    {pageType === 'article' && <meta property="article:author" content="John C. Waters">}
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content={title}>
    <meta name="twitter:description" content={description}>
    <meta name="twitter:image" content={socialImageUrl}>
    <meta name="twitter:image:alt" content={socialImageAlt}>
    <link rel="icon" href={sitePath('favicon-192.png')} type="image/png" sizes="192x192">
    <link rel="icon" href={sitePath('favicon.svg')} type="image/svg+xml">
    <link rel="apple-touch-icon" href={sitePath('apple-touch-icon.png')}>
    <meta name="theme-color" content="#0a0810">
    {structuredDataJson && <script type="application/ld+json" set:html={structuredDataJson}></script>}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500;700&display=swap">
    <style is:global set:html={dashboardTokens}></style>
    <style is:global set:html={animalStyles}></style>
    <style is:global set:html={demoStyles}></style>
    <style is:global>
      .sky .nyan-flight { position: absolute; z-index: 1; }
      .flying-animal-preview .nyan-trail { width: 100px; }
      @media (prefers-reduced-motion: reduce) { .flying-animal-preview .nyan-sprite, .flying-animal-preview .nyan-trail { animation: none !important; } }
    </style>
    <script>
      import posthog from 'posthog-js';

      if (import.meta.env.PROD) {
        posthog.init('phc_s68t9vWmeGcrWkx4NkLQaEiVZ9sMBxv8GjQBbAcix2Sf', {
          api_host: 'https://us.i.posthog.com',
          defaults: '2026-08-30',
          cookieless_mode: 'always',
          disable_session_recording: true,
        });
      }
    </script>
  </head>
  <body>
    <div class="page">
      <slot />
    </div>
  </body>
</html>
