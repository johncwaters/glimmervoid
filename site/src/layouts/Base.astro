---
import '../styles/global.css';
import dashboardStylesheet from '../../../public/style.css?raw';
import { extractAnimalStyles } from '../lib/animal-styles.ts';
import { extractDashboardTokens } from '../lib/dashboard-tokens.ts';
import { sitePath } from '../lib/site-path.ts';

type Props = {
  title?: string;
  description?: string;
  socialImagePath?: string;
  pageType?: 'website' | 'article';
};

const {
  title = 'Glimmervoid',
  description = 'Mission control for your coding agents. Run dozens of Claude Code, Codex and Grok sessions at once. See every one. Miss nothing.',
  socialImagePath = 'capture/hero.webp',
  pageType = 'website',
} = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
const socialImageUrl = new URL(sitePath(socialImagePath), Astro.site).href;

const dashboardTokens = extractDashboardTokens(dashboardStylesheet);
const animalStyles = extractAnimalStyles(dashboardStylesheet);
---
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{title}</title>
    <meta name="description" content={description}>
    <link rel="canonical" href={canonicalUrl}>
    <meta property="og:type" content={pageType}>
    <meta property="og:site_name" content="Glimmervoid">
    <meta property="og:title" content={title}>
    <meta property="og:description" content={description}>
    <meta property="og:url" content={canonicalUrl}>
    <meta property="og:image" content={socialImageUrl}>
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content={title}>
    <meta name="twitter:description" content={description}>
    <meta name="twitter:image" content={socialImageUrl}>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500;700&display=swap">
    <style is:global set:html={dashboardTokens}></style>
    <style is:global set:html={animalStyles}></style>
    <style is:global>
      .sky .nyan-flight { position: absolute; z-index: 1; }
      .flying-animal-preview .nyan-trail { width: 100px; }
      @media (prefers-reduced-motion: reduce) { .flying-animal-preview .nyan-sprite, .flying-animal-preview .nyan-trail { animation: none !important; } }
    </style>
  </head>
  <body>
    <div class="page">
      <slot />
    </div>
  </body>
</html>
