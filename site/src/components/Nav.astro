---
import { sitePath } from '../lib/site-path.ts';

const home = sitePath('');
---
<nav class="top" aria-label="Site">
  <a class="wordmark" href={home}><span>&#x25b8;</span>GLIMMERVOID</a>
  <ul>
    <li><a href={`${home}#signals`}>How it works</a></li>
    <li><a href={`${home}#worktrees`}>Worktrees</a></li>
    <li><a href={`${home}#animals`}>Animals</a></li>
    <li><a href={`${home}#install`}>Install</a></li>
    <li><a href={sitePath('blog/')}>Blog</a></li>
    <li><a href="https://github.com/johncwaters/glimmervoid">GitHub</a></li>
  </ul>
</nav>

<style>
  nav.top { display: flex; flex-wrap: wrap; gap: 12px 24px; align-items: center; justify-content: space-between; padding-block: 20px; }
  .wordmark { font-weight: 700; letter-spacing: 0.1em; color: var(--text-head); text-decoration: none; font-size: 16px; }
  .wordmark span { color: var(--accent); }
  nav.top ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 6px 20px; font-size: 13px; }
  nav.top ul a { color: var(--text-dim); text-decoration: none; }
  nav.top ul a:hover { color: var(--text-head); }
  @media (pointer: coarse), (max-width: 640px) {
    nav.top { padding-block: 8px; gap: 0 24px; }
    .wordmark { display: inline-flex; align-items: center; min-height: 44px; }
    nav.top ul { gap: 0; margin-inline: -8px; }
    nav.top ul a { display: inline-flex; align-items: center; min-height: 44px; padding-inline: 8px; }
  }
</style>
