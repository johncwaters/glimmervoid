---
import { sitePath } from '../lib/site-path.ts';

const home = sitePath('');
---
<nav class="top" aria-label="Site">
  <a class="wordmark" href={home}><span>&#x25b8;</span>GLIMMERVOID</a>
  <ul>
    <li><a href={`${home}#remote`}>Remote</a></li>
    <li><a href={`${home}#signals`}>How it works</a></li>
    <li><a href={`${home}#worktrees`}>Worktrees</a></li>
    <li><a href={`${home}#guardrails`}>Guardrails</a></li>
    <li><a href={`${home}#animals`}>Animals</a></li>
    <li><a href={`${home}#install`}>Install</a></li>
    <li><a href={sitePath('blog/')}>Blog</a></li>
    <li><a href="https://github.com/johncwaters/glimmervoid">GitHub</a></li>
  </ul>
</nav>

<style>
  nav.top { display: flex; gap: 24px; align-items: center; justify-content: space-between; padding-block: 20px; }
  .wordmark { flex: none; font-weight: 700; letter-spacing: 0.1em; color: var(--text-head); text-decoration: none; font-size: 16px; }
  .wordmark span { color: var(--accent); }
  nav.top ul { list-style: none; margin: 0; padding: 0; display: flex; gap: 20px; font-size: 13px; white-space: nowrap; }
  nav.top ul a { color: var(--text-dim); text-decoration: none; }
  nav.top ul a:hover { color: var(--text-head); }
  @media (max-width: 860px) {
    nav.top { flex-direction: column; align-items: stretch; gap: 0; padding-block: 8px 0; }
    .wordmark { display: inline-flex; align-items: center; min-height: 44px; }
    nav.top ul {
      gap: 0; margin-inline: -20px; padding-inline: 12px; overflow-x: auto; scrollbar-width: none;
      border-block: 1px solid var(--border-dim);
      mask-image: linear-gradient(to right, transparent, #000 20px, #000 calc(100% - 28px), transparent);
    }
    nav.top ul::-webkit-scrollbar { display: none; }
    nav.top ul a { display: inline-flex; align-items: center; min-height: 44px; padding-inline: 8px; }
  }
</style>
