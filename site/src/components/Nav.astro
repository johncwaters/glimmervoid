---
import { sitePath } from '../lib/site-path.ts';

const home = sitePath('');
const navLinks = [
  { label: 'Remote', href: `${home}#remote` },
  { label: 'How it works', href: `${home}#signals` },
  { label: 'Worktrees', href: `${home}#worktrees` },
  { label: 'Guardrails', href: `${home}#guardrails` },
  { label: 'Animals', href: `${home}#animals` },
  { label: 'Install', href: `${home}#install` },
  { label: 'Blog', href: sitePath('blog/') },
  { label: 'GitHub', href: 'https://github.com/johncwaters/glimmervoid' },
];
---
<nav class="top" aria-label="Site">
  <a class="wordmark" href={home}><span>&#x25b8;</span>GLIMMERVOID</a>
  <ul class="nav-inline">
    {navLinks.map(({ label, href }) => <li><a href={href}>{label}</a></li>)}
  </ul>
  <details class="nav-menu" id="nav-menu">
    <summary>Menu</summary>
    <ul>
      {navLinks.map(({ label, href }) => <li><a href={href}>{label}</a></li>)}
    </ul>
  </details>
</nav>

<style>
  nav.top { position: relative; display: flex; gap: 24px; align-items: center; justify-content: space-between; padding-block: 20px; }
  .wordmark { flex: none; font-weight: 700; letter-spacing: 0.1em; color: var(--text-head); text-decoration: none; font-size: 16px; }
  .wordmark span { color: var(--accent); }
  nav.top ul { list-style: none; margin: 0; padding: 0; }
  nav.top ul a { color: var(--text-dim); text-decoration: none; }
  nav.top ul a:hover { color: var(--text-head); }
  .nav-inline { display: flex; gap: 20px; font-size: 13px; white-space: nowrap; }
  .nav-menu { display: none; }
  @media (max-width: 860px) {
    nav.top { padding-block: 8px; }
    .wordmark { display: inline-flex; align-items: center; min-height: 44px; }
    .nav-inline { display: none; }
    .nav-menu { display: block; }
    .nav-menu summary {
      list-style: none; cursor: pointer; display: inline-flex; align-items: center; gap: 8px; min-height: 44px; padding-inline: 14px;
      border: 1px solid var(--border); border-radius: 4px; font-size: 13px; color: var(--text);
    }
    .nav-menu summary::-webkit-details-marker { display: none; }
    .nav-menu summary::after { content: "+"; color: var(--accent); }
    .nav-menu[open] summary { border-color: var(--accent-dim); }
    .nav-menu[open] summary::after { content: "-"; }
    .nav-menu ul {
      position: absolute; z-index: 10; top: 100%; left: -20px; right: -20px; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      padding: 4px 20px 12px; background: var(--bg); border-bottom: 1px solid var(--border);
    }
    .nav-menu ul a { display: flex; align-items: center; min-height: 44px; padding-inline: 8px; font-size: 14px; }
  }
</style>

<script>
  const navMenu = document.getElementById('nav-menu');
  if (navMenu instanceof HTMLDetailsElement) {
    navMenu.addEventListener('click', (event) => {
      if (event.target instanceof Element && event.target.closest('a')) navMenu.open = false;
    });
  }
</script>
