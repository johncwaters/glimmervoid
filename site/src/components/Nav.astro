---
import { sitePath } from '../lib/site-path.ts';

const home = sitePath('');
---
<nav class="top" aria-label="Site">
  <a class="wordmark" href={home}><span>&#x25b8;</span>GLIMMERVOID</a>
  <ul>
    <li><a href="https://github.com/johncwaters/glimmervoid">GitHub</a></li>
    <li><a class="nav-install" href={`${home}#install`}>Install</a></li>
  </ul>
</nav>

<style>
  nav.top { display: flex; gap: 16px; align-items: center; justify-content: space-between; padding-block: 16px; }
  .wordmark { flex: none; display: inline-flex; align-items: center; min-height: 44px; font-weight: 700; letter-spacing: 0.1em; color: var(--text-head); text-decoration: none; font-size: 16px; }
  .wordmark span { color: var(--accent); }
  nav.top ul { list-style: none; margin: 0; padding: 0; display: flex; align-items: center; gap: 8px; }
  nav.top ul a { display: inline-flex; align-items: center; min-height: 44px; padding-inline: 12px; font-size: 15px; color: var(--text-dim); text-decoration: none; border-radius: 4px; }
  nav.top ul a:hover { color: var(--text-head); }
  nav.top ul a.nav-install { border: 1px solid var(--accent-dim); color: var(--accent); }
  nav.top ul a.nav-install:hover { background: color-mix(in srgb, var(--accent) 12%, transparent); }
</style>
