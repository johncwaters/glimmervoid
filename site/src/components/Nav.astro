---
import { BRAND_ACCENT, BRAND_MARK_VIEWBOX, brandMarkMarkup } from '../../../shared/brand-mark.ts';
import Wordmark from './Wordmark.astro';
import { siteNavLinks } from '../lib/site-nav.ts';
import { sitePath } from '../lib/site-path.ts';

const home = sitePath('');
---
<nav class="site-nav" aria-label="Main">
  <a class="brand" href={home}><svg viewBox={BRAND_MARK_VIEWBOX} aria-hidden="true" set:html={brandMarkMarkup({ frame: 'currentColor', light: BRAND_ACCENT })}></svg><Wordmark /></a>
  <ul>
    {siteNavLinks(home).map(({ label, href }) => <li><a href={href}>{label}</a></li>)}
    <li><a class="nav-install" href={`${home}#install`}>Install</a></li>
  </ul>
</nav>

<style>
  .site-nav { position: relative; display: flex; align-items: center; justify-content: space-between; gap: 24px; height: 64px; }
  .brand { display: flex; align-items: center; gap: 10px; font-family: var(--font-mono); font-weight: 700; color: var(--text-head); letter-spacing: .1em; text-transform: uppercase; font-size: var(--type-body); text-decoration: none; }
  .brand svg { width: 20px; height: 20px; }
  .site-nav ul { display: flex; gap: 24px; list-style: none; margin: 0; padding: 0; align-items: center; font-size: var(--type-body); }
  .site-nav ul a { color: var(--text-dim); text-decoration: none; }
  .site-nav ul a:hover { color: var(--text-head); }
  .site-nav ul .nav-install { display: inline-flex; align-items: center; height: 32px; padding: 0 12px; border-radius: var(--radius); background: var(--accent); color: var(--bg); font-weight: 700; text-transform: uppercase; letter-spacing: .08em; font-size: var(--type-meta); }
  .site-nav ul .nav-install:hover { color: var(--bg); background: color-mix(in oklab, var(--accent) 85%, var(--text-head)); }
  @media (max-width: 820px) {
    .site-nav ul li:not(:last-child) { display: none; }
  }
</style>
