---
import { STATUS_ICON_SHAPES } from '../../../shared/state-icons.ts';
import { SANE_YOLO_AGENT_LABELS, UNREADABLE_PATHS_KEY } from '../lib/product-facts.ts';

const COMMANDS_IN_ORDER = [
  { command: 'npm test', reason: null },
  { command: 'git reset --hard', reason: 'Eats uncommitted work' },
  { command: 'git commit -m "wip"', reason: null },
  { command: 'rm -rf "$BUILD_DIR"', reason: 'Unverifiable target' },
  { command: 'git push', reason: null },
  { command: 'git push --force', reason: 'Rewrites shared history' },
].map((entry, index) => ({ ...entry, step: index + 1 }));
const CREASE_PATHS = ['M4 10l6 1 3-6M10 11l2 8M12 19l7-5M13 12l7-2M3 15l6-2', 'M5 7l5 4 5-3M10 11l-2 8M10 11l6 5M15 8l5 4M4 14l4-1', 'M6 5l3 6-5 3M9 11l7-1 2-5M16 10l1 8M9 11l1 9'];
const COMMAND_ICON_BY_KIND = { ran: STATUS_ICON_SHAPES.complete, caught: STATUS_ICON_SHAPES.failed };
const RAN_COMMANDS = COMMANDS_IN_ORDER.filter(({ reason }) => reason === null);
const CAUGHT_COMMANDS = COMMANDS_IN_ORDER.filter(({ reason }) => reason !== null);
const describedCommands = (commands: typeof COMMANDS_IN_ORDER) => commands.map(({ command }) => command).join(', ');
const FIGURE_LABEL = `A session in Sane YOLO mode runs commands without permission prompts. ${describedCommands(RAN_COMMANDS)} run. ${CAUGHT_COMMANDS.map(({ command, reason }) => `${command} (${reason?.toLowerCase()})`).join(', ')} drop into the net.`;
---
<section id="guardrails">
  <div class="yolo reveal">
    <div class="yolo-copy">
      <h2>You only live once.<br>Your repo gets a net.</h2>
      <p>Sane YOLO skips the prompts. Safe commands run. The rest land in the net.</p>
    </div>
    <figure class="yolo-drop" id="yolo-drop" role="img" aria-label={FIGURE_LABEL}>
      <div class="yolo-session" aria-hidden="true">
        <svg class="yolo-icon is-working" viewBox="0 0 16 16" aria-hidden="true">{STATUS_ICON_SHAPES.working.map(({ tag: Shape, attributes }) => <Shape {...attributes} />)}</svg>
        <span class="yolo-badge">Sane YOLO</span>
      </div>
      <ol class="yolo-terminal" aria-hidden="true">
        {COMMANDS_IN_ORDER.map(({ command, reason, step }) => {
          const kind = reason === null ? 'ran' : 'caught';
          return (
            <li data-yolo-step={step} data-kind={kind} data-state={kind === 'ran' ? 'ran' : 'gone'}>
              <span class="yolo-prompt">$</span>
              <span class="yolo-command" data-command={command}>{command}</span>
              <svg class={`yolo-icon is-${kind}`} viewBox="0 0 16 16" aria-hidden="true">{COMMAND_ICON_BY_KIND[kind].map(({ tag: Shape, attributes }) => <Shape {...attributes} />)}</svg>
            </li>
          );
        })}
      </ol>
      <div class="yolo-catch" aria-hidden="true">
        <svg class="yolo-net" aria-hidden="true">
          <path class="yolo-mesh" />
          <path class="yolo-mesh is-strained" />
          <path class="yolo-net-edge" />
        </svg>
        {CAUGHT_COMMANDS.map(({ command, step }) => (
          <span class="yolo-ball" data-yolo-ball={step}>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d={CREASE_PATHS[step % CREASE_PATHS.length]} /></svg>
          </span>
        ))}
      </div>
    </figure>
  </div>
  <details class="ledger-details reveal">
    <summary>See exactly what is blocked</summary>
    <p class="ledger-intro">Accident protection, not a security boundary. Your sessions get Sane YOLO in {SANE_YOLO_AGENT_LABELS}. Lanes are the automated sessions that read pull requests and error reports.</p>
    <div class="ledger diagram reveal">
      <table aria-label="What your sessions and automated lanes can and cannot do">
        <thead>
          <tr>
            <td></td>
            <th scope="col" class="yes"><span class="column-name">Your sessions</span><span class="posture">Allowed unless blocked</span></th>
            <th scope="col" class="no"><span class="column-name">Automated lanes</span><span class="posture">Blocked unless allowed</span></th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <th scope="row" class="aspect">Writes</th>
            <td class="yes"><span class="verdict">Anywhere</span><span class="detail">Destructive commands such as <code>git reset --hard</code> are refused</span></td>
            <td class="no"><span class="verdict">Their own folder</span><span class="detail">Not even git hooks</span></td>
          </tr>
          <tr>
            <th scope="row" class="aspect">Reads</th>
            <td class="yes"><span class="verdict">Everywhere</span><span class="detail">Except credentials and your <code>{UNREADABLE_PATHS_KEY}</code></span></td>
            <td class="no"><span class="verdict">No credentials</span><span class="detail">Nor Glimmervoid's own files</span></td>
          </tr>
          <tr>
            <th scope="row" class="aspect">Network</th>
            <td class="yes"><span class="verdict">Open</span></td>
            <td class="no"><span class="verdict">Approved hosts only</span><span class="detail">Open for lanes that push a fix</span></td>
          </tr>
          <tr>
            <th scope="row" class="aspect">Tools</th>
            <td class="yes"><span class="verdict">Everything</span></td>
            <td class="no"><span class="verdict">Their own terminal</span></td>
          </tr>
          <tr>
            <th scope="row" class="aspect">Turn off</th>
            <td class="yes"><span class="verdict">Per project</span></td>
            <td class="no"><span class="verdict">Never</span></td>
          </tr>
        </tbody>
      </table>
    </div>
  </details>
</section>

<style>
  .ledger { padding: 0; overflow-x: visible; }
  .ledger table { width: 100%; table-layout: fixed; border-collapse: collapse; }
  .ledger tr { border-top: 1px solid var(--border-dim); }
  .ledger thead tr { border-top: 0; }
  .ledger th, .ledger td { padding: 12px 18px; text-align: left; vertical-align: top; font-weight: 400; }
  .ledger thead td { width: 8rem; }
  .ledger th.no, .ledger td.no { background: color-mix(in srgb, var(--border-dim) 45%, transparent); border-left: 1px solid var(--border-dim); }
  .ledger thead th { padding-block: 16px; }
  .ledger .column-name, .ledger .posture, .ledger .verdict, .ledger .detail { display: block; }
  .ledger .posture { margin-top: 4px; }
  .ledger .column-name, .ledger .aspect { font-size: 14px; letter-spacing: 0.08em; text-transform: uppercase; font-weight: 700; color: var(--text-dim); }
  .ledger thead .yes .column-name { color: var(--accent); }
  .ledger thead .no .column-name { color: var(--text-head); }
  .ledger .posture, .ledger .verdict { font-weight: 700; color: var(--text-head); }
  .ledger .aspect { padding-top: 15px; }
  .ledger .verdict { padding-left: 1.4em; text-indent: -1.4em; }
  .ledger .verdict::before { display: inline-block; width: 1.4em; text-indent: 0; }
  .ledger .yes .verdict::before { content: '\2713'; color: var(--state-running); }
  .ledger .no .verdict::before { content: '\2715'; color: var(--text-dim); }
  .ledger .detail { font-size: 15px; color: var(--text-dim); }
  .ledger .detail { margin-top: 2px; padding-left: 1.4em; }
  .ledger code, .yolo-copy code { font-size: inherit; overflow-wrap: anywhere; }
  .yolo-copy p { color: var(--text-dim); font-size: 17px; }
  .ledger-details { margin-top: 40px; }
  .ledger-details summary { cursor: pointer; display: inline-flex; align-items: center; gap: 8px; min-height: 44px; color: var(--accent); }
  .ledger-details summary::after { content: '+'; }
  .ledger-details[open] summary::after { content: '-'; }
  .ledger-intro { margin: 8px 0 20px; max-width: 70ch; color: var(--text-dim); }
  .yolo { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 32px; align-items: center; margin-top: 0; }
  .yolo-copy { display: flex; flex-direction: column; gap: 14px; max-width: 60ch; }
  .yolo-drop { container-type: inline-size; margin: 0; min-width: 0; border: 1px solid var(--border); border-radius: 6px; background: var(--bg-card); padding: 0 0 8px; }
  .yolo-session { display: flex; align-items: center; gap: 10px; padding: 10px 16px; border-bottom: 1px solid var(--border-dim); }
  .yolo-badge { margin-left: auto; font-family: var(--font-mono); font-size: 11px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; line-height: 18px; padding: 0 6px; border-radius: 2px; color: var(--perms-warn); border: 1px solid color-mix(in oklab, var(--perms-warn) 55%, transparent); background: color-mix(in oklab, var(--perms-warn) 14%, transparent); }
  .yolo-icon { flex: none; width: 13px; height: 13px; }
  .yolo-icon.is-working { color: var(--state-running); }
  .yolo-icon.is-ran { color: var(--state-complete); }
  .yolo-icon.is-caught { color: var(--state-waiting); }
  .yolo-terminal { list-style: none; margin: 0; padding: 12px 16px 0; min-height: calc(4 * 26px + 12px); display: flex; flex-direction: column; font-family: var(--font-mono); font-size: 14px; }
  .yolo-terminal li { display: flex; align-items: center; gap: 8px; height: 26px; white-space: nowrap; transition: height 320ms var(--ease-out-expo), opacity 200ms linear; }
  .yolo-terminal li[data-state="hidden"], .yolo-terminal li[data-state="gone"] { height: 0; opacity: 0; }
  .yolo-terminal li[data-state="clearing"] { opacity: 0; transition: opacity 320ms linear; }
  .yolo-terminal li[data-state="clearing"][data-kind="caught"] { height: 0; }
  .yolo-terminal li[data-state="torn"] { height: 0; opacity: 0; transition: height 360ms var(--ease-out-expo) 160ms, opacity 160ms linear; }
  .yolo-terminal li[data-state="torn"] .yolo-command { scale: 0.2 0.6; transition: scale 200ms var(--ease-in-expo); }
  .yolo-terminal .yolo-command { display: inline-block; transform-origin: 50% 50%; }
  .yolo-prompt { color: var(--text-dim); }
  .yolo-command { color: var(--text-head); }
  .yolo-terminal .yolo-icon { opacity: 0; scale: 0.4; transition: opacity 160ms linear, scale 320ms cubic-bezier(0.34, 1.56, 0.64, 1); }
  .yolo-terminal li[data-state="ran"] .yolo-icon, .yolo-terminal li[data-state="flagged"] .yolo-icon { opacity: 1; scale: 1; }
  .yolo-terminal li[data-state="typing"] .yolo-command::after { content: ''; display: inline-block; width: 0.6em; height: 1.1em; margin-left: 1px; vertical-align: text-bottom; background: var(--accent); }
  .yolo-terminal li[data-state="flagged"] { animation: yolo-flag-shake 360ms linear; }
  .yolo-terminal li[data-state="flagged"] .yolo-command { color: var(--state-waiting); }
  .yolo-catch { position: relative; height: 168px; margin-top: 4px; }
  .yolo-net { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; transition: opacity 480ms var(--ease-out-expo); }
  .yolo-drop[data-clearing="true"] .yolo-net { opacity: 0; transition: opacity 320ms linear; }
  .yolo-mesh { fill: none; stroke: var(--accent-dim); stroke-width: 1; }
  .yolo-mesh.is-strained { stroke: var(--accent); stroke-width: 1.5; }
  .yolo-net-edge { fill: none; stroke: var(--accent); stroke-width: 2; stroke-linejoin: round; stroke-linecap: round; }
  .yolo-ball { position: absolute; left: 0; top: 0; width: 26px; height: 26px; border-radius: 50%; background: radial-gradient(circle at 34% 30%, color-mix(in oklab, var(--state-waiting) 55%, white) 0, var(--state-waiting) 42%, color-mix(in oklab, var(--state-waiting) 50%, black) 100%); box-shadow: 0 5px 10px -4px rgb(0 0 0 / 0.75); opacity: 0; transition: opacity 320ms linear; will-change: translate, rotate; }
  .yolo-ball svg { display: block; width: 100%; height: 100%; fill: none; stroke: color-mix(in oklab, var(--state-waiting) 45%, black); stroke-width: 1.3; stroke-linecap: round; stroke-linejoin: round; }
  .yolo-ball[data-on="true"] { opacity: 1; transition: none; }
  .yolo-ball[data-crumpling="true"] { animation: yolo-crumple 280ms var(--ease-out-expo); }
  @keyframes yolo-crumple {
    0% { scale: 3.2 0.7; border-radius: 4px; }
    100% { scale: 1; border-radius: 50%; }
  }
  @keyframes yolo-flag-shake {
    0%, 100% { translate: 0; }
    20%, 60% { translate: -3px; }
    40%, 80% { translate: 3px; }
  }
  @media (max-width: 820px) { .yolo { grid-template-columns: minmax(0, 1fr); } }
  @media (max-width: 720px) {
    .ledger table, .ledger thead, .ledger tbody { display: block; }
    .ledger tr { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); }
    .ledger thead td { display: none; }
    .ledger th, .ledger td { padding: 10px 12px; min-width: 0; }
    .ledger .aspect { grid-column: 1 / -1; padding: 12px 12px 0; }
    .ledger tbody td.yes { border-left: 0; }
    .ledger .posture, .ledger .verdict { font-size: 15px; }
    .ledger .detail { font-size: 14px; }
  }
</style>


<script>
  import { prefersReducedMotion } from '../lib/dom.ts';
  import { BEAT_MS } from '../lib/feature-frames.ts';

  type NetPoint = { x: number; y: number; previousX: number; previousY: number; restX: number; restY: number; isPinned: boolean };
  type Spring = { from: NetPoint; to: NetPoint; restLength: number; isDrawn: boolean };
  type Net = { rows: NetPoint[][]; springs: Spring[] };
  type Ball = {
    element: HTMLElement;
    width: number;
    height: number;
    x: number;
    y: number;
    angleDeg: number;
    velocityX: number;
    velocityY: number;
    landingX: number;
    stackLevel: number;
    spinDirection: number;
    isFalling: boolean;
    isLanded: boolean;
  };
  type SceneStep = { durationMs: number; onStart?: () => void; onTick?: (elapsedMs: number) => void };

  const STEP_MS = 1000 / 60;
  const NET_ROW_COUNT = 6;
  const NET_RIM_Y = 6;
  const NET_DEPTH_SHARE = 0.5;
  const NET_DAMPING = 0.965;
  const NET_RETURN_PULL = 0.004;
  const SPRING_PASSES = 4;
  const SPRING_STIFFNESS = 0.035;
  const BALL_GRAVITY = 0.55;
  const BALL_TOSS_VELOCITY = -7;
  const BALL_LOAD = 4.2;
  const BALL_WEIGHT_SPREAD = 1.8;
  const BALL_IMPACT_SHARE = 1.6;
  const STACK_OVERLAP = 0.84;
  const BALL_SPIN_DEG_PER_FRAME = 7;
  const BALL_ROLL_DEG_PER_PX = 4.4;
  const STRAIN_RATIO = 1.045;
  const LANDING_SPOTS = [
    { offsetInBallWidths: -0.52, stackLevel: 0 },
    { offsetInBallWidths: 0.52, stackLevel: 0 },
    { offsetInBallWidths: 0, stackLevel: 1 },
  ];
  const TYPE_MS_PER_CHARACTER = 42;
  const SETTLE_STEP_COUNT = 360;

  function buildNet(width: number, height: number): Net {
    const columnCount = Math.max(9, Math.round(width / 24) | 1);
    const centerX = width / 2;
    const maxDepth = height * NET_DEPTH_SHARE;
    const rows = Array.from({ length: NET_ROW_COUNT }, (_, rowIndex) => {
      const depthShare = rowIndex / (NET_ROW_COUNT - 1);
      return Array.from({ length: columnCount }, (_, columnIndex) => {
        const across = -0.94 + (1.88 * columnIndex) / (columnCount - 1);
        const rimX = 8 + ((width - 16) * columnIndex) / (columnCount - 1);
        const restX = centerX + (rimX - centerX) * (1 - 0.22 * depthShare);
        const restY = NET_RIM_Y + depthShare * maxDepth * Math.pow(1 - across * across, 0.7);
        return { x: restX, y: restY, previousX: restX, previousY: restY, restX, restY, isPinned: rowIndex === 0 };
      });
    });
    const springs: Spring[] = [];
    const link = (from: NetPoint | undefined, to: NetPoint | undefined, isDrawn: boolean) => {
      if (!from || !to) return;
      springs.push({ from, to, restLength: Math.hypot(to.restX - from.restX, to.restY - from.restY), isDrawn });
    };
    rows.forEach((row, rowIndex) => {
      const nextRow = rows[rowIndex + 1];
      row.forEach((point, columnIndex) => {
        link(point, row[columnIndex + 1], false);
        if (!nextRow) return;
        link(point, nextRow[columnIndex], false);
        link(point, nextRow[columnIndex + 1], true);
        link(point, nextRow[columnIndex - 1], true);
      });
    });
    return { rows, springs };
  }

  function bottomRow(net: Net): NetPoint[] {
    return net.rows[net.rows.length - 1];
  }

  function surfaceAt(net: Net, x: number): number {
    const row = bottomRow(net);
    const segmentIndex = row.findIndex((point, index) => index > 0 && point.x >= x);
    const right = row[segmentIndex > 0 ? segmentIndex : row.length - 1];
    const left = row[segmentIndex > 0 ? segmentIndex - 1 : row.length - 2];
    const span = right.x - left.x || 1;
    const share = Math.min(1, Math.max(0, (x - left.x) / span));
    return left.y + (right.y - left.y) * share;
  }

  function pointsUnder(net: Net, ball: Ball): NetPoint[] {
    const row = bottomRow(net);
    const under = row.filter((point) => Math.abs(point.x - ball.x) <= ball.width * BALL_WEIGHT_SPREAD);
    if (under.length > 0) return under;
    return [row.reduce((nearest, point) => (Math.abs(point.x - ball.x) < Math.abs(nearest.x - ball.x) ? point : nearest))];
  }

  function stepNet(net: Net, balls: Ball[]): void {
    for (const point of net.rows.flat()) {
      if (point.isPinned) continue;
      const velocityX = (point.x - point.previousX) * NET_DAMPING;
      const velocityY = (point.y - point.previousY) * NET_DAMPING;
      point.previousX = point.x;
      point.previousY = point.y;
      point.x += velocityX + (point.restX - point.x) * NET_RETURN_PULL;
      point.y += velocityY + (point.restY - point.y) * NET_RETURN_PULL;
    }
    for (const ball of balls) {
      if (!ball.isLanded) continue;
      const under = pointsUnder(net, ball);
      for (const point of under) point.y += BALL_LOAD / under.length;
    }
    for (let pass = 0; pass < SPRING_PASSES; pass += 1) {
      for (const spring of net.springs) {
        const deltaX = spring.to.x - spring.from.x;
        const deltaY = spring.to.y - spring.from.y;
        const length = Math.hypot(deltaX, deltaY) || 1;
        if (length <= spring.restLength) continue;
        const correction = ((length - spring.restLength) / length / 2) * SPRING_STIFFNESS;
        const freeEnds = Number(!spring.from.isPinned) + Number(!spring.to.isPinned);
        const share = freeEnds === 2 ? correction : correction * 2;
        if (!spring.from.isPinned) {
          spring.from.x += deltaX * share;
          spring.from.y += deltaY * share;
        }
        if (!spring.to.isPinned) {
          spring.to.x -= deltaX * share;
          spring.to.y -= deltaY * share;
        }
      }
    }
  }

  function restingBottomY(net: Net, ball: Ball, x = ball.x): number {
    return surfaceAt(net, x) - ball.stackLevel * ball.height * STACK_OVERLAP;
  }

  function tossTowardLanding(net: Net, ball: Ball): void {
    const dropHeight = Math.max(0, restingBottomY(net, ball, ball.landingX) - ball.height / 2 - ball.y);
    const flightFrames = (-BALL_TOSS_VELOCITY + Math.sqrt(BALL_TOSS_VELOCITY ** 2 + 2 * BALL_GRAVITY * dropHeight)) / BALL_GRAVITY;
    ball.velocityY = BALL_TOSS_VELOCITY;
    ball.velocityX = (ball.landingX - ball.x) / flightFrames;
    ball.isFalling = true;
  }

  function stepBall(net: Net, ball: Ball): void {
    if (ball.isLanded) {
      ball.y = restingBottomY(net, ball) - ball.height / 2;
      return;
    }
    if (!ball.isFalling) return;
    ball.velocityY += BALL_GRAVITY;
    ball.x += ball.velocityX;
    ball.y += ball.velocityY;
    ball.angleDeg += BALL_SPIN_DEG_PER_FRAME * ball.spinDirection + ball.velocityX * BALL_ROLL_DEG_PER_PX;
    const landingY = restingBottomY(net, ball) - ball.height / 2;
    if (ball.velocityY < 0 || ball.y < landingY) return;
    ball.y = landingY;
    ball.isFalling = false;
    ball.isLanded = true;
    const under = pointsUnder(net, ball);
    for (const point of under) point.previousY -= (ball.velocityY * BALL_IMPACT_SHARE) / Math.sqrt(under.length);
  }

  function drawNet(net: Net, meshPath: Element, strainedPath: Element, edgePath: Element): void {
    const segment = ({ from, to }: Spring) => `M${from.x.toFixed(1)} ${from.y.toFixed(1)}L${to.x.toFixed(1)} ${to.y.toFixed(1)}`;
    const drawn = net.springs.filter((spring) => spring.isDrawn);
    const isStrained = (spring: Spring) => Math.hypot(spring.to.x - spring.from.x, spring.to.y - spring.from.y) > spring.restLength * STRAIN_RATIO;
    meshPath.setAttribute('d', drawn.filter((spring) => !isStrained(spring)).map(segment).join(''));
    strainedPath.setAttribute('d', drawn.filter(isStrained).map(segment).join(''));
    const leftEdge = net.rows.map((row) => row[0]);
    const rightEdge = net.rows.map((row) => row[row.length - 1]).reverse();
    const outline = [...leftEdge, ...bottomRow(net).slice(1, -1), ...rightEdge];
    const rim = net.rows[0];
    const outlinePath = outline.map((point, index) => `${index === 0 ? 'M' : 'L'}${point.x.toFixed(1)} ${point.y.toFixed(1)}`).join('');
    edgePath.setAttribute('d', `${outlinePath}M${rim[0].x} ${rim[0].y}L${rim[rim.length - 1].x} ${rim[rim.length - 1].y}`);
  }

  function drawBall(ball: Ball): void {
    ball.element.style.translate = `${(ball.x - ball.width / 2).toFixed(1)}px ${(ball.y - ball.height / 2).toFixed(1)}px`;
    ball.element.style.rotate = `${ball.angleDeg.toFixed(2)}deg`;
  }

  function startYoloDrop(): void {
    const figure = document.getElementById('yolo-drop');
    const catchArea = figure?.querySelector<HTMLElement>('.yolo-catch');
    const netSvg = figure?.querySelector('.yolo-net');
    const [meshPath, strainedPath] = figure ? [...figure.querySelectorAll('.yolo-mesh')] : [];
    const edgePath = figure?.querySelector('.yolo-net-edge');
    if (!figure || !catchArea || !netSvg || !meshPath || !strainedPath || !edgePath) return;
    const lines = [...figure.querySelectorAll<HTMLElement>('.yolo-terminal li')];
    const caughtLines = lines.filter((line) => line.dataset.kind === 'caught');
    const balls: Ball[] = caughtLines.map((line, caughtIndex) => ({
      element: figure.querySelector<HTMLElement>(`[data-yolo-ball="${line.dataset.yoloStep}"]`) ?? line,
      width: 0, height: 0, x: 0, y: 0, angleDeg: 0, velocityX: 0, velocityY: 0, landingX: 0,
      stackLevel: LANDING_SPOTS[caughtIndex % LANDING_SPOTS.length].stackLevel,
      spinDirection: caughtIndex % 2 === 0 ? 1 : -1,
      isFalling: false,
      isLanded: false,
    }));
    let net = buildNet(catchArea.clientWidth, catchArea.clientHeight);

    const draw = () => {
      drawNet(net, meshPath, strainedPath, edgePath);
      balls.forEach(drawBall);
    };
    const stepPhysics = () => {
      stepNet(net, balls);
      for (const ball of balls) stepBall(net, ball);
    };
    const measureCards = () => {
      for (const [caughtIndex, ball] of balls.entries()) {
        ball.width = ball.element.offsetWidth;
        ball.height = ball.element.offsetHeight;
        ball.landingX = catchArea.clientWidth / 2 + LANDING_SPOTS[caughtIndex % LANDING_SPOTS.length].offsetInBallWidths * ball.width;
      }
    };
    const showSettledScene = () => {
      net = buildNet(catchArea.clientWidth, catchArea.clientHeight);
      measureCards();
      figure.dataset.clearing = 'false';
      for (const line of lines) {
        line.dataset.state = line.dataset.kind === 'ran' ? 'ran' : 'gone';
        const commandText = line.querySelector<HTMLElement>('.yolo-command');
        if (commandText) commandText.textContent = commandText.dataset.command ?? '';
      }
      for (const ball of balls) {
        ball.x = ball.landingX;
        ball.isFalling = false;
        ball.isLanded = true;
        ball.element.dataset.on = 'true';
      }
      for (let step = 0; step < SETTLE_STEP_COUNT; step += 1) stepPhysics();
      draw();
    };

    const refitSettledScene = () => {
      netSvg.setAttribute('viewBox', `0 0 ${catchArea.clientWidth} ${catchArea.clientHeight}`);
      showSettledScene();
    };
    refitSettledScene();
    if (prefersReducedMotion()) {
      new ResizeObserver(refitSettledScene).observe(catchArea);
      return;
    }

    const tearOut = (line: HTMLElement, ball: Ball) => {
      const commandBox = (line.querySelector('.yolo-command') ?? line).getBoundingClientRect();
      const catchBox = catchArea.getBoundingClientRect();
      ball.x = commandBox.left - catchBox.left + commandBox.width / 2;
      ball.y = commandBox.top - catchBox.top + commandBox.height / 2;
      ball.angleDeg = 0;
      ball.isFalling = false;
      ball.isLanded = false;
      ball.element.dataset.on = 'true';
      ball.element.dataset.crumpling = 'true';
      ball.element.addEventListener('animationend', () => {
        ball.element.dataset.crumpling = 'false';
        if (ball.isLanded || ball.element.dataset.on !== 'true') return;
        tossTowardLanding(net, ball);
      }, { once: true });
      drawBall(ball);
      line.dataset.state = 'torn';
    };
    const commandSteps = lines.flatMap((line): SceneStep[] => {
      const commandText = line.querySelector<HTMLElement>('.yolo-command');
      const fullCommand = commandText?.dataset.command ?? '';
      const typing: SceneStep = {
        durationMs: 180 + fullCommand.length * TYPE_MS_PER_CHARACTER,
        onStart: () => {
          line.dataset.state = 'typing';
          if (commandText) commandText.textContent = '';
        },
        onTick: (elapsedMs) => {
          if (commandText) commandText.textContent = fullCommand.slice(0, Math.max(0, Math.floor((elapsedMs - 180) / TYPE_MS_PER_CHARACTER) + 1));
        },
      };
      const settleText = () => {
        if (commandText) commandText.textContent = fullCommand;
      };
      if (line.dataset.kind === 'ran') {
        return [typing, { durationMs: 0.25 * BEAT_MS }, { durationMs: 0.75 * BEAT_MS, onStart: () => { settleText(); line.dataset.state = 'ran'; } }];
      }
      const ball = balls[caughtLines.indexOf(line)];
      return [
        typing,
        { durationMs: 0.25 * BEAT_MS },
        { durationMs: 0.7 * BEAT_MS, onStart: () => { settleText(); line.dataset.state = 'flagged'; } },
        { durationMs: 1.6 * BEAT_MS, onStart: () => tearOut(line, ball) },
      ];
    });
    const clearScene = () => {
      figure.dataset.clearing = 'true';
      for (const ball of balls) ball.element.dataset.on = 'false';
    };
    const resetScene = () => {
      net = buildNet(catchArea.clientWidth, catchArea.clientHeight);
      figure.dataset.clearing = 'false';
      for (const line of lines) line.dataset.state = 'hidden';
      for (const ball of balls) {
        ball.isLanded = false;
        ball.isFalling = false;
      }
    };
    const sceneSteps: SceneStep[] = [
      { durationMs: 4 * BEAT_MS },
      { durationMs: 0.6 * BEAT_MS, onStart: () => { clearScene(); for (const line of lines) line.dataset.state = 'clearing'; } },
      { durationMs: 0.8 * BEAT_MS, onStart: resetScene },
      ...commandSteps,
    ];

    let isOnScreen = false;
    let stepIndex = 0;
    let stepElapsedMs = 0;
    let leftoverMs = 0;
    let lastFrameAt: number | null = null;
    let frameRequest: number | null = null;
    const advanceScene = (elapsedMs: number) => {
      stepElapsedMs += elapsedMs;
      while (stepElapsedMs >= sceneSteps[stepIndex].durationMs) {
        stepElapsedMs -= sceneSteps[stepIndex].durationMs;
        stepIndex = (stepIndex + 1) % sceneSteps.length;
        sceneSteps[stepIndex].onStart?.();
      }
      sceneSteps[stepIndex].onTick?.(stepElapsedMs);
    };
    const runFrame = (frameAt: number) => {
      frameRequest = null;
      if (!isOnScreen || document.hidden) {
        lastFrameAt = null;
        return;
      }
      const elapsedMs = Math.min(64, lastFrameAt === null ? 0 : frameAt - lastFrameAt);
      lastFrameAt = frameAt;
      advanceScene(elapsedMs);
      leftoverMs += elapsedMs;
      while (leftoverMs >= STEP_MS) {
        stepPhysics();
        leftoverMs -= STEP_MS;
      }
      draw();
      frameRequest = requestAnimationFrame(runFrame);
    };
    const wake = () => {
      if (frameRequest !== null || !isOnScreen || document.hidden) return;
      frameRequest = requestAnimationFrame(runFrame);
    };
    new IntersectionObserver(([entry]) => {
      isOnScreen = entry.isIntersecting;
      wake();
    }).observe(figure);
    document.addEventListener('visibilitychange', wake);
    let observedWidth = catchArea.clientWidth;
    new ResizeObserver(() => {
      if (catchArea.clientWidth === observedWidth) return;
      observedWidth = catchArea.clientWidth;
      refitSettledScene();
      stepIndex = 0;
      stepElapsedMs = 0;
    }).observe(catchArea);
  }

  startYoloDrop();
</script>
