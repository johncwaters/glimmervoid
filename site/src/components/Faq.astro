---
import { FAQ_ENTRIES } from '../lib/faq.ts';
---
<section id="faq">
  <div class="section-head reveal">
    <h2>Asked and answered.</h2>
  </div>
  <div class="faq-entries reveal">
    {FAQ_ENTRIES.map(({ question, answer }) => (
      <details class="faq-entry">
        <summary><h3>{question}</h3></summary>
        <p>{answer}</p>
      </details>
    ))}
  </div>
</section>

<style>
  .faq-entries { display: flex; flex-direction: column; max-width: 72ch; border-top: 1px solid var(--border); }
  .faq-entry { border-bottom: 1px solid var(--border); }
  .faq-entry summary { display: flex; align-items: center; justify-content: space-between; gap: 16px; min-height: 44px; padding: 14px 0; cursor: pointer; list-style: none; }
  .faq-entry summary::-webkit-details-marker { display: none; }
  .faq-entry summary::after { content: '+'; flex: none; color: var(--accent); font-size: 20px; }
  .faq-entry[open] summary::after { content: '-'; }
  .faq-entry summary:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .faq-entry h3 { margin: 0; font-size: 16px; }
  .faq-entry p { margin: 0 0 18px; color: var(--text-dim); }
</style>
