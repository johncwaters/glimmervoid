---
import Animals from './Animals.astro';
---
<section id="fun">
  <div class="section-head reveal">
    <h2>Every merge gets a party.</h2>
    <p>It waits in the trophy tray until you're back.</p>
  </div>
  <div class="celebration-demo" id="celebration-demo">
    <div class="trophy-stage">
      <div class="celebration-tray" id="celebration-tray" data-state="empty">
        <button class="btn-celebrations" id="btn-celebrations" type="button" title="Play queued merge celebrations" aria-label="Play queued merge celebrations"><svg class="btn-celebrations-icon" viewBox="0 0 16 16" width="15" height="15" aria-hidden="true" focusable="false"><path d="M4.5 2h7v3.5a3.5 3.5 0 0 1-7 0z" /><path d="M4.5 3.5H2.5a2 2 0 0 0 2 2.5" /><path d="M11.5 3.5h2a2 2 0 0 1-2 2.5" /><path d="M8 9v3" /><path d="M5.5 14h5" /></svg></button>
        <span class="celebration-tray-count" id="celebration-tray-count" aria-live="polite"></span>
      </div>
      <p class="trophy-callout" aria-hidden="true"><span class="trophy-arrow">&#x2190;</span> Tap the trophy</p>
    </div>
    <div class="queue-row">
      <button class="queue-merge" id="queue-merge" type="button">Queue a merge</button>
    </div>
  </div>
  <Animals />
</section>

<script>
  import { mountCelebrationTray, queueMergeCelebration } from '../../../public/merge-celebration.ts';
  import { markWhileOnScreen } from '../lib/dom.ts';

  const DEMO_PULL_REQUEST_TITLES = ['Fix the auth redirect loop', 'Stabilize the flaky upload test', 'Migrate billing to the new ledger', 'Bump Node to 22', 'Rename the color tokens'];
  const tray = document.getElementById('celebration-tray');
  const trophyButton = document.getElementById('btn-celebrations');
  const count = document.getElementById('celebration-tray-count');
  const queueButton = document.getElementById('queue-merge');
  let queuedMergeCount = 0;

  function queueDemoMerge(): void {
    const title = DEMO_PULL_REQUEST_TITLES[queuedMergeCount % DEMO_PULL_REQUEST_TITLES.length];
    queuedMergeCount += 1;
    queueMergeCelebration({ message: `Merged acme/app#${100 + queuedMergeCount}`, detailLines: [title] });
  }

  const demo = document.getElementById('celebration-demo');
  if (demo) markWhileOnScreen(demo);
  if (tray && trophyButton instanceof HTMLButtonElement && count && queueButton) {
    mountCelebrationTray(tray, trophyButton, count);
    queueDemoMerge();
    queueDemoMerge();
    queueButton.addEventListener('click', queueDemoMerge);
  }
</script>

<style>
  .celebration-demo { margin-bottom: 48px; display: flex; flex-direction: column; gap: 18px; width: fit-content; max-width: 100%; border: 1px solid var(--border); border-radius: 6px; background: var(--bg-card); padding: 22px 22px 16px; }
  .trophy-stage { display: flex; align-items: center; gap: 18px; }
  .celebration-demo .celebration-tray .btn-celebrations { width: 64px; height: 64px; border-radius: 10px; border-width: 2px; }
  .celebration-demo .celebration-tray .btn-celebrations-icon { width: 30px; height: 30px; }
  .celebration-demo .celebration-tray .celebration-tray-count { top: -9px; right: -9px; min-width: 22px; height: 22px; border-radius: 11px; font-size: 12px; line-height: 22px; }
  .celebration-demo .celebration-tray[data-state="queued"] .btn-celebrations { background: color-mix(in srgb, var(--state-complete) 12%, transparent); }
  .celebration-demo .celebration-tray::before { content: ''; position: absolute; inset: 0; border: 2px solid var(--state-complete); border-radius: 10px; opacity: 0; pointer-events: none; }
  .celebration-demo .celebration-tray[data-state="queued"]::before { animation: trophy-pulse 1.6s var(--ease-out-expo) infinite; }
  .celebration-demo .celebration-tray[data-state="queued"] .btn-celebrations-icon { animation: trophy-wiggle 1.6s infinite; }
  .trophy-callout { margin: 0; font-size: 16px; font-weight: 700; color: var(--state-complete); transition: opacity var(--transition-fast); }
  .trophy-arrow { display: inline-block; animation: trophy-nudge 1.6s infinite; }
  .celebration-demo:not([data-on-screen="true"]) .celebration-tray[data-state="queued"]::before, .celebration-demo:not([data-on-screen="true"]) .celebration-tray[data-state="queued"] .btn-celebrations-icon, .celebration-demo:not([data-on-screen="true"]) .trophy-arrow { animation-play-state: paused; }
  .celebration-demo:has(.celebration-tray:not([data-state="queued"])) .trophy-callout { opacity: 0; }
  .queue-row { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; padding-top: 14px; border-top: 1px solid var(--border-dim); }
  .queue-merge { height: var(--header-control-height); border: 1px solid var(--border); border-radius: 4px; background: var(--bg); color: var(--text); font: inherit; font-size: 14px; padding: 0 14px; min-height: 40px; cursor: pointer; }
  .queue-merge:hover { border-color: var(--accent); color: var(--text-head); }
  @keyframes trophy-pulse {
    from { opacity: 0.55; transform: scale(1); }
    to { opacity: 0; transform: scale(1.5); }
  }
  @keyframes trophy-wiggle {
    0%, 60%, 100% { rotate: 0deg; animation-timing-function: var(--ease-out-expo); }
    64% { rotate: 4deg; animation-timing-function: var(--ease-out-expo); }
    72% { rotate: -12deg; animation-timing-function: var(--ease-out-expo); }
    81% { rotate: 10deg; animation-timing-function: var(--ease-out-expo); }
    90% { rotate: -5deg; animation-timing-function: var(--ease-out-expo); }
  }
  @keyframes trophy-nudge {
    0%, 100% { translate: 0 0; animation-timing-function: var(--ease-out-expo); }
    20% { translate: 3px 0; animation-timing-function: var(--ease-out-expo); }
    45% { translate: -8px 0; animation-timing-function: var(--ease-out-expo); }
    70% { translate: 0 0; animation-timing-function: var(--ease-out-expo); }
  }
  @media (prefers-reduced-motion: reduce) {
    .celebration-demo .celebration-tray[data-state="queued"]::before { animation: none; opacity: 0.4; }
    .celebration-demo .celebration-tray[data-state="queued"] .btn-celebrations-icon, .trophy-arrow { animation: none; }
  }
</style>
