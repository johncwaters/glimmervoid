---
import { STATE_ICONS, STATUS_ICON_SHAPES } from '../../../shared/state-icons.ts';
import { BADGE_LABELS, STATES } from '../../../shared/states.ts';
import { AGENT_CARDS } from '../lib/product-facts.ts';
import { ATTENTION_FRAMES, FIRST_ATTENTION_FRAME, attentionBannerOf } from '../lib/attention-frames.ts';

const SHOWN_STATES = [STATES.RUNNING, STATES.WAITING, STATES.COMPLETE, STATES.FAILED];
const SESSION_TASKS = ['fix-auth-redirect', 'flaky-upload-test', 'migrate-billing', 'bump-node-22', 'rename-color-tokens'];
const firstBanner = attentionBannerOf(FIRST_ATTENTION_FRAME);
const bannersByText = new Map(ATTENTION_FRAMES.map(attentionBannerOf).map((banner) => [banner.text, banner]));
---
<section id="status">
  <div class="section-head reveal">
    <h2>One needs you. You'll know which.</h2>
    <p>Status from agent hooks, not screen reading. Unmodified agents, real terminals.</p>
  </div>
  <figure class="attention-board reveal" id="attention-board" aria-label="Five agent sessions working. One stops for input, comes forward, and goes back to work once answered. Another completes, and one fails and takes the focus.">
    <p class="attention-banner" data-banner={firstBanner.text} aria-hidden="true">
      {[...bannersByText.values()].map(({ state, text }) => <span data-state={state} data-banner-text={text}>{text}</span>)}
    </p>
    <ol class="session-rows" aria-hidden="true">
      {SESSION_TASKS.map((task, rowIndex) => (
        <li data-state={FIRST_ATTENTION_FRAME.states[rowIndex]} data-outline={FIRST_ATTENTION_FRAME.states[rowIndex]} data-focus={String(FIRST_ATTENTION_FRAME.focusedRow === rowIndex)}>
          <span class="state-stack">
            {SHOWN_STATES.map((state) => (
              <svg viewBox="0 0 16 16" data-icon-for={state} data-state={state}>{STATUS_ICON_SHAPES[STATE_ICONS[state]].map(({ tag: Shape, attributes }) => <Shape {...attributes} />)}</svg>
            ))}
          </span>
          <span class="session-task">{task}</span>
          <span class="state-stack label-stack">{SHOWN_STATES.map((state) => <span class="session-state" data-label-for={state} data-state={state}>{BADGE_LABELS[state]}</span>)}</span>
        </li>
      ))}
    </ol>
  </figure>
  <ul class="agent-list reveal" aria-label="Supported agents">
    {AGENT_CARDS.map(({ label, support }) => <li><span class="agent-name">{label}</span> <span class="agent-support">{support}</span></li>)}
  </ul>
</section>

<script>
  import { runFramesWhileVisible } from '../lib/dom.ts';
  import { ATTENTION_FRAMES, attentionBannerOf } from '../lib/attention-frames.ts';
  import type { AttentionFrame } from '../lib/attention-frames.ts';

  function showFrame(board: HTMLElement, frame: AttentionFrame): void {
    const banner = board.querySelector<HTMLElement>('.attention-banner');
    if (banner) banner.dataset.banner = attentionBannerOf(frame).text;
    board.querySelectorAll<HTMLElement>('.session-rows > li').forEach((row, rowIndex) => {
      row.dataset.state = frame.states[rowIndex];
      if (frame.focusedRow === rowIndex) row.dataset.outline = frame.states[rowIndex];
      row.dataset.focus = String(frame.focusedRow === rowIndex);
    });
  }

  const board = document.getElementById('attention-board');
  if (board) runFramesWhileVisible(board, ATTENTION_FRAMES.map(({ holdMs }) => holdMs), (frameIndex) => showFrame(board, ATTENTION_FRAMES[frameIndex]));
</script>

<style>
  .attention-board { margin: 0; max-width: 560px; border: 1px solid var(--border); border-radius: 6px; background: var(--bg-card); padding: 16px; }
  .attention-banner { display: grid; margin: 0 0 10px; padding: 10px 12px; border: 1px solid var(--border-dim); border-radius: 4px; font-size: 12px; font-weight: 700; letter-spacing: 0.08em; }
  .attention-banner > span { grid-area: 1 / 1; opacity: 0; transition: opacity var(--leave-ms) var(--ease-in-expo); }
  .session-rows { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 2px; }
  .session-rows li { position: relative; display: flex; align-items: center; gap: 12px; padding: 10px 12px; border-radius: 4px; font-size: 14px; transition: transform 900ms var(--ease-out-expo); }
  .session-rows li::before { content: ''; position: absolute; inset: 0; border-radius: 4px; border: 1px solid var(--outline-color); background: color-mix(in srgb, var(--outline-color) 10%, transparent); opacity: 0; transition: opacity 900ms var(--ease-out-expo); }
  .session-rows li[data-focus="true"] { transform: scale(1.015); animation: focus-arrive 720ms var(--ease-out-expo) var(--leave-ms) both; }
  @keyframes focus-arrive {
    0% { transform: scale(1); }
    25% { transform: scale(0.985); }
    65% { transform: scale(1.025); }
    100% { transform: scale(1.015); }
  }
  @media (prefers-reduced-motion: reduce) {
    .session-rows li[data-focus="true"] { animation: none; }
  }
  .session-rows li[data-focus="true"]::before { opacity: 1; }
  .state-stack { display: grid; flex: none; }
  .state-stack > * { grid-area: 1 / 1; opacity: 0; transition: opacity var(--leave-ms) var(--ease-in-expo); }
  .label-stack { justify-items: end; }
  .session-rows svg { width: 16px; height: 16px; }
  .session-task { flex: 1; min-width: 0; color: var(--text-head); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .session-state { font-size: 13px; font-weight: 700; }
  .session-rows li[data-state="RUNNING"] [data-icon-for="RUNNING"], .session-rows li[data-state="RUNNING"] [data-label-for="RUNNING"], .session-rows li[data-state="WAITING"] [data-icon-for="WAITING"], .session-rows li[data-state="WAITING"] [data-label-for="WAITING"], .session-rows li[data-state="COMPLETE"] [data-icon-for="COMPLETE"], .session-rows li[data-state="COMPLETE"] [data-label-for="COMPLETE"], .session-rows li[data-state="FAILED"] [data-icon-for="FAILED"], .session-rows li[data-state="FAILED"] [data-label-for="FAILED"] { opacity: 1; transition: opacity var(--arrive-ms) var(--ease-out-expo) var(--leave-ms); }
  .attention-banner[data-banner="ALL CLEAR"] [data-banner-text="ALL CLEAR"], .attention-banner[data-banner="1 NEEDS YOU"] [data-banner-text="1 NEEDS YOU"], .attention-banner[data-banner="1 FAILED"] [data-banner-text="1 FAILED"] { opacity: 1; transition: opacity var(--arrive-ms) var(--ease-out-expo) var(--leave-ms); }
  .agent-list { list-style: none; margin: 24px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px 28px; font-size: 15px; }
  .agent-name { color: var(--text-head); font-weight: 700; }
  .agent-support { color: var(--text-dim); }
  [data-outline="RUNNING"] { --outline-color: var(--state-running); }
  [data-outline="WAITING"] { --outline-color: var(--state-waiting); }
  [data-outline="COMPLETE"] { --outline-color: var(--state-complete); }
  [data-outline="FAILED"] { --outline-color: var(--state-failed); }
  [data-state="RUNNING"] { color: var(--state-running); }
  [data-state="WAITING"] { color: var(--state-waiting); }
  [data-state="COMPLETE"] { color: var(--state-complete); }
  [data-state="FAILED"] { color: var(--state-failed); }
</style>
