---
import { STATE_ICONS, STATUS_ICON_SHAPES } from '../../../shared/state-icons.ts';
import { BADGE_LABELS, STATES } from '../../../shared/states.ts';
import { AGENT_CARDS } from '../lib/product-facts.ts';

const SHOWN_STATES = [STATES.RUNNING, STATES.WAITING, STATES.COMPLETE, STATES.FAILED];
const DEMO_SESSIONS = [
  { task: 'fix-auth-redirect', state: STATES.RUNNING },
  { task: 'flaky-upload-test', state: STATES.FAILED },
  { task: 'migrate-billing', state: STATES.WAITING },
  { task: 'bump-node-22', state: STATES.RUNNING },
  { task: 'rename-color-tokens', state: STATES.COMPLETE },
];
---
<section id="status">
  <div class="section-head reveal">
    <h2>One needs you. You'll know which.</h2>
    <p>Status from your coding agents' own hooks, not screen reading. Unmodified agents, real terminals.</p>
  </div>
  <figure class="attention-board" id="attention-board" aria-label="The Next session banner from the dashboard over five agent sessions. Each session that needs you has a tile in the banner and a number for its place in line. Tap the banner or press the shortcut to open the next one.">
    <div class="attention-banner-slot" id="attention-banner-slot"></div>
    <p class="jump-callout" aria-hidden="true"><span class="jump-arrow">&#x2191;</span> Tap the banner<span class="jump-callout-keys"></span></p>
    <ol class="session-rows" aria-hidden="true">
      {DEMO_SESSIONS.map(({ task, state }) => (
        <li class="session-row" data-id={task} data-state={state} data-focus="false">
          <span class="state-stack">
            {SHOWN_STATES.map((shownState) => (
              <svg viewBox="0 0 16 16" aria-hidden="true" data-icon-for={shownState} data-state={shownState}>{STATUS_ICON_SHAPES[STATE_ICONS[shownState]].map(({ tag: Shape, attributes }) => <Shape {...attributes} />)}</svg>
            ))}
          </span>
          <span class="session-task">{task}</span>
          <span class="state-stack label-stack">{SHOWN_STATES.map((shownState) => <span class="session-state" data-label-for={shownState} data-state={shownState}>{BADGE_LABELS[shownState]}</span>)}</span>
          <span class="session-row-attention-tab" hidden></span>
        </li>
      ))}
    </ol>
    <div class="queue-row">
      <button class="queue-question" id="queue-question" type="button">Queue a question</button>
    </div>
  </figure>
  <ul class="agent-list reveal" aria-label="Supported agents">
    {AGENT_CARDS.map(({ label, support }) => <li><span class="agent-name">{label}</span> <span class="agent-support">{support}</span></li>)}
  </ul>
</section>

<script>
  import { STATES } from '../../../shared/states.ts';
  import { buildAttentionBanner, paintAttentionBanner, pressAttentionBanner, sendAttentionTileToRow } from '../../../public/attention-banner.ts';
  import { countAttentionByKind, orderAttentionLine } from '../../../public/focus-view/attention-core.ts';
  import { resolveDashboardShortcut, shortcutChord, shortcutHint, shortcutPlatformFor } from '../../../public/shortcuts-core.ts';
  import { markWhileOnScreen } from '../lib/dom.ts';

  type UnseenOutcome = 'finished' | 'failed';

  interface DemoSession {
    id: string;
    name: string;
    state: string;
    unseenOutcome: UnseenOutcome | null;
  }

  const UNSEEN_OUTCOME_BY_STATE: ReadonlyMap<string, UnseenOutcome> = new Map([
    [STATES.FAILED, 'failed'],
    [STATES.COMPLETE, 'finished'],
  ]);

  const board = document.getElementById('attention-board');
  const bannerSlot = document.getElementById('attention-banner-slot');
  const queueButton = document.getElementById('queue-question');
  const platform = shortcutPlatformFor(navigator.userAgent);

  function rowsOf(boardElement: HTMLElement) {
    return [...boardElement.querySelectorAll<HTMLElement>('.session-rows > li')];
  }

  function sessionOf(row: HTMLElement): DemoSession {
    const state = row.dataset.state ?? STATES.RUNNING;
    const id = row.dataset.id ?? '';
    return { id, name: id, state, unseenOutcome: UNSEEN_OUTCOME_BY_STATE.get(state) ?? null };
  }

  function buildJumpKeys() {
    const keys = document.createElement('span');
    keys.className = 'shortcut-keys';
    shortcutChord('next-attention', platform).forEach((caption, keyIndex) => {
      if (keyIndex > 0) keys.append(Object.assign(document.createElement('span'), { className: 'shortcut-sep', textContent: '+' }));
      keys.append(Object.assign(document.createElement('kbd'), { className: 'kbd', textContent: caption }));
    });
    return keys;
  }

  function mountJumpDemo(boardElement: HTMLElement, slot: HTMLElement, queueQuestionButton: HTMLElement) {
    const rowById = new Map(rowsOf(boardElement).map((row) => [row.dataset.id ?? '', row]));
    const banner = buildAttentionBanner({ onJump: jumpToNextSession, rowFor: (sessionId) => rowById.get(sessionId) }, buildJumpKeys());
    slot.append(banner);
    const calloutKeys = boardElement.querySelector('.jump-callout-keys');
    if (calloutKeys) calloutKeys.textContent = ` or press ${shortcutHint('next-attention', platform)}`;

    function attentionLine() {
      return orderAttentionLine(rowsOf(boardElement).map(sessionOf), null);
    }

    function repaint() {
      const sessions = rowsOf(boardElement).map(sessionOf);
      const line = orderAttentionLine(sessions, null);
      paintAttentionBanner(banner, countAttentionByKind(sessions), line);
      const positionById = new Map(line.map(({ id }, index) => [id, index + 1]));
      for (const row of rowsOf(boardElement)) {
        const position = positionById.get(row.dataset.id ?? '') ?? null;
        const tab = row.querySelector<HTMLElement>('.session-row-attention-tab');
        if (tab) {
          tab.hidden = position === null;
          tab.textContent = position === null ? '' : String(position);
        }
        row.toggleAttribute('data-attention-head', position === 1);
      }
      boardElement.toggleAttribute('data-line-empty', line.length === 0);
    }

    function openSession(sessionId: string) {
      for (const row of rowsOf(boardElement)) row.dataset.focus = String(row.dataset.id === sessionId);
      const openedRow = rowById.get(sessionId);
      if (openedRow) openedRow.dataset.state = STATES.RUNNING;
      repaint();
    }

    function jumpToNextSession() {
      pressAttentionBanner(banner);
      const nextSession = attentionLine()[0];
      if (!nextSession) return;
      sendAttentionTileToRow(banner, nextSession.id, () => openSession(nextSession.id));
    }

    function queueQuestion() {
      const workingRows = rowsOf(boardElement).filter((row) => row.dataset.state === STATES.RUNNING && row.dataset.focus !== 'true');
      const askingRow = workingRows[Math.floor(Math.random() * workingRows.length)];
      if (!askingRow) return;
      askingRow.dataset.state = STATES.WAITING;
      repaint();
    }

    document.addEventListener('keydown', (event) => {
      if (boardElement.dataset.onScreen !== 'true') return;
      if (resolveDashboardShortcut(event, platform)?.action !== 'next-attention') return;
      event.preventDefault();
      jumpToNextSession();
    });
    queueQuestionButton.addEventListener('click', queueQuestion);
    markWhileOnScreen(boardElement);
    repaint();
  }

  if (board && bannerSlot && queueButton) mountJumpDemo(board, bannerSlot, queueButton);
</script>

<style>
  .attention-board { margin: 0; max-width: 560px; border: 1px solid var(--border); border-radius: 6px; background: var(--bg-card); padding: 16px; }
  .attention-board :global(.attention-banner) { position: relative; margin-bottom: 0; }
  .attention-board :global(.attention-banner-jump .kbd) { font-family: var(--font-mono); font-weight: 700; line-height: 1; color: var(--text-head); }
  .jump-callout { margin: 10px 0 8px; font-size: 14px; font-weight: 700; color: var(--state-waiting); transition: opacity var(--transition-fast); }
  .attention-board[data-line-empty] .jump-callout { opacity: 0; }
  .jump-arrow { display: inline-block; animation: jump-nudge 1.6s infinite; }
  .attention-board:not([data-on-screen="true"]) .jump-arrow { animation-play-state: paused; }
  @keyframes jump-nudge {
    0%, 100% { translate: 0 0; animation-timing-function: var(--ease-out-expo); }
    20% { translate: 0 3px; animation-timing-function: var(--ease-out-expo); }
    45% { translate: 0 -6px; animation-timing-function: var(--ease-out-expo); }
    70% { translate: 0 0; animation-timing-function: var(--ease-out-expo); }
  }
  .session-rows { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 2px; }
  .session-rows li { position: relative; display: flex; align-items: center; gap: 12px; padding: 10px 12px; border-radius: 4px; font-size: 14px; overflow: hidden; transition: transform 900ms var(--ease-out-expo); }
  .session-rows li::before { content: ''; position: absolute; inset: 0; border-radius: 4px; border: 1px solid var(--accent); background: color-mix(in srgb, var(--accent) 10%, transparent); opacity: 0; transition: opacity 900ms var(--ease-out-expo); }
  .session-rows li[data-focus="true"] { transform: scale(1.015); animation: focus-arrive 720ms var(--ease-out-expo) both; }
  .session-rows li[data-focus="true"]::before { opacity: 1; }
  @keyframes focus-arrive {
    0% { transform: scale(1); }
    25% { transform: scale(0.985); }
    65% { transform: scale(1.025); }
    100% { transform: scale(1.015); }
  }
  .state-stack { display: grid; flex: none; }
  .state-stack > * { grid-area: 1 / 1; opacity: 0; transition: opacity var(--leave-ms) var(--ease-in-expo); }
  .label-stack { justify-items: end; margin-right: 10px; }
  .session-rows svg { width: 16px; height: 16px; }
  .session-task { flex: 1; min-width: 0; color: var(--text-head); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .session-state { font-size: 13px; font-weight: 700; }
  .session-rows li[data-state="RUNNING"] { --st: var(--state-running); }
  .session-rows li[data-state="WAITING"] { --st: var(--state-waiting); }
  .session-rows li[data-state="COMPLETE"] { --st: var(--state-complete); }
  .session-rows li[data-state="FAILED"] { --st: var(--state-failed); }
  .session-rows li[data-state="RUNNING"] [data-icon-for="RUNNING"], .session-rows li[data-state="RUNNING"] [data-label-for="RUNNING"], .session-rows li[data-state="WAITING"] [data-icon-for="WAITING"], .session-rows li[data-state="WAITING"] [data-label-for="WAITING"], .session-rows li[data-state="COMPLETE"] [data-icon-for="COMPLETE"], .session-rows li[data-state="COMPLETE"] [data-label-for="COMPLETE"], .session-rows li[data-state="FAILED"] [data-icon-for="FAILED"], .session-rows li[data-state="FAILED"] [data-label-for="FAILED"] { opacity: 1; transition: opacity var(--arrive-ms) var(--ease-out-expo) var(--leave-ms); }
  .queue-row { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; margin-top: 12px; padding-top: 14px; border-top: 1px solid var(--border-dim); }
  .queue-question { border: 1px solid var(--border); border-radius: 4px; background: var(--bg); color: var(--text); font: inherit; font-size: 14px; padding: 0 14px; min-height: 40px; cursor: pointer; }
  .queue-question:hover { border-color: var(--accent); color: var(--text-head); }
  .agent-list { list-style: none; margin: 24px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px 28px; font-size: 15px; }
  .agent-name { color: var(--text-head); font-weight: 700; }
  .agent-support { color: var(--text-dim); }
  [data-state="RUNNING"] { color: var(--state-running); }
  [data-state="WAITING"] { color: var(--state-waiting); }
  [data-state="COMPLETE"] { color: var(--state-complete); }
  [data-state="FAILED"] { color: var(--state-failed); }
  @media (prefers-reduced-motion: reduce) {
    .session-rows li[data-focus="true"] { animation: none; }
    .jump-arrow { animation: none; }
  }
</style>
