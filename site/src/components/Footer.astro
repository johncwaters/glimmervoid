---
import { BRAND_ACCENT, BRAND_MARK_VIEWBOX, brandMarkMarkup } from '../../../shared/brand-mark.ts';
import { PRODUCT_VERSION, REPOSITORY_URL } from '../lib/product-facts.ts';
import { sitePath } from '../lib/site-path.ts';
import Wordmark from './Wordmark.astro';

const LINK_GROUPS = [
  {
    title: 'Product',
    links: [
      { label: 'Install', href: sitePath('#install') },
      { label: 'Changelog', href: `${REPOSITORY_URL}/blob/main/CHANGELOG.md` },
      { label: 'Privacy', href: sitePath('privacy/') },
      { label: 'Terms', href: sitePath('terms/') },
      { label: 'Refunds', href: sitePath('refunds/') },
    ],
  },
  {
    title: 'Source',
    links: [
      { label: 'GitHub', href: REPOSITORY_URL },
      { label: 'Issues', href: `${REPOSITORY_URL}/issues` },
    ],
  },
];
---
<footer>
  <div class="footer-brand">
    <p class="wordmark"><svg class="wordmark-mark" viewBox={BRAND_MARK_VIEWBOX} aria-hidden="true" set:html={brandMarkMarkup({ frame: 'currentColor', light: BRAND_ACCENT })}></svg><Wordmark /></p>
    <p>See it before it's built.</p>
    <p class="footer-meta">v{PRODUCT_VERSION}, open source under MIT. Shipped from inside Glimmervoid.</p>
    <a class="devhunt-badge" href="https://devhunt.org/tool/glimmervoid" target="_blank" rel="noopener" title="Glimmervoid on DevHunt"><img src="https://devhunt.org/badge/glimmervoid.svg" alt="Glimmervoid - Featured on DevHunt" width="220" height="54" loading="lazy" /></a>
  </div>
  {LINK_GROUPS.map(({ title, links }) => (
    <nav aria-label={title}>
      <p class="group-title">{title}</p>
      <ul>{links.map(({ label, href }) => <li><a href={href}>{label}</a></li>)}</ul>
    </nav>
  ))}
  <p class="credits">Sane YOLO built on <a href="https://ccsafetynet.com">CC Safety Net</a>.</p>
</footer>

<style>
  footer { border-top: 1px solid var(--border-dim); padding-block: 40px 0; display: grid; grid-template-columns: minmax(0, 2fr) minmax(0, 1fr) minmax(0, 1fr); gap: 28px 24px; font-size: var(--type-meta); color: var(--text-dim); }
  .footer-brand { display: flex; flex-direction: column; gap: 6px; }
  .wordmark { display: flex; align-items: center; gap: 10px; margin-bottom: 6px; color: var(--text-head); font-size: var(--type-doc-body); }
  .wordmark-mark { flex: none; width: 20px; height: 20px; overflow: visible; }
  .footer-meta { margin-top: 6px; }
  .devhunt-badge { margin-top: 10px; align-self: flex-start; }
  .group-title { margin-bottom: 8px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--text); }
  footer ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 6px; }
  footer a { color: var(--text-dim); }
  footer a:hover { color: var(--accent); }
  .credits { grid-column: 1 / -1; padding-top: 18px; border-top: 1px solid var(--border-dim); }
  @media (max-width: 640px) {
    footer { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); padding-block: 28px 0; }
    .footer-brand { grid-column: 1 / -1; }
    footer ul { gap: 0; }
    footer nav a { display: inline-flex; align-items: center; min-height: 44px; }
  }
</style>
