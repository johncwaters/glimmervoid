---
import InstallCommand from './InstallCommand.astro';
import { LINUX_INSTALL_COMMAND } from '../lib/install-command.ts';
import { DEFAULT_PORT, MINIMUM_NODE_VERSION } from '../lib/product-facts.ts';
---
<section id="install">
  <div class="section-head reveal">
    <h2>Up in a minute.</h2>
  </div>
  <div class="install-grid reveal">
<pre class="term-block"><span class="c"># Windows and macOS</span>
<InstallCommand class="cmd" /></pre>
<pre class="term-block"><span class="c"># Linux</span>
<InstallCommand class="cmd" command={LINUX_INSTALL_COMMAND} /></pre>
  </div>
  <p class="install-next">Then open <code>localhost:{DEFAULT_PORT}</code>. Needs Node {MINIMUM_NODE_VERSION}.</p>
</section>

<style>
  .install-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 12px; }
  pre.term-block { margin: 0; background: var(--bg-card); border: 1px solid var(--border); border-radius: 6px; padding: 16px 18px; color: var(--text-head); font-family: inherit; font-size: 15px; line-height: 1.8; white-space: pre-wrap; overflow-wrap: anywhere; }
  pre.term-block :global(.cmd) { display: inline-block; width: 100%; padding-left: 2ch; text-indent: -2ch; }
  pre.term-block :global(.unbroken) { white-space: nowrap; }
  pre.term-block .c { color: var(--text-dim); }
  .install-next { margin-top: 18px; color: var(--text-dim); }
  @media (max-width: 820px) { .install-grid { grid-template-columns: minmax(0, 1fr); } }
  @media (max-width: 640px) { pre.term-block { padding: 14px; } }
</style>
