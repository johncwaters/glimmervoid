---
import { framePart } from '../lib/frame-parts.ts';

const DRAFTED_COMMENTS = [
  { severity: 'HIGH', text: 'Retry loop never backs off', isTicked: true },
  { severity: 'NIT', text: 'Name the timeout in ms', isTicked: false },
  { severity: 'NIT', text: 'Typo in the log line', isTicked: false },
];
const STACKED_PULLS = [
  { number: 501, title: 'Billing schema', depth: 0, readyFrom: 0, mergedFrom: 1 },
  { number: 502, title: 'Backfill invoices', depth: 1, readyFrom: 1, mergedFrom: 2 },
  { number: 503, title: 'Invoice page', depth: 2, readyFrom: 3, mergedFrom: undefined },
];
---
<section id="reviews">
  <div class="section-head reveal">
    <h2>Reviews drafted. You post the good parts.</h2>
    <p>Your team's PRs reviewed in a guarded session. Yours merge themselves once they're ready.</p>
  </div>
  <div class="review-panels reveal" id="review-panels" role="img" aria-label="A drafted review of a teammate's pull request lists one high finding ticked and two nits unticked; it is posted and the next pull request comes in. Beside it, three stacked pull requests of yours merge one after another.">
    <div class="review-panel" aria-hidden="true">
      <p class="panel-label">Team</p>
      <div class="stacked">
        <div class="pull-card" {...framePart(0, 2)}>
          <p class="pull-title"><span class="pull-number">#482</span> Retry webhook deliveries</p>
          <p class="verdict">Approve with nits</p>
          <ul class="drafted-comments">
            {DRAFTED_COMMENTS.map(({ severity, text, isTicked }) => (
              <li><span class={`tick${isTicked ? ' is-ticked' : ''}`}></span><span class={`severity is-${severity.toLowerCase()}`}>{severity}</span>{text}</li>
            ))}
          </ul>
          <p class="post-line"><span class="post-control">Post</span><span class="post-status pops-in" {...framePart(1)}>Posted</span></p>
        </div>
        <div class="pull-card" {...framePart(2)}>
          <p class="pull-title"><span class="pull-number">#483</span> Cache avatar URLs</p>
          <p class="verdict is-pending">Reviewing</p>
        </div>
      </div>
    </div>
    <div class="review-panel" aria-hidden="true">
      <p class="panel-label">Mine <span class="merge-queue">Merge when ready: on</span></p>
      <ol class="stacked-pulls">
        {STACKED_PULLS.map(({ number, title, depth, readyFrom, mergedFrom }) => (
          <li style={`--stack-depth: ${depth}`}>
            <span class="pull-number">#{number}</span>
            <span class="stacked-title">{title}</span>
            <span class="stacked pull-stage">
              <span class="stage is-checks" {...framePart(0, readyFrom)}>Checks</span>
              <span class="stage is-ready" {...framePart(readyFrom, mergedFrom)}>Ready</span>
              {mergedFrom !== undefined && <span class="stage is-merged pops-in" {...framePart(mergedFrom)}>Merged</span>}
            </span>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<script>
  import { runFramesWhileVisible } from '../lib/dom.ts';
  import { REVIEW_HOLD_MS } from '../lib/feature-frames.ts';
  import { showFrameParts } from '../lib/frame-parts.ts';

  const reviewPanels = document.getElementById('review-panels');
  if (reviewPanels) {
    runFramesWhileVisible(reviewPanels, REVIEW_HOLD_MS, (frameIndex) => showFrameParts(reviewPanels, frameIndex));
  }
</script>

<style>
  .review-panels { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 16px; }
  .review-panel { border: 1px solid var(--border); border-radius: 6px; background: var(--bg-card); padding: 16px; min-width: 0; }
  .panel-label { display: flex; justify-content: space-between; gap: 12px; margin-bottom: 12px; font-size: 12px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--text-dim); }
  .merge-queue { color: var(--state-complete); letter-spacing: 0.04em; }
  .pull-card { display: flex; flex-direction: column; gap: 10px; }
  .pull-title { color: var(--text-head); font-weight: 700; font-size: 15px; }
  .pull-number { color: var(--text-dim); font-weight: 400; }
  .verdict { color: var(--state-complete); font-size: 14px; font-weight: 700; }
  .verdict.is-pending { color: var(--state-running); }
  .drafted-comments { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 8px; font-size: 14px; color: var(--text); }
  .drafted-comments li { display: flex; align-items: center; gap: 10px; min-width: 0; }
  .tick { flex: none; width: 14px; height: 14px; border: 1px solid var(--text-dim); border-radius: 3px; }
  .tick.is-ticked { border-color: var(--accent); background: var(--accent); }
  .severity { flex: none; font-size: 11px; font-weight: 700; letter-spacing: 0.06em; }
  .severity.is-high { color: var(--state-failed); }
  .severity.is-nit { color: var(--text-dim); }
  .post-line { display: flex; align-items: center; gap: 12px; margin-top: 4px; }
  .post-control { border: 1px solid var(--accent); border-radius: 4px; padding: 4px 14px; color: var(--accent); font-size: 14px; font-weight: 700; }
  .post-status { color: var(--state-complete); font-size: 14px; }
  .stacked-pulls { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 10px; font-size: 14px; }
  .stacked-pulls li { display: flex; align-items: center; gap: 10px; padding-left: calc(var(--stack-depth) * 18px); min-width: 0; }
  .stacked-title { flex: 1; min-width: 0; color: var(--text-head); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .pull-stage { flex: none; justify-items: end; }
  .stage { font-size: 13px; font-weight: 700; }
  .stage.is-checks { color: var(--state-starting); }
  .stage.is-ready { color: var(--state-complete); }
  .stage.is-merged { color: var(--accent); }
  @media (max-width: 820px) {
    .review-panels { grid-template-columns: minmax(0, 1fr); }
  }
</style>
