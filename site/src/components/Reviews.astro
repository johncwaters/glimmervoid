---
import { actionLabel, severityPresentation } from '../../../public/github/team-review-view-core.ts';
import { stageIcon, stageLabel } from '../../../public/github/my-prs-view-core.ts';
import { OCTICON_PATHS_BY_ICON } from '../../../public/github/pr-status-icon.ts';
import type { PrStatusIcon } from '../../../public/github/pr-status-icon-core.ts';
import { framePart } from '../lib/frame-parts.ts';

const SHARD_PATH = 'M4.5 0.5L8.5 5.5L4.5 10.5L0.5 5.5Z';
const PIP_SLOTS = [0, 1, 2];
const DRAFTED_COMMENTS = [
  { severity: 'HIGH', text: 'Retry loop never backs off', untickedFrom: undefined },
  { severity: 'MEDIUM', text: 'Timeout unit is ambiguous', untickedFrom: undefined },
  { severity: 'LOW', text: 'Typo in the log line', untickedFrom: 1 },
] as const;
const POST_ACTIONS = (['approve', 'approve-only', 'comment'] as const).map((action) => ({ action, label: actionLabel(action) }));
const READINESS_ROWS: { label: string; steps: { text: string; tone: string; icon: PrStatusIcon; from: number; until?: number }[] }[] = [
  { label: 'Checks', steps: [{ text: 'Passing', tone: 'ok', icon: 'passed', from: 0 }] },
  { label: 'Review', steps: [{ text: 'Approved', tone: 'ok', icon: 'passed', from: 0 }] },
  { label: 'Conflicts', steps: [{ text: 'Conflicts with main', tone: 'danger', icon: 'conflict', from: 0, until: 1 }, { text: 'Repairing', tone: 'warn', icon: 'running', from: 1, until: 2 }, { text: 'None', tone: 'ok', icon: 'passed', from: 2 }] },
  { label: 'Base', steps: [{ text: '2 behind main', tone: 'muted', icon: 'behind', from: 0, until: 2 }, { text: 'Up to date', tone: 'ok', icon: 'passed', from: 2 }] },
  { label: 'Merge when ready', steps: [{ text: 'On', tone: 'ok', icon: 'ready', from: 0 }] },
];
const PARENT_STAGES = [
  { stage: 'conflicts', tone: 'danger', from: 0, until: 2 },
  { stage: 'ready', tone: 'ok', from: 2, until: 3 },
  { stage: 'merged', tone: 'merged', from: 3 },
] as const;
const TEAM_PULL_STATES = [
  { text: 'Your turn', tone: 'wait', icon: 'your-turn', from: 0, until: 2, isPopping: false },
  { text: 'You approved', tone: 'ok', icon: 'passed', from: 2, until: 3, isPopping: true },
  { text: 'Resolved', tone: 'ok', icon: 'ready', from: 3, until: undefined, isPopping: false },
];
---
<section id="reviews">
  <div class="section-head reveal">
    <h2>Automated PR reviews. You post the good parts.</h2>
    <p>Team PRs arrive with a drafted review. Yours merge themselves.</p>
  </div>

  <div class="review-act reveal">
    <div class="act-copy">
      <p class="act-label">Team</p>
      <h3>Teammates' PRs, reviewed before you open them.</h3>
      <p class="act-note">Nothing posts until you click. <span class="no-break">Opt-in.</span></p>
    </div>
    <figure class="act-demo" id="team-review-demo" role="img" aria-label="A drafted review of pull request 482 says approve with nits, with a high, a medium and a low finding, all included. You untick the low one and press Approve and comment, and the review posts as You approved. After new commits, the re-review raises no new high findings and both of your comments are resolved.">
      <div class="pull-card" aria-hidden="true">
        <p class="pull-head">
          <span class="pull-title"><span class="pull-number">#482</span> Retry webhook deliveries</span>
          <span class="stacked pull-state">
            {TEAM_PULL_STATES.map(({ text, tone, icon, from, until, isPopping }) => <span class={`pull-status tone-${tone}${isPopping ? ' pops-in' : ''}`} {...framePart(from, until)}><svg class="pr-icon" viewBox="0 0 16 16" aria-hidden="true"><path d={OCTICON_PATHS_BY_ICON[icon]} fill="currentColor" /></svg>{text}</span>)}
          </span>
        </p>
        <p class="verdict"><span class="verdict-seal"></span>approve with nits</p>
        <p class="draft-summary">Adds retries to webhook delivery. The retry loop has no backoff.</p>
        <ul class="drafted-comments">
          {DRAFTED_COMMENTS.map(({ severity, text, untickedFrom }) => {
            const { filledCount, colorToken } = severityPresentation(severity);
            return (
              <li class="drafted-comment" {...(untickedFrom === undefined ? {} : { 'data-unticks': String(untickedFrom) })}>
                <span class="stacked include-box">
                  <span class="tick is-ticked" {...framePart(0, untickedFrom)}></span>
                  {untickedFrom !== undefined && <span class="tick" {...framePart(untickedFrom)}></span>}
                </span>
                <span class="severity-meter" style={`color: var(${colorToken})`}>
                  {PIP_SLOTS.map((slot) => (
                    <svg aria-hidden="true" viewBox="0 0 9 11" width="9" height="11"><path d={SHARD_PATH} fill={slot < filledCount ? 'currentColor' : 'none'} stroke={slot < filledCount ? 'currentColor' : 'var(--border-hover)'} stroke-width="1" /></svg>
                  ))}
                </span>
                <span class="comment-text">{text}</span>
              </li>
            );
          })}
        </ul>
        <div class="stacked post-area">
          <p class="post-actions" {...framePart(0, 2)}>
            {POST_ACTIONS.map(({ action, label }) => (
              <span class={`post-action${action === 'approve' ? ' is-primary' : ''}`}>
                {label}
                {action === 'approve' && <span class="press-ring" {...framePart(1, 2)}></span>}
              </span>
            ))}
          </p>
          <p class="post-outcome" {...framePart(2, 3)}>Posted to GitHub under your name, 2 of 3 comments.</p>
          <p class="post-outcome" {...framePart(3)}>New commits re-reviewed: no new high findings.<br><span class="tone-ok">All 2 of your comments resolved</span></p>
        </div>
      </div>
    </figure>
  </div>

  <div class="review-act is-mine reveal">
    <div class="act-copy">
      <p class="act-label">Mine</p>
      <h3>Your PRs, watched until they merge.</h3>
      <p class="act-note">Conflicts repaired, branches rebased, merged when green.</p>
    </div>
    <figure class="act-demo" id="my-prs-demo" role="img" aria-label="Your pull request 501 has merge conflicts and is 2 commits behind main, with Merge when ready and Keep mergeable on. Keep mergeable repairs the conflict, the branch is rebased, the PR becomes Ready to merge and then merges. Your stacked pull request 502 sits under it with its checks running.">
      <div class="pull-card" aria-hidden="true">
        <p class="pull-head">
          <span class="pull-title"><span class="pull-number">#501</span> Billing schema</span>
          <span class="stacked pull-state">
            {PARENT_STAGES.map(({ stage, tone, from, until }) => <span class={`pull-status tone-${tone}${tone === 'merged' ? ' pops-in' : ''}`} {...framePart(from, until)}><svg class="pr-icon" viewBox="0 0 16 16" aria-hidden="true"><path d={OCTICON_PATHS_BY_ICON[stageIcon(stage)]} fill="currentColor" /></svg>{stageLabel(stage)}</span>)}
          </span>
        </p>
        <p class="readiness-heading">Merge readiness</p>
        <dl class="readiness-rows">
          {READINESS_ROWS.map(({ label, steps }) => (
            <div class="readiness-row">
              <dt>{label}</dt>
              <dd class="stacked">
                {steps.map(({ text, tone, icon, from, until }) => <span class={`pull-status tone-${tone}`} {...(steps.length > 1 ? framePart(from, until) : {})}><svg class="pr-icon" viewBox="0 0 16 16" aria-hidden="true"><path d={OCTICON_PATHS_BY_ICON[icon]} fill="currentColor" /></svg>{text}</span>)}
              </dd>
            </div>
          ))}
        </dl>
        <p class="toggles">
          <span class="toggle"><span class="switch"></span>Merge when ready</span>
          <span class="toggle"><span class="switch"></span>Keep mergeable</span>
        </p>
      </div>
      <div class="stacked-child" aria-hidden="true">
        <span class="tree-branch"></span>
        <span class="pull-title"><span class="pull-number">#502</span> Backfill invoices</span>
        <span class="pull-status tone-wait"><svg class="pr-icon" viewBox="0 0 16 16" aria-hidden="true"><path d={OCTICON_PATHS_BY_ICON[stageIcon('checks-pending')]} fill="currentColor" /></svg>{stageLabel('checks-pending')}</span>
      </div>
    </figure>
  </div>
</section>

<script>
  import { runFramesWhileVisible } from '../lib/dom.ts';
  import { MY_PRS_HOLD_MS, REVIEW_HOLD_MS } from '../lib/feature-frames.ts';
  import { showFrameParts } from '../lib/frame-parts.ts';

  const teamReviewDemo = document.getElementById('team-review-demo');
  if (teamReviewDemo) runFramesWhileVisible(teamReviewDemo, REVIEW_HOLD_MS, (frameIndex) => showFrameParts(teamReviewDemo, frameIndex));
  const myPrsDemo = document.getElementById('my-prs-demo');
  if (myPrsDemo) runFramesWhileVisible(myPrsDemo, MY_PRS_HOLD_MS, (frameIndex) => showFrameParts(myPrsDemo, frameIndex));
</script>

<style>
  .review-act { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); gap: 32px; align-items: start; }
  .review-act + .review-act { margin-top: 64px; }
  .act-copy { display: flex; flex-direction: column; gap: 14px; min-width: 0; }
  .act-label { font-size: 12px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--accent); }
  .act-note { color: var(--text-dim); font-size: 15px; }
  .no-break { white-space: nowrap; }
  .act-demo { margin: 0; min-width: 0; display: flex; flex-direction: column; gap: 8px; }
  .pull-card { display: flex; flex-direction: column; gap: 12px; border: 1px solid var(--border); border-radius: 6px; background: var(--bg-card); padding: 16px; font-size: 14px; }
  .pull-head { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; }
  .pull-title { min-width: 0; color: var(--text-head); font-weight: 700; font-size: 15px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .pull-number { color: var(--text-dim); font-weight: 400; }
  .pull-state { flex: none; justify-items: end; font-size: 13px; font-weight: 700; }
  .pull-status { display: inline-flex; align-items: center; gap: 6px; }
  .pr-icon { flex: none; width: 14px; height: 14px; }
  .tone-ok { color: var(--state-complete); }
  .tone-wait { color: var(--state-running); }
  .tone-warn { color: var(--state-waiting); }
  .tone-danger { color: var(--state-failed); }
  .tone-muted { color: var(--text-dim); }
  .tone-merged { color: var(--accent); }
  .verdict { display: flex; align-items: center; gap: 8px; color: var(--state-complete); font-weight: 700; }
  .verdict-seal { width: 8px; height: 8px; border-radius: 50%; background: currentColor; }
  .draft-summary { color: var(--text); }
  .drafted-comments { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 8px; }
  .drafted-comment { display: flex; align-items: center; gap: 10px; min-width: 0; padding: 6px 8px; border: 1px solid var(--border-dim); border-radius: 4px; }
  .include-box { flex: none; }
  .tick { display: block; width: 14px; height: 14px; border: 1px solid var(--text-dim); border-radius: 3px; }
  .tick.is-ticked { border-color: var(--accent); background: var(--accent); }
  .severity-meter { flex: none; display: inline-flex; gap: 1px; }
  .severity-meter svg { display: block; }
  .comment-text { min-width: 0; color: var(--text); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; transition: opacity var(--arrive-ms) var(--ease-out-expo); }
  #team-review-demo:has([data-unticks] .tick:not(.is-ticked)[data-on="true"]) [data-unticks] .comment-text { opacity: 0.45; }
  .post-area { min-height: 40px; align-items: center; }
  .post-actions { display: flex; flex-wrap: wrap; gap: 8px; }
  .post-action { position: relative; border: 1px solid var(--border-hover); border-radius: 4px; padding: 4px 12px; color: var(--text); font-size: 13px; font-weight: 700; }
  .post-action.is-primary { border-color: var(--accent); color: var(--accent); }
  .press-ring { position: absolute; inset: -4px; border: 2px solid var(--accent); border-radius: 6px; }
  .post-outcome { color: var(--text-dim); font-size: 13px; }
  .readiness-heading { font-size: 12px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--text-dim); }
  .readiness-rows { margin: 0; display: flex; flex-direction: column; gap: 6px; }
  .readiness-row { display: grid; grid-template-columns: 17ch minmax(0, 1fr); gap: 12px; align-items: baseline; }
  .readiness-row dt { color: var(--text-dim); }
  .readiness-row dd { margin: 0; min-width: 0; font-weight: 700; }
  .toggles { display: flex; flex-wrap: wrap; gap: 16px; padding-top: 10px; border-top: 1px solid var(--border-dim); color: var(--text); font-size: 13px; }
  .toggle { display: inline-flex; align-items: center; gap: 8px; }
  .switch { position: relative; width: 26px; height: 14px; border-radius: 7px; background: var(--state-complete); }
  .switch::after { content: ''; position: absolute; top: 2px; right: 2px; width: 10px; height: 10px; border-radius: 50%; background: var(--bg-card); }
  .stacked-child { display: flex; align-items: baseline; gap: 10px; padding: 10px 16px 10px 12px; border: 1px solid var(--border-dim); border-radius: 6px; font-size: 14px; }
  .stacked-child .pull-title { flex: 1; font-size: 14px; font-weight: 400; }
  .stacked-child .tone-wait { flex: none; font-size: 13px; font-weight: 700; }
  .tree-branch { flex: none; width: 14px; height: 10px; border-left: 1px solid var(--border); border-bottom: 1px solid var(--border); transform: translateY(-2px); }
  @media (max-width: 820px) {
    .review-act { grid-template-columns: minmax(0, 1fr); gap: 20px; }
    .review-act + .review-act { margin-top: 48px; }
    .readiness-row { grid-template-columns: minmax(0, 1fr); gap: 0; }
    .pull-head { flex-direction: column; gap: 4px; }
    .pull-state { justify-items: start; }
    .pull-title { white-space: normal; }
  }
</style>
