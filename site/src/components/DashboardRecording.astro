---
const assetBase = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/capture`;
---
<figure class="recording">
  <div class="recording-frame">
    <video
      id="dashboard-recording"
      class="recording-video"
      poster={`${assetBase}/hero.webp`}
      width="1440"
      height="900"
      muted
      loop
      playsinline
      preload="metadata"
      aria-label="The Glimmervoid dashboard replaying nine recorded Claude Code sessions across four projects. Alt+J jumps to a billing migration waiting for permission and Enter lets it continue, Alt+J jumps to a session asking how to round invoices while it edits an already drawn invoice board docked beside it, Enter applies the half-up rule with change marks on the board, and Alt+J steps on to a bundle size chart in the Shown view."
    >
      <source src={`${assetBase}/dashboard.webm`} type='video/webm; codecs="av01.0.09M.08"' />
      <source src={`${assetBase}/dashboard.mp4`} type='video/mp4; codecs="avc1.64002a"' />
    </video>
  </div>
  <figcaption>The real dashboard, replaying recorded sessions.</figcaption>
</figure>

<style>
  .recording { position: relative; z-index: 2; margin: 72px 0 0; }
  .recording-frame {
    overflow: hidden; border: 1px solid var(--border); border-radius: 6px; background: var(--bg);
    box-shadow: 0 30px 80px -30px color-mix(in srgb, var(--accent-dim) 45%, transparent);
  }
  .recording-video { display: block; width: 100%; height: auto; }
  @media (max-width: 640px) {
    .recording { margin-top: 56px; }
    .recording-frame { aspect-ratio: 1065 / 900; }
    .recording-video { width: calc(100% * 1440 / 1065); max-width: none; }
  }
  figcaption { margin-top: 10px; font-size: 12px; color: var(--text-dim); text-align: center; }
</style>

<script>
  import { prefersReducedMotion } from '../lib/dom.ts';

  function startDashboardRecording(): void {
    const recording = document.getElementById('dashboard-recording');
    if (!(recording instanceof HTMLVideoElement) || prefersReducedMotion()) return;
    recording.play().catch(() => {
      recording.controls = true;
    });
  }

  startDashboardRecording();
</script>
