---
const PLAN_STEPS = [
  { title: 'web', status: 'landed', left: 24, top: 40 },
  { title: 'api', status: 'building', left: 250, top: 40 },
  { title: 'db', status: 'planned', left: 250, top: 160 },
];
const SETTINGS_ROWS = ['Profile', 'Billing', 'Alerts', 'Danger zone'];
const BOARD_BEATS = [
  { name: 'Prototypes', line: 'A working screen framed on a phone or laptop, with dials for what the agent was unsure about.' },
  { name: 'Architecture', line: 'Services and the wires between them, and the plan as steps marked building, then landed.' },
  { name: 'Your marks', line: 'Drag a box, circle with the pen, leave a sticky note or red-pen a doc. The agent sees each one on its next prompt.' },
];
---
<section class="band" id="boards">
  <div class="split reveal">
    <div>
      <p class="band-label">Boards</p>
      <h2>Point, don't paragraph.</h2>
      <p class="band-lede">Today your agent describes the screen and you picture it. Here it puts the screen on a board beside its terminal. Turn a dial.</p>
    </div>
    <div class="panel">
      <div class="board-frame">
      <div class="board" aria-hidden="true">
        <svg class="wires" aria-hidden="true"><path d="M157 71 H250 M90 102 V191 H250" /></svg>
        {PLAN_STEPS.map(({ title, status, left, top }) => (
          <div class="plan-step" style={`--step-left: ${left}px; --step-top: ${top}px`}>{title}<span class="step-status" data-status={status}>{status}</span></div>
        ))}
        <p class="sticky-note">Save sits too low.</p>
        <div class="prototype"><p class="prototype-title">Settings</p>{SETTINGS_ROWS.map((name) => <i>{name}</i>)}<b>Save</b></div>
        <div class="pen-circle"></div>
      </div>
      </div>
      <div class="dials">
        <span class="dial">Accent <i><b></b></i></span>
        <span class="dial">Layout: List</span>
        <span class="dial">Compact</span>
      </div>
      <ul class="rows board-beats">
        {BOARD_BEATS.map(({ name, line }) => <li><b>{name}</b><span>{line}</span></li>)}
      </ul>
    </div>
  </div>
</section>

<style>
  .board-frame { container-type: inline-size; }
  .board { position: relative; height: 330px; overflow: hidden; border: 1px solid var(--border-dim); border-radius: var(--radius); background-color: var(--bg); background-image: radial-gradient(circle, var(--border) 1px, transparent 1.5px); background-size: 16px 16px; }
  .wires { position: absolute; inset: 0; width: 100%; height: 100%; }
  .wires path { fill: none; stroke: var(--accent-dim); stroke-width: 1.5; }
  .plan-step { position: absolute; left: var(--step-left); top: var(--step-top); min-width: 133px; padding: 10px 12px; border: 1px solid var(--border-hover); border-radius: var(--radius); background: var(--bg-card); font-size: var(--type-meta); color: var(--text-head); }
  .rows.board-beats { margin-top: 0; }
  .rows.board-beats li { display: grid; grid-template-columns: 130px 1fr; align-items: start; }
  .rows.board-beats span { color: var(--text-dim); font-family: var(--font-doc); }
  @media (max-width: 640px) { .rows.board-beats li { grid-template-columns: 1fr; gap: 4px; } }
  .step-status { display: block; width: fit-content; margin-top: 6px; padding: 1px 6px; border: 1px solid; border-radius: 2px; font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: .08em; }
  .step-status[data-status="landed"] { color: var(--state-complete); }
  .step-status[data-status="building"] { color: var(--accent); }
  .step-status[data-status="planned"] { color: var(--text-dim); }
  .sticky-note { position: absolute; left: 40px; top: 236px; padding: 9px 12px; border-radius: 2px; rotate: -3deg; background: var(--state-idle); color: var(--bg); font-family: var(--font-doc); font-size: var(--type-body); }
  .prototype { position: absolute; right: 28px; top: 24px; width: 148px; height: 280px; padding: 18px 12px; border: 6px solid var(--border-dim); border-radius: 22px; background: var(--bg-card); }
  .prototype-title { margin: 0 0 10px; color: var(--text-head); font-size: var(--type-meta); font-weight: 700; }
  .prototype i { display: block; padding: 7px 0; border-top: 1px solid var(--border-dim); color: var(--text-dim); font-size: 11px; font-style: normal; }
  .prototype b { position: absolute; left: 12px; right: 12px; bottom: 14px; display: grid; place-items: center; height: 28px; border-radius: var(--radius); background: var(--accent); color: var(--bg); font-size: 11px; }
  .pen-circle { position: absolute; right: 10px; bottom: 4px; width: 172px; height: 58px; border: 2.5px solid var(--state-failed); border-radius: 50%; rotate: -6deg; }
  .dials { display: flex; flex-wrap: wrap; gap: 8px; padding: 14px 0 16px; }
  .dial { display: flex; gap: 8px; align-items: center; padding: 4px 10px; border: 1px solid var(--border-hover); border-radius: var(--radius); font-size: var(--type-meta); color: var(--text-head); }
  .dial i { display: block; width: 28px; height: 4px; border-radius: 2px; background: var(--border); overflow: hidden; }
  .dial i b { display: block; width: 60%; height: 100%; background: var(--accent); }
  @container (max-width: 560px) { .prototype, .pen-circle { display: none; } }
  @container (max-width: 400px) {
    .board { display: flex; flex-direction: column; gap: 12px; align-items: flex-start; height: auto; padding: 20px 16px 24px; }
    .wires { display: none; }
    .plan-step, .sticky-note { position: static; }
    .sticky-note { margin: 8px 0 0 8px; }
  }
</style>
