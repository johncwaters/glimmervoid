---
import nightShiftPack from '../../../../examples/packs/night-shift/pack.json';
import { ThemePalette } from '../../../../shared/contracts/theme-palette.ts';
import { BADGE_LABELS, STATES } from '../../../../shared/states.ts';
import { themeCssColors } from '../../../../shared/theme-colors-core.ts';
import { BUILT_IN_THEME_PALETTES } from '../../../../shared/theme-palettes.ts';

const SHOWN_BUILT_IN_THEME_IDS = ['glimmer', 'glimmer-light', 'golgari', 'midnight', 'phyrexian', 'compleated', 'unicorn'];
const { id: nightShiftThemeId, ...nightShiftPalette } = nightShiftPack.ui.themes[0];
const shownThemes = [
  ...SHOWN_BUILT_IN_THEME_IDS.filter((themeId) => Object.hasOwn(BUILT_IN_THEME_PALETTES, themeId)).map((themeId) => ({ id: themeId, palette: BUILT_IN_THEME_PALETTES[themeId], fromPack: false })),
  { id: nightShiftThemeId, palette: ThemePalette.parse(nightShiftPalette), fromPack: true },
];
const shortLabelOf = (label: string) => label.replace(/ \((Dark|Light)\)$/, '');
const themeRules = shownThemes.map(({ id, palette }) => {
  const declarations = Object.entries(themeCssColors(palette)).map(([property, value]) => `${property}: ${value};`).join(' ');
  return `.packs-demo[data-theme="${id}"] .theme-stage { ${declarations} color-scheme: ${palette.mode}; }`;
}).join('\n');

const BUILT_IN_TABS = ['Focus', 'Reviews', 'Arena', 'Packs'];
const themeChoices = shownThemes.map(({ id, palette, fromPack }) => ({ id, label: shortLabelOf(palette.label), background: palette.chrome.bg, accent: palette.chrome.accent, fromPack }));
const [firstTheme] = themeChoices;
const PACK_TABS = ['PR table', 'Review radar', 'Review drafts'];
const DRAFTED_REVIEWS = [
  { number: '#482', title: 'Retry webhook deliveries', verdict: 'approve with nits', stateToken: 'complete', findings: 'HIGH, MEDIUM, LOW' },
  { number: '#479', title: 'Split the billing worker', verdict: 'request changes', stateToken: 'failed', findings: 'CRITICAL, HIGH' },
  { number: '#476', title: 'Pin the CI Node version', verdict: 'approve', stateToken: 'running', findings: 'nothing found' },
];
const LAUNCHED_SESSIONS = [
  { name: 'standup-12', stateToken: 'running', log: 'reading 14 merged PRs' },
  { name: 'standup-11', stateToken: 'complete', log: 'notes ready' },
  { name: 'standup-10', stateToken: 'complete', log: 'notes ready' },
];
const REVIEW_ROWS = [
  { repo: 'web', number: '#412', title: 'Fix login redirect', stateToken: 'running', status: 'Approved' },
  { repo: 'api', number: '#408', title: 'Cache billing lookups', stateToken: 'waiting', status: 'Changes' },
  { repo: 'web', number: '#415', title: 'Lazy load the diff view', stateToken: 'complete', status: 'Review' },
];
const MERGED_ROWS = [
  { repo: 'web', number: '#401', title: 'Rename color tokens' },
  { repo: 'cli', number: '#399', title: 'Bump Node to 24' },
  { repo: 'api', number: '#396', title: 'Drop the v1 routes' },
  { repo: 'cli', number: '#393', title: 'Retry the flaky upload' },
  { repo: 'api', number: '#390', title: 'Rate limit the webhooks' },
];
---
<section id="packs">
  <div class="section-head reveal">
    <h2><a href="#packs">Your agent changes Glimmervoid with packs.</a></h2>
    <p>Ask for a new theme or a tab of your pull requests. Your agent builds it and shows you a preview on its board. Nothing changes until you approve it.</p>
  </div>
  <figure class="packs-demo reveal" id="packs-demo" data-theme={firstTheme.id} aria-label="A Glimmervoid dashboard with four pack panels: a pull request table playing Game of Life and rain behind its rows, a radar sweeping over the pull requests waiting on you, a scheduled launch button counting down and starting sessions that stream their progress, and a list of drafted reviews of teammates' pull requests, each with a verdict and its findings. The theme buttons below it restyle all of it.">
    <style set:html={themeRules}></style>
    <div class="theme-stage" aria-hidden="true">
      <div class="mock-header">
        <span class="mock-brand">glimmervoid</span>
        <span class="mock-tabs">
          {BUILT_IN_TABS.map((tab) => <span class="mock-tab">{tab}</span>)}
          {PACK_TABS.map((tab, index) => <span class:list={['mock-tab', 'is-pack', { 'is-active': index === 0 }]}>{tab}</span>)}
        </span>
      </div>
      <div class="pack-gallery">
        <div class="pack-panel is-pr-table">
          <canvas class="pr-ambient is-life" data-ambient="life"></canvas>
          <div class="pr-grid">
            <span class="pr-section">In review</span>
            {REVIEW_ROWS.map(({ repo, number, title, stateToken, status }) => (
              <div class="pr-row" style={`--row-state: var(--state-${stateToken})`}>
                <span class="pr-repo">{repo}</span><span class="pr-number">{number}</span><span class="pr-title">{title}</span><span class="pr-status">{status}</span><span class="pr-ci"></span>
              </div>
            ))}
            <span class="pr-section">Recently merged</span>
            <div class="pr-merged">
              {MERGED_ROWS.map(({ repo, number, title }) => (
                <div class="pr-row is-merged"><span class="pr-repo">{repo}</span><span class="pr-number">{number}</span><span class="pr-title">{title}</span></div>
              ))}
              <canvas class="pr-ambient is-rain" data-ambient="rain"></canvas>
            </div>
          </div>
        </div>
        <div class="pack-panel is-radar">
          <span class="panel-name">Review radar</span>
          <canvas class="radar-scope" data-ambient="radar"></canvas>
          <span class="radar-summary">8 reviews waiting on you</span>
        </div>
        <div class="pack-panel is-drafts">
          <span class="panel-name">Review drafts</span>
          <ul class="draft-list">
            {DRAFTED_REVIEWS.map(({ number, title, verdict, stateToken, findings }) => (
              <li class="draft-row" style={`--draft-state: var(--state-${stateToken})`}>
                <span class="pr-number">{number}</span><span class="pr-title">{title}</span><span class="draft-verdict">{verdict}</span><span class="draft-findings">{findings}</span>
              </li>
            ))}
          </ul>
        </div>
        <div class="pack-panel is-launcher" id="packs-launcher" data-running-label={BADGE_LABELS[STATES.RUNNING]} data-complete-label={BADGE_LABELS[STATES.COMPLETE]}>
          <span class="panel-name">New session</span>
          <div class="launcher-row">
            <span class="launcher-button">Standup</span>
            <code class="launcher-cron">0 9 * * 1-5</code>
            <span class="launcher-countdown">next run <span data-countdown>0:05</span></span>
          </div>
          <ol class="launched-sessions" data-launched>
            {LAUNCHED_SESSIONS.map(({ name, stateToken, log }) => (
              <li class="launched-session" data-state={stateToken}>
                <span class="launched-dot"></span><span class="launched-name">{name}</span><span class="launched-badge">{BADGE_LABELS[stateToken === 'running' ? STATES.RUNNING : STATES.COMPLETE]}</span>
                <span class="launched-log">{log}</span>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </div>
    <div class="theme-switch" data-themes={JSON.stringify(themeChoices)}>
      <button type="button" class="theme-step" data-step="-1" aria-label="Previous theme"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M10 3 5 8l5 5" /></svg></button>
      <button type="button" class="theme-step" data-step="1" aria-label="Next theme"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="m6 3 5 5-5 5" /></svg></button>
      <span class="theme-current" aria-live="polite" style={`--swatch-bg: ${firstTheme.background}; --swatch-accent: ${firstTheme.accent}`}>
        <span class="theme-swatch" aria-hidden="true"></span><span class="theme-name">{firstTheme.label}</span><span class="theme-source" hidden={!firstTheme.fromPack}>pack</span>
      </span>
    </div>
  </figure>
</section>

<script>
  import { markWhileOnScreen, runFramesWhileVisible } from '../../lib/dom.ts';
  import { isAmbientKind, runAmbientWhileVisible } from '../../lib/pack-ambient.ts';

  const packsDemo = document.getElementById('packs-demo');
  const redrawAmbientCanvases: Array<() => void> = [];
  if (packsDemo) markWhileOnScreen(packsDemo);
  interface ThemeChoice { id: string; label: string; background: string; accent: string; fromPack: boolean }
  const themeSwitch = packsDemo?.querySelector<HTMLElement>('.theme-switch');
  const themeCurrent = themeSwitch?.querySelector<HTMLElement>('.theme-current');
  if (packsDemo && themeSwitch && themeCurrent) {
    const themeChoices: ThemeChoice[] = JSON.parse(themeSwitch.dataset.themes ?? '[]');
    const themeName = themeCurrent.querySelector<HTMLElement>('.theme-name');
    const themeSource = themeCurrent.querySelector<HTMLElement>('.theme-source');
    let shownThemeIndex = 0;
    const showTheme = (themeIndex: number) => {
      const theme = themeChoices[themeIndex];
      if (!theme) return;
      shownThemeIndex = themeIndex;
      packsDemo.dataset.theme = theme.id;
      for (const redraw of redrawAmbientCanvases) redraw();
      themeCurrent.style.setProperty('--swatch-bg', theme.background);
      themeCurrent.style.setProperty('--swatch-accent', theme.accent);
      if (themeName) themeName.textContent = theme.label;
      if (themeSource) themeSource.hidden = !theme.fromPack;
    };
    for (const stepButton of themeSwitch.querySelectorAll<HTMLButtonElement>('.theme-step')) {
      stepButton.addEventListener('click', () => {
        const step = Number(stepButton.dataset.step);
        showTheme((shownThemeIndex + step + themeChoices.length) % themeChoices.length);
      });
    }
  }
  const LAUNCH_EVERY_SECONDS = 5;
  const SESSION_LOG_LINES = ['starting claude', 'reading 14 merged PRs', 'summarizing #412 and #408', 'drafting the notes', 'notes ready'];
  const launcher = document.getElementById('packs-launcher');
  const countdown = launcher?.querySelector<HTMLElement>('[data-countdown]');
  const launchedList = launcher?.querySelector<HTMLElement>('[data-launched]');
  const launchButton = launcher?.querySelector<HTMLElement>('.launcher-button');
  if (launcher && countdown && launchedList && launchButton) {
    const runningLabel = launcher.dataset.runningLabel ?? '';
    const completeLabel = launcher.dataset.completeLabel ?? '';
    let launchNumber = 12;
    const advanceSession = (session: HTMLElement) => {
      if (session.dataset.state !== 'running') return;
      const logStep = Number(session.dataset.logStep ?? '1') + 1;
      session.dataset.logStep = String(logStep);
      const log = session.querySelector<HTMLElement>('.launched-log');
      if (log) log.textContent = SESSION_LOG_LINES[Math.min(logStep, SESSION_LOG_LINES.length - 1)];
      if (logStep < SESSION_LOG_LINES.length - 1) return;
      session.dataset.state = 'complete';
      const badge = session.querySelector<HTMLElement>('.launched-badge');
      if (badge) badge.textContent = completeLabel;
    };
    const launchSession = () => {
      launchNumber += 1;
      const oldestSession = launchedList.lastElementChild;
      if (!(oldestSession instanceof HTMLElement)) return;
      oldestSession.dataset.state = 'running';
      oldestSession.dataset.logStep = '0';
      const textBySelector: Record<string, string> = { '.launched-name': `standup-${launchNumber}`, '.launched-badge': runningLabel, '.launched-log': SESSION_LOG_LINES[0] };
      for (const [selector, text] of Object.entries(textBySelector)) {
        const part = oldestSession.querySelector<HTMLElement>(selector);
        if (part) part.textContent = text;
      }
      oldestSession.classList.remove('is-new');
      launchedList.prepend(oldestSession);
      void oldestSession.offsetWidth;
      oldestSession.classList.add('is-new');
      launchButton.classList.remove('is-pressed');
      void launchButton.offsetWidth;
      launchButton.classList.add('is-pressed');
    };
    runFramesWhileVisible(launcher, Array.from({ length: LAUNCH_EVERY_SECONDS }, () => 1000), (frameIndex) => {
      const secondsLeft = LAUNCH_EVERY_SECONDS - frameIndex;
      countdown.textContent = `0:0${secondsLeft === LAUNCH_EVERY_SECONDS ? 0 : secondsLeft}`;
      for (const session of launchedList.querySelectorAll<HTMLElement>('.launched-session')) advanceSession(session);
      if (frameIndex === 0) launchSession();
    });
  }
  for (const canvas of document.querySelectorAll<HTMLCanvasElement>('#packs-demo canvas[data-ambient]')) {
    const kind = canvas.dataset.ambient;
    if (isAmbientKind(kind)) redrawAmbientCanvases.push(runAmbientWhileVisible(canvas, kind));
  }
</script>

<style>
  .packs-demo { margin: 0; display: grid; gap: 18px; }
  .theme-stage {
    display: grid; gap: 12px; padding: 14px; border: 1px solid var(--border); border-radius: var(--radius-lg); background: var(--bg); color: var(--text);
    transition: background 320ms var(--ease-out-expo), color 320ms var(--ease-out-expo), border-color 320ms var(--ease-out-expo);
  }
  .mock-header { display: flex; align-items: center; gap: 18px; padding: 8px 12px; border-radius: var(--radius-lg); background: var(--bg-header); border: 1px solid var(--border-dim); min-width: 0; }
  .mock-brand { color: var(--text-head); font-weight: 700; font-size: var(--type-meta); }
  .mock-tabs { display: flex; gap: 4px; overflow: hidden; min-width: 0; }
  .mock-tab { padding: 4px 10px; border-radius: 999px; font-size: var(--type-meta); color: var(--text-dim); white-space: nowrap; }
  .mock-tab.is-pack { color: var(--accent); }
  .mock-tab.is-active { background: var(--bg-surface); color: var(--text-head); }
  .pack-gallery { display: grid; grid-template-columns: minmax(0, 2fr) minmax(0, 1fr); grid-template-areas: "pr radar" "pr launcher" "drafts drafts"; gap: 10px; }
  .pack-panel { display: flex; flex-direction: column; gap: 10px; min-width: 0; padding: 12px; border: 1px solid var(--border-dim); border-radius: var(--radius-lg); background: var(--bg-card); }
  .pack-panel.is-pr-table { position: relative; grid-area: pr; overflow: hidden; }
  .pack-panel.is-radar { grid-area: radar; align-items: center; }
  .pack-panel.is-launcher { grid-area: launcher; }
  .pack-panel.is-drafts { grid-area: drafts; }
  .draft-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 4px; font-size: var(--type-meta); }
  .draft-row { display: grid; grid-template-columns: 5ch minmax(0, 1fr) auto 18ch; align-items: center; gap: 12px; padding: 6px 8px; border-radius: 6px; background: var(--bg-surface); }
  .draft-row > span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .draft-verdict { padding: 1px 8px; border: 1px solid var(--draft-state); border-radius: 999px; color: var(--draft-state); }
  .draft-findings { color: var(--text-dim); text-align: right; }
  .panel-name { color: var(--text-head); font-size: var(--type-meta); font-weight: 700; }
  .pr-grid { position: relative; display: grid; gap: 4px; font-size: var(--type-meta); }
  .pr-section { justify-self: start; margin-top: 6px; padding: 1px 6px; border-radius: 4px; background: var(--bg-card); color: var(--text-muted); font-size: var(--type-meta); }
  .pr-row { display: grid; grid-template-columns: 4ch 5ch minmax(0, 1fr) 9ch 10px; align-items: center; gap: 12px; padding: 6px 8px; border-radius: 6px; background: color-mix(in oklab, var(--bg-surface) 94%, transparent); }
  .pr-row > span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .pr-repo, .pr-number { color: var(--text-dim); }
  .pr-title { color: var(--text-head); }
  .pr-status { color: var(--row-state); font-weight: 700; }
  .pr-ci { width: 8px; height: 8px; border-radius: 50%; background: var(--state-running); }
  .pr-merged { position: relative; display: grid; gap: 4px; }
  .pr-row.is-merged { grid-template-columns: 4ch 5ch minmax(0, 1fr) 9ch 10px; background: color-mix(in oklab, var(--bg-card) 92%, transparent); border: 1px solid var(--border-dim); }
  .pr-row.is-merged .pr-title { color: var(--text-dim); }
  .pr-ambient { position: absolute; top: 0; bottom: 0; width: 100%; height: 100%; pointer-events: none; }
  .pr-ambient.is-life { inset: 0; opacity: 0.55; }
  .pr-ambient.is-rain { right: 0; width: 84px; z-index: 1; }
  .radar-scope { display: block; width: min(100%, 210px); aspect-ratio: 1; border-radius: 50%; background: var(--bg-surface); border: 1px solid var(--border); color: var(--accent); }
  .radar-summary { color: var(--text-dim); font-size: var(--type-meta); }
  .board-task { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: var(--text-head); font-size: var(--type-meta); }
  .launcher-row { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; }
  .launcher-button { padding: 6px 14px; border-radius: 999px; background: var(--accent); color: var(--bg); font-size: var(--type-meta); font-weight: 700; }
  .launcher-button.is-pressed { animation: launcher-press 420ms var(--ease-out-expo); }
  .launcher-cron, .launcher-countdown { color: var(--text-dim); font-size: var(--type-meta); }
  .launcher-countdown [data-countdown] { color: var(--accent); font-weight: 700; font-variant-numeric: tabular-nums; }
  .launched-sessions { list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; min-height: 0; }
  .launched-session { --session-state: var(--state-running); display: grid; grid-template-columns: 8px minmax(0, 1fr) auto; align-items: center; gap: 2px 8px; padding: 7px 10px; border: 1px solid color-mix(in oklab, var(--session-state) 45%, var(--border-dim)); border-radius: 6px; background: color-mix(in oklab, var(--session-state) 10%, var(--bg-surface)); transition: border-color 400ms var(--ease-out-expo), background 400ms var(--ease-out-expo); }
  .launched-session[data-state="complete"] { --session-state: var(--state-complete); }
  .launched-session.is-new { animation: session-arrive 520ms var(--ease-out-expo); }
  .launched-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--session-state); }
  .launched-name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: var(--text-head); font-size: var(--type-meta); }
  .launched-badge { color: var(--session-state); font-size: var(--type-meta); font-weight: 700; }
  .launched-log { grid-column: 2 / -1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: var(--text-dim); font-family: var(--font-mono); font-size: 11px; }
  .launched-log::before { content: "> "; color: var(--session-state); }
  @keyframes launcher-press { 0% { scale: 1; } 30% { scale: 0.9; } 100% { scale: 1; } }
  @keyframes session-arrive { from { opacity: 0; translate: 0 -8px; } }
  .theme-switch { display: flex; align-items: center; gap: 10px; }
  .theme-step { display: grid; place-items: center; width: 40px; height: 40px; flex: none; padding: 0; border: 1px solid var(--border); border-radius: 50%; background: var(--bg-card); color: var(--text-head); cursor: pointer; transition: border-color 160ms var(--ease-out-expo); }
  .theme-step:hover { border-color: var(--accent); }
  .theme-step:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .theme-step svg { width: 16px; height: 16px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .theme-current { display: inline-flex; margin-left: 4px; align-items: center; gap: 8px; min-width: 0; color: var(--text-head); font-size: var(--type-meta); }
  .theme-swatch { width: 22px; height: 22px; flex: none; border-radius: 50%; background: linear-gradient(135deg, var(--swatch-bg) 50%, var(--swatch-accent) 50%); border: 1px solid var(--border-hover); }
  .theme-source { padding: 1px 6px; border-radius: 999px; background: var(--bg-surface); color: var(--accent); font-size: var(--type-micro, 11px); }
  @media (max-width: 820px) {
    .mock-brand { display: none; }
    .pack-gallery { grid-template-columns: minmax(0, 1fr); grid-template-areas: "pr" "radar" "launcher" "drafts"; }
    .pr-row, .pr-row.is-merged { grid-template-columns: 5ch minmax(0, 1fr) 9ch 10px; }
    .pr-repo { display: none; }
    .pr-ambient.is-rain { width: 72px; }
  }
  @media (max-width: 480px) {
    .mock-tab:not(.is-active) { display: none; }
    .draft-row { grid-template-columns: 5ch minmax(0, 1fr) auto; }
    .draft-findings { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .theme-stage { transition: none; }
    :is(.launcher-button, .launched-session) { animation: none; }
    .launched-session { transition: none; }
  }
</style>
