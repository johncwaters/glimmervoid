---
import nightShiftPack from '../../../../examples/packs/night-shift/pack.json';
import { ThemePalette } from '../../../../shared/contracts/theme-palette.ts';
import { BADGE_LABELS, STATES } from '../../../../shared/states.ts';
import { themeCssColors } from '../../../../shared/theme-colors-core.ts';
import { BUILT_IN_THEME_PALETTES } from '../../../../shared/theme-palettes.ts';

const SHOWN_BUILT_IN_THEME_IDS = ['glimmer', 'glimmer-light', 'golgari', 'midnight', 'phyrexian', 'compleated', 'unicorn'];
const { id: nightShiftThemeId, ...nightShiftPalette } = nightShiftPack.ui.themes[0];
const shownThemes = [
  ...SHOWN_BUILT_IN_THEME_IDS.filter((themeId) => Object.hasOwn(BUILT_IN_THEME_PALETTES, themeId)).map((themeId) => ({ id: themeId, palette: BUILT_IN_THEME_PALETTES[themeId], fromPack: false })),
  { id: nightShiftThemeId, palette: ThemePalette.parse(nightShiftPalette), fromPack: true },
];
const shortLabelOf = (label: string) => label.replace(/ \((Dark|Light)\)$/, '');
const themeRules = shownThemes.map(({ id, palette }) => {
  const declarations = Object.entries(themeCssColors(palette)).map(([property, value]) => `${property}: ${value};`).join(' ');
  return `.packs-demo:has(input[value="${id}"]:checked) .theme-stage { ${declarations} color-scheme: ${palette.mode}; }`;
}).join('\n');

const MOCK_SESSIONS = [
  { task: 'fix-auth-redirect', state: STATES.RUNNING, stateToken: 'running' },
  { task: 'migrate-billing', state: STATES.WAITING, stateToken: 'waiting' },
  { task: 'flaky-upload-test', state: STATES.FAILED, stateToken: 'failed' },
  { task: 'rename-color-tokens', state: STATES.COMPLETE, stateToken: 'complete' },
];
const BUILT_IN_TABS = ['Focus', 'Reviews', 'Arena', 'Packs'];
const PACK_STEPS = [
  { title: 'Ask', line: 'Say what you want in plain words.', visual: 'prompt' },
  { title: 'Preview', line: 'Your agent shows it on its board with sample data.', visual: 'board' },
  { title: 'Approve', line: 'Only you can turn it on.', visual: 'approve' },
  { title: 'Use', line: 'It shows up as a new tab.', visual: 'tab' },
];
---
<section id="packs">
  <div class="section-head reveal">
    <h2>Packs. Your agent changes Glimmervoid however you want.</h2>
    <p>Ask for a new theme or a tab of your pull requests. Your agent builds it and shows you a preview on its board. Nothing changes until you approve it.</p>
  </div>
  <figure class="packs-demo reveal" aria-label="A Glimmervoid dashboard restyled by the theme you pick below it, with a tab an agent-built pack added.">
    <style set:html={themeRules}></style>
    <div class="theme-stage" aria-hidden="true">
      <div class="mock-header">
        <span class="mock-brand">glimmervoid</span>
        <span class="mock-tabs">
          {BUILT_IN_TABS.map((tab, index) => <span class:list={['mock-tab', { 'is-active': index === 0 }]}>{tab}</span>)}
          <span class="mock-tab is-pack">PR table</span>
        </span>
      </div>
      <ol class="mock-sessions">
        {MOCK_SESSIONS.map(({ task, state, stateToken }) => (
          <li class="mock-session" style={`--row-state: var(--state-${stateToken})`}>
            <span class="mock-dot"></span>
            <span class="mock-task">{task}</span>
            <span class="mock-badge">{BADGE_LABELS[state]}</span>
          </li>
        ))}
      </ol>
      <div class="mock-terminal"><span class="mock-prompt">&gt;</span> make me a panel of my PRs as one table<span class="mock-cursor"></span></div>
    </div>
    <fieldset class="theme-picker">
      <legend class="theme-picker-label">Theme</legend>
      {shownThemes.map(({ id, palette, fromPack }, index) => (
        <label class="theme-choice" style={`--swatch-bg: ${palette.chrome.bg}; --swatch-accent: ${palette.chrome.accent}`}>
          <input type="radio" name="packs-theme" value={id} checked={index === 0} />
          <span class="theme-swatch" aria-hidden="true"></span>
          <span>{shortLabelOf(palette.label)}</span>
          {fromPack && <span class="theme-source">pack</span>}
        </label>
      ))}
    </fieldset>
  </figure>
  <ol class="pack-steps reveal">
    {PACK_STEPS.map(({ title, line, visual }, index) => (
      <li class="pack-step">
        <span class="pack-step-number">{index + 1}</span>
        <span class="pack-step-title">{title}</span>
        <span class="pack-step-line">{line}</span>
        {visual === 'prompt' && <code class="pack-step-visual">&gt; make me a PR table</code>}
        {visual === 'board' && <span class="pack-step-visual board-card" aria-hidden="true"><span></span><span></span><span></span></span>}
        {visual === 'approve' && <span class="pack-step-visual approve-pill" aria-hidden="true">Approve</span>}
        {visual === 'tab' && <span class="pack-step-visual tab-strip" aria-hidden="true"><span>Packs</span><span class="is-new">PR table</span></span>}
      </li>
    ))}
  </ol>
</section>

<style>
  .packs-demo { margin: 0; display: grid; gap: 18px; }
  .theme-stage {
    display: grid; gap: 12px; padding: 14px; border: 1px solid var(--border); border-radius: var(--radius-lg); background: var(--bg); color: var(--text);
    transition: background 320ms var(--ease-out-expo), color 320ms var(--ease-out-expo), border-color 320ms var(--ease-out-expo);
  }
  .mock-header { display: flex; align-items: center; gap: 18px; padding: 8px 12px; border-radius: var(--radius-lg); background: var(--bg-header); border: 1px solid var(--border-dim); min-width: 0; }
  .mock-brand { color: var(--text-head); font-weight: 700; font-size: var(--type-meta); }
  .mock-tabs { display: flex; gap: 4px; overflow: hidden; min-width: 0; }
  .mock-tab { padding: 4px 10px; border-radius: 999px; font-size: var(--type-meta); color: var(--text-dim); white-space: nowrap; }
  .mock-tab.is-active { background: var(--bg-surface); color: var(--text-head); }
  .mock-tab.is-pack { color: var(--accent); border: 1px dashed var(--accent-dim); }
  .mock-sessions { list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; }
  .mock-session { display: flex; align-items: center; gap: 10px; padding: 10px 12px; border: 1px solid var(--border-dim); border-left: 2px solid var(--row-state); border-radius: var(--radius-lg); background: var(--bg-card); min-width: 0; }
  .mock-dot { width: 8px; height: 8px; flex: none; border-radius: 50%; background: var(--row-state); }
  .mock-task { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: var(--text-head); font-size: var(--type-meta); }
  .mock-badge { color: var(--row-state); font-size: var(--type-meta); font-weight: 700; }
  .mock-terminal { padding: 10px 12px; border-radius: var(--radius-lg); background: var(--bg-card); border: 1px solid var(--border-dim); font-family: var(--font-mono); font-size: var(--type-meta); color: var(--text); overflow-wrap: anywhere; }
  .mock-prompt { color: var(--accent); }
  .mock-cursor { display: inline-block; width: 7px; height: 1em; margin-left: 4px; vertical-align: text-bottom; background: var(--accent); }
  .theme-picker { display: flex; flex-wrap: wrap; gap: 8px; margin: 0; padding: 0; border: 0; min-width: 0; }
  .theme-picker-label { float: left; margin-right: 6px; padding: 9px 0; color: var(--text-dim); font-size: var(--type-meta); }
  .theme-choice { position: relative; display: inline-flex; align-items: center; gap: 8px; min-height: 40px; padding: 6px 14px 6px 8px; border: 1px solid var(--border); border-radius: 999px; background: var(--bg-card); color: var(--text-dim); font-size: var(--type-meta); cursor: pointer; }
  .theme-choice input { position: absolute; inset: 0; margin: 0; opacity: 0; cursor: pointer; }
  .theme-choice:has(input:checked) { border-color: var(--accent); color: var(--text-head); }
  .theme-choice:has(input:focus-visible) { outline: 2px solid var(--accent); outline-offset: 2px; }
  .theme-swatch { width: 22px; height: 22px; flex: none; border-radius: 50%; background: linear-gradient(135deg, var(--swatch-bg) 50%, var(--swatch-accent) 50%); border: 1px solid var(--border-hover); }
  .theme-source { padding: 1px 6px; border-radius: 999px; background: var(--bg-surface); color: var(--accent); font-size: var(--type-micro, 11px); }
  .pack-steps { list-style: none; margin: 40px 0 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 10px; }
  .pack-step { display: flex; flex-direction: column; gap: 4px; min-width: 0; padding: 16px 18px; border: 1px solid var(--border); border-radius: var(--radius-lg); background: var(--bg-card); }
  .pack-step-number { color: var(--accent); font-size: var(--type-meta); font-weight: 700; }
  .pack-step-title { color: var(--text-head); font-weight: 700; }
  .pack-step-line { color: var(--text-dim); font-size: var(--type-meta); }
  .pack-step-visual { margin-top: auto; padding-top: 14px; }
  code.pack-step-visual { font-size: var(--type-meta); color: var(--text); overflow-wrap: anywhere; }
  .board-card { display: grid; gap: 6px; }
  .board-card span { display: block; height: 8px; border-radius: 4px; background: var(--border); }
  .board-card span:first-child { width: 60%; background: var(--accent-dim); }
  .board-card span:last-child { width: 80%; }
  .approve-pill { align-self: start; margin-top: auto; padding: 6px 14px; border-radius: 999px; background: var(--accent); color: var(--bg); font-size: var(--type-meta); font-weight: 700; }
  .tab-strip { display: flex; gap: 6px; font-size: var(--type-meta); }
  .tab-strip span { padding: 4px 10px; border-radius: 999px; color: var(--text-dim); white-space: nowrap; }
  .tab-strip .is-new { color: var(--accent); border: 1px dashed var(--accent-dim); }
  @media (max-width: 820px) {
    .pack-steps { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; }
    .mock-brand { display: none; }
  }
  @media (max-width: 480px) {
    .pack-steps { grid-template-columns: minmax(0, 1fr); }
    .mock-tab:not(.is-active, .is-pack) { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .theme-stage { transition: none; }
  }
</style>
