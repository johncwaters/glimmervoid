---
import { REPOSITORY_URL } from '../../lib/product-facts.ts';

const SUPPORTED_AGENTS = [
  { label: 'Claude Code', support: 'First-class' },
  { label: 'Codex', support: 'First-class' },
  { label: 'Kimi Code', support: 'First-class' },
  { label: 'Grok and custom CLIs', support: 'Best effort' },
];
---
<section class="band">
  <div class="split reveal">
    <div>
      <p class="band-label">Agents</p>
      <h2>Agents, as they are.</h2>
      <p class="band-lede">Glimmervoid runs the agent CLI you already use. No wrapper model, no new harness.</p>
      <a class="btn band-action" href={`${REPOSITORY_URL}/blob/main/tests/agent-parity.test.ts`}>See the parity matrix</a>
    </div>
    <div class="panel">
      <h3>Supported agents</h3>
      <p>A feature ships only when it works on all three first-class agents.</p>
      <ul class="rows">
        {SUPPORTED_AGENTS.map(({ label, support }) => <li>{label}<span class="row-end">{support}</span></li>)}
      </ul>
    </div>
  </div>
</section>

<style>
  .band-action { display: inline-block; margin-top: 28px; text-decoration: none; }
</style>
