---
import { BRAND_MARK_BRACKETS, BRAND_MARK_LIGHT, BRAND_MARK_VIEWBOX } from '../../../../shared/brand-mark.ts';
import DashboardRecording from '../DashboardRecording.astro';
import Nav from '../Nav.astro';
import Wordmark from '../Wordmark.astro';
import { INSTALL_COMMAND, WINDOWS_INSTALL_COMMAND } from '../../lib/install-command.ts';
import { INSTALL_PLATFORM_LABELS, INSTALL_PLATFORMS } from '../../lib/install-platform.ts';
---
<header class="next-hero">
  <div class="ghost-field">
    <svg class="ghost-mark" id="ghost-mark" viewBox={BRAND_MARK_VIEWBOX} aria-hidden="true">
      <path class="ghost-halo" d={BRAND_MARK_LIGHT} />
      <g class="ghost-dial">{BRAND_MARK_BRACKETS.map(({ side, d }) => <path class="ghost-bracket" data-side={side} d={d} />)}</g>
      <path class="ghost-light" d={BRAND_MARK_LIGHT} />
    </svg>
  </div>
  <Nav />

  <h1 class="hero-wordmark" id="top"><Wordmark isStacked /><span class="hero-category">Your coding agents draw plans and screens on a shared board you mark up.</span></h1>

  <div class="hero-install" id="hero-install">
    <div class="install-row">
      <fieldset class="platform-switch" data-platform-switch aria-label="Your operating system">
        {INSTALL_PLATFORMS.map((platform) => <button type="button" data-platform={platform} aria-pressed="false">{INSTALL_PLATFORM_LABELS[platform]}</button>)}
      </fieldset>
      <div class="install-line">
        <code data-install-command title="Click to copy"><span data-install-for="default">{INSTALL_COMMAND}</span><span data-install-for="windows" hidden>{WINDOWS_INSTALL_COMMAND}</span></code>
        <button class="btn copy-install" type="button" data-copy-install>Copy</button>
      </div>
    </div>
    <p class="copy-status" data-copy-status role="status"></p>
    <p class="cloud-alternative"><a href="#cloud">Join the cloud waitlist</a></p>
  </div>

  <DashboardRecording />
</header>

<style>
  .next-hero { position: relative; }
  .ghost-field { position: absolute; top: 0; bottom: 0; left: calc(50% - 50vw); width: 100vw; overflow: hidden; pointer-events: none; }
  .ghost-mark { position: absolute; right: max(-140px, calc(50vw - 700px)); top: 60px; width: 620px; opacity: .03; color: var(--text-head); }
  .ghost-mark { overflow: visible; }
  .ghost-dial, .ghost-light, .ghost-halo { transform-origin: 50px 50px; }
  .ghost-bracket { fill: none; stroke: currentColor; stroke-width: 11; stroke-linejoin: miter; stroke-linecap: butt; }
  .ghost-light { fill: currentColor; }
  .ghost-halo { fill: none; stroke: currentColor; stroke-width: 2; vector-effect: non-scaling-stroke; opacity: 0; }

  .hero-wordmark { position: relative; margin: 0; padding-top: 56px; font-size: clamp(56px, 9.4vw, 120px); line-height: .9; }
  .hero-category { display: block; margin-top: 24px; font-size: var(--type-title); font-weight: 400; line-height: 1.4; letter-spacing: normal; color: var(--text-dim); }

  .hero-install { position: relative; margin-top: 56px; }
  .install-row { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; }
  .install-line { flex: 1 1 480px; display: flex; align-items: center; gap: 12px; min-width: 0; max-width: 560px; height: 44px; padding: 0 4px 0 16px; border-radius: var(--radius); background: var(--bg-surface); border: 1px solid var(--border); }
  .install-line code { font-family: var(--font-mono); display: flex; align-items: center; gap: 10px; min-width: 0; font-size: var(--type-body); white-space: nowrap; cursor: copy; }
  .install-line code::before { content: "$"; color: var(--accent-dim); }
  .install-line [data-install-for] { display: block; min-width: 0; overflow: hidden; text-overflow: ellipsis; }
  .install-line [data-install-for][hidden] { display: none; }
  .copy-install { margin-left: auto; flex: none; height: 34px; padding-block: 0; }
  .copy-status { display: block; margin-top: 10px; min-height: 21px; }
  .cloud-alternative { margin-top: 4px; color: var(--text-dim); }

  .next-hero :global(.recording) { width: min(1000px, 100%); margin: 72px auto 0; }
  .next-hero :global(.recording-frame) { aspect-ratio: 1440 / 780; }
  .next-hero :global(.recording figcaption) { display: none; }

  @media (max-width: 640px) {
    .next-hero :global(.recording-frame) { aspect-ratio: auto; }
    .next-hero :global(.recording-video) { width: 100%; }
  }
</style>

<script>
  import { playMarkLock } from '../../../../public/loading-unlock.ts';
  import { runFramesWhileVisible } from '../../lib/dom.ts';
  import { wireInstallPicker } from '../../lib/install-picker.ts';

  const GHOST_TURN_EVERY_MS = 5000;
  const ghostMark = document.getElementById('ghost-mark');
  const ghostDial = ghostMark?.querySelector('.ghost-dial');
  const ghostLight = ghostMark?.querySelector('.ghost-light');
  const ghostHalo = ghostMark?.querySelector('.ghost-halo');
  if (ghostMark && ghostDial && ghostLight && ghostHalo) {
    runFramesWhileVisible(ghostMark, [GHOST_TURN_EVERY_MS, GHOST_TURN_EVERY_MS], () => {
      void playMarkLock({ mark: ghostMark, dial: ghostDial, light: ghostLight, halo: ghostHalo });
    });
  }

  const heroInstall = document.getElementById('hero-install');
  if (heroInstall) wireInstallPicker(heroInstall);
</script>
