---
import { deriveNyanGeometry } from '../../../../public/nyan-geometry-core.ts';
import { BRAND_ACCENT, BRAND_MARK_VIEWBOX, brandMarkMarkup } from '../../../../shared/brand-mark.ts';
import DashboardRecording from '../DashboardRecording.astro';
import StateIcon from './StateIcon.astro';
import { INSTALL_COMMAND, WINDOWS_INSTALL_COMMAND } from '../../lib/install-command.ts';
import { INSTALL_PLATFORM_LABELS, INSTALL_PLATFORMS } from '../../lib/install-platform.ts';
import { REPOSITORY_URL } from '../../lib/product-facts.ts';
import { sitePath } from '../../lib/site-path.ts';
import type { StatusIcon } from '../../../../shared/state-icons.ts';

const geometry = deriveNyanGeometry({ viewportWidthPx: 1440, viewportHeightPx: 900, verticalProgress: 0 });
const mascotSizeStyle = `--nyan-width: ${geometry.spriteWidthPx}px; --nyan-height: ${geometry.spriteHeightPx}px`;

const SHOWN_STATES: readonly { label: string; icon: StatusIcon; colorToken: string }[] = [
  { label: 'Working', icon: 'working', colorToken: '--state-running' },
  { label: 'Needs input', icon: 'needs-input', colorToken: '--state-waiting' },
  { label: 'Failed', icon: 'failed', colorToken: '--state-failed' },
  { label: 'Complete', icon: 'complete', colorToken: '--state-complete' },
  { label: 'Monitoring', icon: 'monitoring', colorToken: '--state-monitoring' },
  { label: 'Idle', icon: 'idle', colorToken: '--state-idle' },
];

const NAV_LINKS = [
  { label: 'Boards', href: '#boards' },
  { label: 'Sane YOLO', href: '#sane-yolo' },
  { label: 'Phone', href: '#phone' },
  { label: 'Blog', href: sitePath('blog/') },
  { label: 'Changelog', href: `${REPOSITORY_URL}/blob/main/CHANGELOG.md` },
  { label: 'GitHub', href: REPOSITORY_URL },
];
---
<header class="next-hero">
  <svg class="ghost-mark" viewBox={BRAND_MARK_VIEWBOX} aria-hidden="true" set:html={brandMarkMarkup({ frame: 'currentColor', light: 'currentColor' })}></svg>
  <nav class="next-nav" aria-label="Main">
    <a class="brand" href="#top"><svg viewBox={BRAND_MARK_VIEWBOX} aria-hidden="true" set:html={brandMarkMarkup({ frame: 'currentColor', light: BRAND_ACCENT })}></svg>Glimmervoid</a>
    <ul>
      {NAV_LINKS.map(({ label, href }) => <li><a href={href}>{label}</a></li>)}
      <li><a class="nav-install" href="#install">Install</a></li>
    </ul>
  </nav>

  <div class="hero-grid" id="top">
    <h1 class="wordmark"><span>Glimmer</span><span class="void">void</span></h1>
    <div class="hero-side">
      <p class="tagline">One needs you. <em>You'll know which.</em></p>
      <p>Supervises your Claude Code, Codex and Kimi Code sessions on this machine, and lights up the one waiting on an answer.</p>
    </div>
  </div>

  <div class="hero-install" id="hero-install">
    <div class="mascot" aria-hidden="true">
      <div class="flying-animal-preview mascot-stage" style={mascotSizeStyle}><div class="nyan-sprite is-cat"></div></div>
      <span class="bubble">Now with <b>Boards</b></span>
    </div>
    <div class="install-row">
      <fieldset class="platform-switch" data-platform-switch aria-label="Your operating system" hidden>
        {INSTALL_PLATFORMS.map((platform) => <button type="button" data-platform={platform} aria-pressed="false">{INSTALL_PLATFORM_LABELS[platform]}</button>)}
      </fieldset>
      <div class="install-line">
        <code data-install-command title="Click to copy"><span data-install-for="default">{INSTALL_COMMAND}</span><span data-install-for="windows" hidden>{WINDOWS_INSTALL_COMMAND}</span></code>
        <button class="copy-install" type="button" data-copy-install>Copy</button>
      </div>
    </div>
    <p class="copy-status" data-copy-status role="status"></p>
    <p class="install-note">No Node needed. No account. Open source, MIT. Runs the agent subscription you already pay for.</p>
  </div>

  <DashboardRecording />

  <ul class="spectrum" aria-label="Session states">
    {SHOWN_STATES.map(({ label, icon, colorToken }) => <li style={`color: var(${colorToken})`}><StateIcon icon={icon} />{label}</li>)}
  </ul>
</header>

<style>
  .next-hero { position: relative; }
  .ghost-mark { position: absolute; right: -140px; top: 60px; width: 620px; opacity: .03; pointer-events: none; color: var(--text-head); }

  .next-nav { position: relative; display: flex; align-items: center; justify-content: space-between; gap: 24px; height: 64px; }
  .brand { display: flex; align-items: center; gap: 10px; font-family: var(--font-mono); font-weight: 700; color: var(--text-head); letter-spacing: .1em; text-transform: uppercase; font-size: var(--type-body); text-decoration: none; }
  .brand svg { width: 20px; height: 20px; }
  .next-nav ul { display: flex; gap: 24px; list-style: none; margin: 0; padding: 0; align-items: center; font-size: var(--type-body); }
  .next-nav ul a { color: var(--text-dim); text-decoration: none; }
  .next-nav ul a:hover { color: var(--text-head); }
  .next-nav ul .nav-install { display: inline-flex; align-items: center; height: 32px; padding: 0 12px; border-radius: var(--radius); background: var(--accent); color: var(--bg); font-weight: 700; text-transform: uppercase; letter-spacing: .08em; font-size: var(--type-meta); }
  .next-nav ul .nav-install:hover { color: var(--bg); background: color-mix(in oklab, var(--accent) 85%, var(--text-head)); }

  .hero-grid { position: relative; display: grid; grid-template-columns: 1.5fr 1fr; gap: 40px; padding-top: 56px; align-items: start; }
  .wordmark { font-family: var(--font-mono); font-weight: 700; text-transform: uppercase; letter-spacing: .06em; color: var(--text-head); font-size: clamp(56px, 9.4vw, 120px); line-height: .9; }
  .wordmark span { display: block; width: fit-content; }
  .wordmark .void { position: relative; color: transparent; -webkit-text-stroke: 2px var(--text-head); }
  .wordmark .void::after { content: ""; position: absolute; left: calc(100% + 18px); top: 36%; width: .24em; height: .24em; rotate: 45deg; background: var(--state-waiting); }
  .hero-side { padding-top: 20px; }
  .tagline { font-size: clamp(24px, 3vw, 32px); line-height: 1.2; color: var(--text-head); }
  .tagline em { font-style: normal; color: var(--state-waiting); }
  .hero-side p + p { color: var(--text-dim); margin-top: 16px; max-width: 38ch; }

  .hero-install { position: relative; margin-top: 88px; }
  .mascot { position: absolute; left: 0; top: -58px; display: flex; align-items: center; gap: 12px; }
  .mascot-stage { position: relative; width: var(--nyan-width); height: var(--nyan-height); }
  .mascot-stage :global(.nyan-sprite) { animation: none; }
  .mascot-stage :global(.nyan-sprite::after) { display: none; }
  .bubble { position: relative; background: var(--text-head); color: var(--bg); border-radius: var(--radius); padding: 6px 10px; font-size: var(--type-body); white-space: nowrap; }
  .bubble::before { content: ""; position: absolute; left: -5px; top: 50%; translate: 0 -50%; width: 10px; height: 10px; background: inherit; rotate: 45deg; }
  .install-row { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; }
  .install-line { flex: 1 1 480px; display: flex; align-items: center; gap: 12px; min-width: 0; max-width: 820px; height: 44px; padding: 0 4px 0 16px; border-radius: var(--radius); background: var(--bg-surface); border: 1px solid var(--border); }
  .install-line code { font-family: var(--font-mono); display: flex; align-items: center; gap: 10px; min-width: 0; font-size: var(--type-body); white-space: nowrap; cursor: copy; }
  .install-line code::before { content: "$"; color: var(--accent-dim); }
  .install-line [data-install-for] { display: block; min-width: 0; overflow: hidden; text-overflow: ellipsis; }
  .install-line [data-install-for][hidden] { display: none; }
  .copy-install { margin-left: auto; height: 34px; padding: 0 14px; flex: none; border: 1px solid var(--accent); border-radius: var(--radius); background: var(--accent); color: var(--bg); font: inherit; font-weight: 700; font-size: var(--type-meta); text-transform: uppercase; letter-spacing: .08em; cursor: pointer; }
  .copy-install:hover { background: color-mix(in oklab, var(--accent) 85%, var(--text-head)); }
  .copy-status { display: block; margin-top: 10px; min-height: 21px; }
  .install-note { color: var(--text-dim); font-size: var(--type-body); }

  .spectrum { display: grid; grid-template-columns: repeat(6, 1fr); list-style: none; margin: 0; padding: 0; background: var(--bg-header); border-bottom: 1px solid var(--border-dim); }
  .spectrum li { display: flex; align-items: center; gap: 8px; padding: 14px 16px; font-family: var(--font-mono); font-size: var(--type-meta); font-weight: 700; text-transform: uppercase; letter-spacing: .08em; border-top: 2px solid currentColor; }
  .spectrum li + li { border-left: 1px solid var(--border-dim); }

  @media (max-width: 820px) {
    .next-nav ul li:not(:last-child) { display: none; }
    .hero-grid { grid-template-columns: 1fr; gap: 16px; }
    .spectrum { grid-template-columns: repeat(3, 1fr); }
    .spectrum li:nth-child(4) { border-left: 0; }
  }
</style>

<script>
  import { wireInstallPicker } from '../../lib/install-picker.ts';

  const heroInstall = document.getElementById('hero-install');
  if (heroInstall) wireInstallPicker(heroInstall);
</script>
