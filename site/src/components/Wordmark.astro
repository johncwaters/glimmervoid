---
interface Props {
  isStacked?: boolean;
}

const { isStacked = false } = Astro.props;
---
<span class:list={['wordmark', { 'is-stacked': isStacked }]}><span>Glimmer</span><span class="void">void</span></span>

<style>
  .wordmark { font-family: var(--font-mono); font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: var(--text-head); }
  .void { color: transparent; -webkit-text-stroke: max(1px, 0.02em) var(--text-head); }
  .wordmark.is-stacked { display: block; line-height: 0.9; }
  .is-stacked > span { display: block; width: fit-content; }
  .is-stacked .void { position: relative; }
  .is-stacked .void::after { content: ""; position: absolute; left: calc(100% + 0.15em); top: 36%; width: 0.24em; height: 0.24em; rotate: 45deg; background: var(--accent); }
</style>
