---
const FEATURES = [
  { name: 'Cmd+J', line: 'Next session that needs you' },
  { name: 'Notifications', line: 'Browser or Telegram' },
  { name: 'Plan review', line: 'Approve plans anywhere' },
  { name: 'Auto-resume', line: 'Survives restarts mid-turn' },
  { name: 'Streamer mode', line: 'Hides secrets on stream' },
  { name: 'Conversation view', line: 'Read a session like a chat', isExperimental: true },
];
---
<section id="features">
  <div class="section-head reveal">
    <h2>Also in the box.</h2>
  </div>
  <ul class="feature-chips reveal">
    {FEATURES.map(({ name, line, isExperimental }) => (
      <li>
        <span class="feature-name">{name}{isExperimental && <span class="experimental-tag">Experimental</span>}</span>
        <span class="feature-line">{line}</span>
      </li>
    ))}
  </ul>
</section>

<style>
  .feature-chips { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px; }
  .feature-chips li { display: flex; flex-direction: column; gap: 2px; border: 1px solid var(--border); border-radius: 6px; background: var(--bg-card); padding: 12px 14px; min-width: 0; }
  .feature-name { color: var(--text-head); font-weight: 700; font-size: 15px; }
  .feature-line { color: var(--text-dim); font-size: 13px; }
  .feature-chips .experimental-tag { margin-left: 8px; font-size: 11px; }
  @media (max-width: 820px) {
    .feature-chips { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
</style>
