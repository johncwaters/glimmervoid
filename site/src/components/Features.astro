---
const USAGE_SHARES_BY_SESSION = [0.92, 0.64, 0.41, 0.23];
const TRACE_STEP_LENGTHS = [0.7, 0.45, 0.85, 0.55, 0.3, 0.65];
const HELPER_SESSION_COUNT = 3;
const RADAR_BLIPS = [
  { angleDeg: 48, distance: 0.62 },
  { angleDeg: 140, distance: 0.34 },
  { angleDeg: 228, distance: 0.74 },
  { angleDeg: 312, distance: 0.48 },
];
const FEATURES = [
  { area: 'notify', name: 'Notifications', line: 'Browser or Telegram', visual: 'toast' },
  { area: 'vault', name: 'Vault', line: 'You approve every secret an agent reads', visual: 'secret' },
  { area: 'spawn', name: 'glimmervoid spawn', line: 'Agents start their own helpers', visual: 'helpers' },
  { area: 'radar', name: 'Radar', line: 'PostHog errors to PRs, opt-in', visual: 'radar' },
  { area: 'upload', name: 'File upload', line: 'Paste or drop files into a session', visual: 'file' },
  { area: 'resume', name: 'Auto-resume', line: 'Survives restarts mid-turn', visual: 'resume' },
  { area: 'accounts', name: 'Switch account', line: 'Move a running session to another account', visual: 'accounts' },
  { area: 'worktrees', name: 'Worktrees', line: 'One worktree each. One-click merge.', visual: 'branch' },
];
---
<section id="features">
  <div class="section-head reveal">
    <h2>Also in the box.</h2>
  </div>
  <ul class="bento reveal" id="features-bento">
    <li class="tile is-feature" style="grid-area: usage">
      <span class="feature-name">Usage</span>
      <span class="feature-line">What each session costs</span>
      <span class="tile-visual usage-bars" aria-hidden="true">
        {USAGE_SHARES_BY_SESSION.map((share) => <span class="usage-bar" style={`--share: ${share}`}></span>)}
      </span>
    </li>
    <li class="tile is-feature" style="grid-area: trace">
      <span class="feature-name">Trace</span>
      <span class="feature-line">Every tool call, in order</span>
      <span class="tile-visual trace-steps" aria-hidden="true">
        {TRACE_STEP_LENGTHS.map((length) => <span class="trace-step" style={`--length: ${length}`}></span>)}
      </span>
    </li>
    {FEATURES.map(({ area, name, line, visual }) => (
      <li class="tile" style={`grid-area: ${area}`}>
        <span class="feature-name">{name}</span>
        <span class="feature-line">{line}</span>
        {visual === 'toast' && (
          <span class="tile-visual notify-toast" aria-hidden="true"><span class="toast-dot"></span><span class="toast-text">billing needs you</span></span>
        )}
        {visual === 'secret' && (
          <span class="tile-visual vault-secret" aria-hidden="true"><code>STRIPE_KEY</code><span class="vault-grant">approved</span></span>
        )}
        {visual === 'file' && (
          <span class="tile-visual upload-drop" aria-hidden="true"><span class="upload-file">screenshot.png</span></span>
        )}
        {visual === 'accounts' && (
          <span class="tile-visual account-switch" aria-hidden="true"><span class="account-pill is-personal">Personal</span><span class="account-pill is-team">Team</span></span>
        )}
        {visual === 'helpers' && (
          <span class="tile-visual helper-sessions" aria-hidden="true">
            <span class="helper-dot is-parent"></span>
            {Array.from({ length: HELPER_SESSION_COUNT }, () => <span class="helper-dot"></span>)}
          </span>
        )}
        {visual === 'radar' && (
          <span class="tile-visual radar-scope" aria-hidden="true">
            <span class="radar-sweep"></span>
            {RADAR_BLIPS.map(({ angleDeg, distance }) => (
              <span class="radar-arm" style={`--turn: ${angleDeg / 360}; --distance: ${distance}`}><span class="radar-blip"></span></span>
            ))}
          </span>
        )}
        {visual === 'resume' && (
          <span class="tile-visual turn-resume" aria-hidden="true"><span class="turn-fill"></span><span class="turn-restart"></span></span>
        )}
        {visual === 'branch' && (
          <svg class="tile-visual branch-merge" viewBox="0 0 360 44" aria-hidden="true">
            <path class="branch-main" d="M4 34 H356" />
            <path class="branch-fork" pathLength="1" d="M60 34 C 102 34, 102 10, 144 10 H216 C 258 10, 258 34, 300 34" />
            <circle class="branch-commit" cx="180" cy="10" r="3.5" />
            <circle class="branch-merge-dot" cx="300" cy="34" r="4.5" />
          </svg>
        )}
      </li>
    ))}
  </ul>
</section>

<style>
  .bento {
    list-style: none; margin: 0; padding: 0; display: grid; gap: 10px;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    grid-template-areas:
      "usage usage trace trace"
      "notify vault spawn radar"
      "upload resume accounts worktrees";
  }
  .tile { display: flex; flex-direction: column; gap: 4px; min-width: 0; overflow: hidden; border: 1px solid var(--border); border-radius: var(--radius-lg); background: var(--bg-card); padding: 16px 18px; }
  .feature-name { color: var(--text-head); font-weight: 700; font-size: var(--type-body); }
  .is-feature .feature-name { font-size: var(--type-doc-h2); }
  .feature-line { color: var(--text-dim); font-size: var(--type-meta); }
  .tile-visual { margin-top: auto; padding-top: 18px; }
  .usage-bars { padding-top: 24px; display: flex; flex-direction: column; gap: 10px; }
  .usage-bar { display: block; height: 14px; width: calc(var(--share) * 100%); border-radius: 999px; background: var(--accent); opacity: calc(0.35 + var(--share) * 0.65); }
  .trace-steps { padding-top: 24px; display: flex; flex-direction: column; gap: 12px; border-left: 1px solid var(--border); margin-left: 4px; padding-left: 14px; }
  .trace-step { position: relative; display: block; height: 8px; width: calc(var(--length) * 100%); border-radius: 4px; background: var(--border); }
  .trace-step::before { content: ''; position: absolute; left: -19px; top: 0; width: 8px; height: 8px; border-radius: 50%; background: var(--state-complete); }
  .notify-toast { display: flex; align-items: center; gap: 8px; margin-top: auto; padding: 8px 10px; border: 1px solid var(--border); border-radius: 6px; background: var(--bg-surface); color: var(--text-head); font-size: var(--type-meta); }
  .toast-text { min-width: 0; }
  .toast-dot { flex: none; width: 8px; height: 8px; border-radius: 50%; background: var(--state-waiting); }
  .vault-secret { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; font-size: var(--type-meta); }
  .vault-secret code { padding: 3px 8px; border-radius: 4px; background: var(--bg-surface); color: var(--text-head); }
  .vault-grant { color: var(--state-complete); font-weight: 700; }
  .upload-drop { display: flex; justify-content: center; padding: 14px 10px; margin-top: 18px; border: 1px dashed var(--border-hover); border-radius: 6px; }
  .upload-file { padding: 3px 8px; border-radius: 4px; background: color-mix(in oklab, var(--accent) 14%, var(--bg-surface)); color: var(--accent); font-size: var(--type-meta); }
  .helper-sessions { display: flex; align-items: center; gap: 10px; }
  .helper-dot { display: block; width: 12px; height: 12px; border-radius: 50%; background: var(--state-running); opacity: 0.55; }
  .helper-dot.is-parent { width: 16px; height: 16px; opacity: 1; margin-right: 14px; box-shadow: 18px 0 0 -7px var(--border); }
  .radar-scope {
    --sweep-ms: 4000ms;
    position: relative; display: block; align-self: center; width: min(100%, 136px); aspect-ratio: 1; margin-top: auto; padding: 0; border-radius: 50%;
    border: 1px solid var(--accent-dim); overflow: hidden;
    background:
      radial-gradient(circle, var(--accent) 0 2px, transparent 2.5px),
      radial-gradient(circle, transparent 0 32%, var(--border) 32% calc(32% + 1px), transparent calc(32% + 1px) 65%, var(--border) 65% calc(65% + 1px), transparent calc(65% + 1px)),
      linear-gradient(var(--border), var(--border)) center / 1px 100% no-repeat,
      linear-gradient(var(--border), var(--border)) center / 100% 1px no-repeat,
      var(--bg);
  }
  .radar-sweep { position: absolute; inset: 0; border-radius: 50%; background: conic-gradient(transparent 0 270deg, color-mix(in oklab, var(--accent) 45%, transparent) 356deg, var(--accent) 359deg 360deg); animation: radar-spin var(--sweep-ms) linear infinite; }
  .radar-arm { position: absolute; inset: 0; rotate: calc(var(--turn) * 1turn); }
  .radar-blip { position: absolute; left: calc(50% - 3.5px); top: calc(50% - var(--distance) * 50% - 3.5px); width: 7px; height: 7px; border-radius: 50%; background: var(--state-failed); opacity: 0.15; animation: radar-ping var(--sweep-ms) linear infinite; animation-delay: calc((var(--turn) - 1) * var(--sweep-ms)); }
  @keyframes radar-spin { to { rotate: 360deg; } }
  @keyframes radar-ping {
    0% { opacity: 1; scale: 1.5; }
    12% { opacity: 1; scale: 1; }
    100% { opacity: 0.15; scale: 1; }
  }
  .branch-merge { display: block; width: 100%; height: auto; overflow: visible; }
  .branch-main { fill: none; stroke: var(--border-hover); stroke-width: 2; }
  .branch-fork { fill: none; stroke: var(--accent); stroke-width: 2; stroke-dasharray: 1; }
  .branch-commit { fill: var(--accent); }
  .branch-merge-dot { fill: var(--state-complete); }
  .turn-resume { position: relative; display: block; height: 8px; border-radius: 4px; background: var(--border); }
  .turn-fill { position: absolute; inset: 0 auto 0 0; width: 100%; border-radius: 4px; background: var(--state-running); }
  .turn-restart { position: absolute; top: 50%; left: 55%; width: 14px; height: 14px; translate: -50% -50%; border: 2px solid var(--bg-card); border-radius: 50%; background: var(--state-waiting); }
  .bento[data-on-screen="true"] .turn-fill { animation: resume-turn 5s var(--ease-out-expo) infinite; }
  .bento[data-on-screen="true"] .branch-fork { animation: fork-and-merge 5s var(--ease-out-expo) infinite; }
  .bento[data-on-screen="true"] .branch-commit { animation: land-commit 5s var(--ease-out-expo) infinite; }
  .bento[data-on-screen="true"] .branch-merge-dot { animation: show-merge 5s var(--ease-out-expo) infinite; }
  .account-switch { display: flex; gap: 4px; }
  .account-pill { padding: 3px 10px; border: 1px solid var(--border); border-radius: 999px; color: var(--text-dim); font-size: var(--type-meta); }
  .bento[data-on-screen="true"] .account-pill.is-personal { animation: account-active 6s steps(1) infinite; }
  .bento[data-on-screen="true"] .account-pill.is-team { animation: account-active 6s steps(1) -3s infinite; }
  @keyframes account-active { 0% { border-color: var(--accent); color: var(--text-head); } 50% { border-color: var(--border); color: var(--text-dim); } }
  @keyframes resume-turn { 0% { width: 0%; } 30%, 50% { width: 55%; } 80%, 100% { width: 100%; } }
  @keyframes fork-and-merge { 0%, 8% { stroke-dashoffset: 1; } 60%, 100% { stroke-dashoffset: 0; } }
  @keyframes land-commit { 0%, 30% { opacity: 0; } 38%, 100% { opacity: 1; } }
  @keyframes show-merge { 0%, 60% { opacity: 0; scale: 0.4; } 70%, 100% { opacity: 1; scale: 1; } }
  .branch-merge-dot { transform-box: fill-box; transform-origin: center; }
  @media (max-width: 820px) {
    .bento {
      gap: 8px;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-template-areas:
        "usage usage"
        "trace trace"
        "notify vault"
        "spawn radar"
        "upload resume"
        "accounts accounts"
        "worktrees worktrees";
    }
    .tile { padding: 12px 14px; border-radius: var(--radius-lg); }
    .tile:not(.is-feature) .feature-line { display: none; }
    .radar-scope { width: min(100%, 96px); }
    .tile-visual { padding-top: 12px; }
    .trace-steps { gap: 8px; }
    .trace-step:nth-child(n + 4) { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .radar-sweep, .radar-blip { animation: none; }
    .bento[data-on-screen="true"] :is(.account-pill, .turn-fill, .branch-fork, .branch-commit, .branch-merge-dot) { animation: none; }
    .radar-blip { opacity: 1; }
  }
</style>

<script>
  import { markWhileOnScreen } from '../lib/dom.ts';

  const bento = document.getElementById('features-bento');
  if (bento) markWhileOnScreen(bento);
</script>
