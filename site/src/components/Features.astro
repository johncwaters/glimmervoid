---
const USAGE_SHARES_BY_SESSION = [0.92, 0.64, 0.41, 0.23];
const TRACE_STEP_LENGTHS = [0.7, 0.45, 0.85, 0.55, 0.3, 0.65];
const HELPER_SESSION_COUNT = 3;
const RADAR_STEPS = [
  { tone: 'danger', length: 0.8 },
  { tone: 'wait', length: 0.55 },
  { tone: 'ok', length: 0.7 },
];
const FEATURES = [
  { area: 'notify', name: 'Notifications', line: 'Browser or Telegram' },
  { area: 'plan', name: 'Plan review', line: 'Approve plans anywhere' },
  { area: 'issues', name: 'Issues', line: 'Open a session from an issue' },
  { area: 'spawn', name: 'glimmervoid spawn', line: 'Agents start their own helpers', visual: 'helpers' },
  { area: 'radar', name: 'Radar', line: 'PostHog errors to PRs, opt-in', visual: 'radar' },
  { area: 'streamer', name: 'Streamer mode', line: 'Hides secrets on stream', visual: 'masked' },
  { area: 'upload', name: 'File upload', line: 'Paste or drop files into a session' },
  { area: 'resume', name: 'Auto-resume', line: 'Survives restarts mid-turn' },
  { area: 'chat', name: 'Conversation view', line: 'Read a session like a chat', isExperimental: true },
  { area: 'coder', name: 'Coder workspaces', line: 'Run agents in Coder', isExperimental: true },
];
---
<section id="features">
  <div class="section-head reveal">
    <h2>Also in the box.</h2>
  </div>
  <ul class="bento reveal">
    <li class="tile is-feature" style="grid-area: usage">
      <span class="feature-name">Usage</span>
      <span class="feature-line">What each session costs</span>
      <span class="tile-visual usage-bars" aria-hidden="true">
        {USAGE_SHARES_BY_SESSION.map((share) => <span class="usage-bar" style={`--share: ${share}`}></span>)}
      </span>
    </li>
    <li class="tile is-feature" style="grid-area: trace">
      <span class="feature-name">Trace</span>
      <span class="feature-line">Every tool call, in order</span>
      <span class="tile-visual trace-steps" aria-hidden="true">
        {TRACE_STEP_LENGTHS.map((length) => <span class="trace-step" style={`--length: ${length}`}></span>)}
      </span>
    </li>
    {FEATURES.map(({ area, name, line, visual, isExperimental }) => (
      <li class="tile" style={`grid-area: ${area}`}>
        <span class="feature-name">{name}</span>
        <span class="feature-line">{line}</span>
        {visual === 'helpers' && (
          <span class="tile-visual helper-sessions" aria-hidden="true">
            <span class="helper-dot is-parent"></span>
            {Array.from({ length: HELPER_SESSION_COUNT }, () => <span class="helper-dot"></span>)}
          </span>
        )}
        {visual === 'radar' && (
          <span class="tile-visual radar-steps" aria-hidden="true">
            {RADAR_STEPS.map(({ tone, length }) => <span class={`radar-step tone-${tone}`} style={`--length: ${length}`}></span>)}
          </span>
        )}
        {visual === 'masked' && <span class="tile-visual masked-secret" aria-hidden="true">API_KEY=<span class="mask"></span></span>}
        {isExperimental && <span class="experimental-tag">Experimental</span>}
      </li>
    ))}
  </ul>
</section>

<style>
  .bento {
    list-style: none; margin: 0; padding: 0; display: grid; gap: 10px;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    grid-template-areas:
      "usage usage trace notify"
      "usage usage trace plan"
      "issues spawn spawn radar"
      "streamer streamer upload radar"
      "resume chat coder coder";
  }
  .tile { display: flex; flex-direction: column; gap: 4px; min-width: 0; overflow: hidden; border: 1px solid var(--border); border-radius: 14px; background: var(--bg-card); padding: 16px 18px; }
  .feature-name { color: var(--text-head); font-weight: 700; font-size: 15px; }
  .is-feature .feature-name { font-size: 22px; }
  .feature-line { color: var(--text-dim); font-size: 13px; }
  .tile .experimental-tag { align-self: flex-start; margin: auto 0 0; padding: 0 6px; font-size: 10px; font-weight: 700; line-height: 18px; border: 1px solid var(--border); border-radius: 4px; }
  .tile .feature-line + .experimental-tag { margin-top: auto; }
  .tile:has(.experimental-tag) .feature-line { margin-bottom: 10px; }
  .tile-visual { margin-top: auto; padding-top: 18px; }
  .usage-bars { padding-top: 24px; display: flex; flex-direction: column; gap: 10px; }
  .usage-bar { display: block; height: 14px; width: calc(var(--share) * 100%); border-radius: 7px; background: linear-gradient(90deg, var(--accent), color-mix(in oklab, var(--accent) 35%, transparent)); }
  .trace-steps { padding-top: 24px; display: flex; flex-direction: column; gap: 12px; border-left: 1px solid var(--border); margin-left: 4px; padding-left: 14px; }
  .trace-step { position: relative; display: block; height: 8px; width: calc(var(--length) * 100%); border-radius: 4px; background: var(--border); }
  .trace-step::before { content: ''; position: absolute; left: -19px; top: 0; width: 8px; height: 8px; border-radius: 50%; background: var(--state-complete); }
  .helper-sessions { display: flex; align-items: center; gap: 10px; }
  .helper-dot { display: block; width: 12px; height: 12px; border-radius: 50%; background: var(--state-running); opacity: 0.55; }
  .helper-dot.is-parent { width: 16px; height: 16px; opacity: 1; margin-right: 14px; box-shadow: 18px 0 0 -7px var(--border); }
  .radar-steps { display: flex; flex-direction: column; gap: 12px; }
  .radar-step { position: relative; display: block; height: 8px; margin-left: 18px; width: calc(var(--length) * (100% - 18px)); border-radius: 4px; background: var(--border); }
  .radar-step::before { content: ''; position: absolute; left: -18px; top: 0; width: 8px; height: 8px; border-radius: 50%; background: currentColor; }
  .tone-danger { color: var(--state-failed); }
  .tone-wait { color: var(--state-running); }
  .tone-ok { color: var(--state-complete); }
  .masked-secret { display: flex; align-items: center; gap: 6px; font-family: var(--font-mono); font-size: 13px; color: var(--text-dim); }
  .mask { display: block; flex: 1; max-width: 160px; height: 14px; border-radius: 3px; background: repeating-linear-gradient(90deg, var(--text-dim) 0 6px, transparent 6px 10px); opacity: 0.5; }
  @media (max-width: 820px) {
    .bento {
      gap: 8px;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-template-areas:
        "usage usage"
        "trace trace"
        "notify plan"
        "spawn spawn"
        "issues radar"
        "streamer streamer"
        "upload resume"
        "chat coder";
    }
    .tile { padding: 12px 14px; border-radius: 12px; }
    .tile:not(.is-feature) .feature-line { display: none; }
    .radar-steps { display: none; }
    .tile-visual { padding-top: 12px; }
    .trace-steps { gap: 8px; }
    .trace-step:nth-child(n + 4) { display: none; }
  }
</style>
