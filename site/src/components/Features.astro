---
const USAGE_SHARES_BY_SESSION = [0.92, 0.64, 0.41, 0.23];
const TRACE_STEP_LENGTHS = [0.7, 0.45, 0.85, 0.55, 0.3, 0.65];
const SMALL_FEATURES = [
  { name: 'Notifications', line: 'Browser or Telegram' },
  { name: 'Plan review', line: 'Approve plans anywhere' },
  { name: 'Issues', line: 'Open a session from an issue' },
  { name: 'File upload', line: 'Paste or drop files into a session' },
  { name: 'Radar', line: 'PostHog errors to PRs, opt-in' },
  { name: 'glimmervoid spawn', line: 'Agents start their own helpers' },
  { name: 'Auto-resume', line: 'Survives restarts mid-turn' },
  { name: 'Streamer mode', line: 'Hides secrets on stream' },
  { name: 'Conversation view', line: 'Read a session like a chat', isExperimental: true },
  { name: 'Coder workspaces', line: 'Run agents in Coder', isExperimental: true },
];
---
<section id="features">
  <div class="section-head reveal">
    <h2>Also in the box.</h2>
  </div>
  <ul class="bento reveal">
    <li class="tile tile-usage">
      <span class="feature-name">Usage</span>
      <span class="feature-line">What each session costs</span>
      <span class="usage-bars" aria-hidden="true">
        {USAGE_SHARES_BY_SESSION.map((share) => <span class="usage-bar" style={`--share: ${share}`}></span>)}
      </span>
    </li>
    <li class="tile tile-trace">
      <span class="feature-name">Trace</span>
      <span class="feature-line">Every tool call, in order</span>
      <span class="trace-steps" aria-hidden="true">
        {TRACE_STEP_LENGTHS.map((length) => <span class="trace-step" style={`--length: ${length}`}></span>)}
      </span>
    </li>
    {SMALL_FEATURES.map(({ name, line, isExperimental }) => (
      <li class="tile">
        <span class="feature-name">{name}</span>
        <span class="feature-line">{line}</span>
        {isExperimental && <span class="experimental-tag">Experimental</span>}
      </li>
    ))}
  </ul>
</section>

<style>
  .bento { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); grid-auto-flow: dense; gap: 10px; }
  .tile { position: relative; display: flex; flex-direction: column; gap: 4px; min-width: 0; overflow: hidden; border: 1px solid var(--border); border-radius: 14px; background: var(--bg-card); padding: 16px 18px; }
  .tile-usage { grid-column: span 2; grid-row: span 2; }
  .tile-trace { grid-row: span 2; }
  .feature-name { color: var(--text-head); font-weight: 700; font-size: 15px; }
  .tile-usage .feature-name, .tile-trace .feature-name { font-size: 22px; }
  .feature-line { color: var(--text-dim); font-size: 13px; }
  .tile .experimental-tag { margin-top: auto; padding-top: 8px; font-size: 11px; }
  .usage-bars { margin-top: auto; padding-top: 24px; display: flex; flex-direction: column; gap: 10px; }
  .usage-bar { display: block; height: 14px; width: calc(var(--share) * 100%); border-radius: 7px; background: linear-gradient(90deg, var(--accent), color-mix(in oklab, var(--accent) 35%, transparent)); }
  .trace-steps { margin-top: auto; padding-top: 24px; display: flex; flex-direction: column; gap: 12px; border-left: 1px solid var(--border); margin-left: 4px; padding-left: 14px; }
  .trace-step { position: relative; display: block; height: 8px; width: calc(var(--length) * 100%); border-radius: 4px; background: var(--border); }
  .trace-step::before { content: ''; position: absolute; left: -19px; top: 0; width: 8px; height: 8px; border-radius: 50%; background: var(--state-complete); }
  @media (max-width: 820px) {
    .bento { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; }
    .tile { padding: 12px 14px; border-radius: 12px; }
    .tile-trace { grid-row: auto; grid-column: span 2; }
    .tile:not(.tile-usage, .tile-trace) .feature-line { display: none; }
    .usage-bars { padding-top: 16px; }
    .trace-steps { padding-top: 14px; gap: 8px; }
    .trace-step:nth-child(n + 4) { display: none; }
  }
</style>
