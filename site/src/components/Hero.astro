---
import { ANIMALS } from '../../../public/nyan-animals-core.ts';
import DashboardRecording from './DashboardRecording.astro';
import InstallCommand from './InstallCommand.astro';
import PhoneNextStep from './PhoneNextStep.astro';
import { LINUX_INSTALL_COMMAND } from '../lib/install-command.ts';

const skyAnimals = JSON.stringify(ANIMALS.map(({ sprite, trail }) => ({ sprite, trail })));
---
<section class="hero" id="top">
  <div class="sky" id="sky" aria-hidden="true" data-animals={skyAnimals}></div>
  <div class="hero-copy" id="hero-install">
    <h1>Mission control <em>that ships</em>.</h1>
    <p class="lede">Not a terminal multiplexer. Grids are for watching. <span class="unbroken">This is for working.</span></p>
    <div class="install-line">
      <code data-install-command title="Click to copy"><span data-install-for="default"><InstallCommand /></span><span data-install-for="linux" hidden><InstallCommand command={LINUX_INSTALL_COMMAND} /></span></code>
      <span class="install-actions">
        <button class="btn" type="button" data-copy-install>Copy</button>
        <span class="copy-status" data-copy-status role="status"></span>
      </span>
    </div>
    <a class="install-other-platforms" href="#install">Other platforms</a>
    <PhoneNextStep location="hero" />
  </div>
  <DashboardRecording />
</section>

<style>
  .hero { border-top: none; padding-block: 56px 96px; }
  .hero-copy { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 22px; position: relative; z-index: 2; }
  .unbroken { white-space: nowrap; }
  .lede { color: var(--text-dim); font-size: clamp(17px, 2vw, 19px); max-width: 54ch; }
  .install-other-platforms { font-size: 14px; color: var(--text-dim); }
  .install-other-platforms:hover { color: var(--text-head); }
  .install-line { display: flex; justify-content: center; align-items: center; gap: 10px; max-width: 100%; margin-top: 16px; }
  .install-line code {
    display: flex; align-items: center; gap: 10px; background: var(--bg-surface); border: 1px solid var(--border);
    border-radius: 4px; padding: 10px 14px; font-size: 14px; min-width: 0; max-width: 44ch; white-space: nowrap; cursor: copy;
  }
  .install-line code:hover { border-color: var(--accent-dim); }
  .install-line code::before { content: "$"; color: var(--accent-dim); }
  .install-line [data-install-for] { display: block; min-width: 0; overflow: hidden; text-overflow: ellipsis; }
  .install-line [data-install-for][hidden] { display: none; }
  .install-actions { position: relative; flex: none; display: inline-flex; }
  .install-actions .copy-status { position: absolute; left: calc(100% + 10px); top: 50%; translate: 0 -50%; white-space: nowrap; }
  @media (max-width: 640px) {
    .install-line code { flex: 1 1 auto; }
    .install-actions .copy-status { left: 50%; top: calc(100% + 6px); translate: -50% 0; }
  }
  .sky { position: absolute; inset-block: 0; inset-inline: calc(50% - 50vw); pointer-events: none; z-index: 1; overflow: hidden; }
  .sky:not([data-on-screen="true"]) :global(:is(.nyan-flight, .nyan-trail, .nyan-sprite)),
  .sky:not([data-on-screen="true"]) :global(.nyan-trail::before),
  .sky:not([data-on-screen="true"]) :global(.nyan-sprite::after) { animation-play-state: paused; }
  @media (prefers-reduced-motion: reduce) {
    .sky { display: none; }
  }
</style>

<script>
  import { launchAnimalFlight } from '../lib/animal-flight.ts';
  import type { FlyingAnimalLook } from '../lib/animal-flight.ts';
  import { markWhileOnScreen, prefersReducedMotion } from '../lib/dom.ts';
  import { wireInstallPicker } from '../lib/install-picker.ts';

  const FIRST_FLIGHT_DELAY_MS = 1500;
  const FLIGHT_INTERVAL_MS = 11000;

  function isSkyAnimal(candidate: unknown): candidate is FlyingAnimalLook {
    if (typeof candidate !== 'object' || candidate === null) return false;
    return 'sprite' in candidate && typeof candidate.sprite === 'string' && 'trail' in candidate && typeof candidate.trail === 'string';
  }

  function readSkyAnimals(sky: HTMLElement): FlyingAnimalLook[] {
    const parsed: unknown = JSON.parse(sky.dataset.animals ?? '[]');
    if (!Array.isArray(parsed)) return [];
    return parsed.filter(isSkyAnimal);
  }

  function startSky(): void {
    const sky = document.getElementById('sky');
    if (!sky || prefersReducedMotion()) return;
    markWhileOnScreen(sky);
    const skyAnimals = readSkyAnimals(sky);
    if (skyAnimals.length === 0) return;
    const flyAnimal = () => {
      if (document.hidden || sky.dataset.onScreen !== 'true' || sky.childElementCount > 0) return;
      launchAnimalFlight(sky, skyAnimals[Math.floor(Math.random() * skyAnimals.length)], 20 + Math.random() * 120);
    };
    setTimeout(flyAnimal, FIRST_FLIGHT_DELAY_MS);
    setInterval(flyAnimal, FLIGHT_INTERVAL_MS);
  }

  const heroInstall = document.getElementById('hero-install');
  if (heroInstall) wireInstallPicker(heroInstall);
  startSky();
</script>
