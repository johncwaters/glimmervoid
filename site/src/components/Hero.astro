---
import { ANIMALS } from '../../../public/nyan-animals.ts';
import DashboardRecording from './DashboardRecording.astro';
import InstallCommand from './InstallCommand.astro';
import { LINUX_INSTALL_COMMAND } from '../lib/install-command.ts';
import { INSTALL_PLATFORMS } from '../lib/install-platform.ts';

const PLATFORM_LABELS = { macos: 'macOS', windows: 'Windows', linux: 'Linux' } as const;

const skyAnimals = JSON.stringify(ANIMALS.map(({ sprite, trail }) => ({ sprite, trail })));
---
<section class="hero" id="top">
  <div class="sky" id="sky" aria-hidden="true" data-animals={skyAnimals}></div>
  <div class="hero-copy">
    <p class="eyebrow">Open source agent orchestrator</p>
    <h1>Mission control for your <em>coding agents</em>.</h1>
    <p class="lede">Run dozens of Claude Code, Codex and Grok sessions at once. Know which one needs you.</p>
    <div class="install-line">
      <code id="install-command"><span data-install-for="default"><InstallCommand /></span><span data-install-for="linux" hidden><InstallCommand command={LINUX_INSTALL_COMMAND} /></span></code>
      <button class="btn" type="button" id="copy-install">Copy</button>
      <span class="copy-status" id="copy-status" role="status"></span>
    </div>
    <div class="platform-switch" id="platform-switch" role="group" aria-label="Your operating system" hidden>
      {INSTALL_PLATFORMS.map((platform) => <button type="button" data-platform={platform} aria-pressed="false">{PLATFORM_LABELS[platform]}</button>)}
    </div>
    <p class="install-platform-note" id="install-platform-note">Windows and macOS. On Linux, use the <a href="#install">Linux command</a>.</p>
    <p class="install-platform-note" id="linux-build-note" hidden>Install build tools first: <code>sudo apt install build-essential python3</code></p>
    <div class="hero-meta"><span>Windows, macOS, Linux</span><span>MIT</span><span>Runs locally</span></div>
  </div>
  <DashboardRecording />
</section>

<style>
  .hero { border-top: none; padding-block: 36px 72px; }
  .hero-copy { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 18px; position: relative; z-index: 2; }
  .lede { font-size: 16px; max-width: 46ch; color: var(--text); }
  .install-platform-note { margin: 0; font-size: 13px; color: var(--text-dim); }
  .install-platform-note code { color: var(--text); }
  .platform-switch { display: inline-flex; border: 1px solid var(--border); border-radius: 4px; overflow: hidden; }
  .platform-switch[hidden] { display: none; }
  .platform-switch button { font: inherit; font-size: 12px; cursor: pointer; background: transparent; color: var(--text-dim); border: 0; padding: 6px 14px; }
  .platform-switch button + button { border-left: 1px solid var(--border); }
  .platform-switch button:hover { color: var(--text-head); }
  .platform-switch button[aria-pressed="true"] { background: color-mix(in srgb, var(--accent) 12%, transparent); color: var(--accent); }
  .platform-switch button:focus-visible { outline: 2px solid var(--accent); outline-offset: -2px; }
  .install-line { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; align-items: center; max-width: 100%; }
  .install-line code {
    display: flex; align-items: center; gap: 10px; background: var(--bg-surface); border: 1px solid var(--border);
    border-radius: 4px; padding: 10px 14px; font-size: 14px; max-width: 100%; overflow-x: auto; white-space: nowrap;
  }
  .install-line code::before { content: "$"; color: var(--accent-dim); }
  @media (max-width: 640px) {
    .install-line code { align-items: flex-start; white-space: pre-wrap; overflow-wrap: anywhere; text-align: left; font-size: 13px; line-height: 1.6; }
  }
  .btn { font: inherit; font-size: 13px; cursor: pointer; background: transparent; color: var(--accent); border: 1px solid var(--accent-dim); border-radius: 4px; padding: 9px 18px; }
  .btn:hover { background: color-mix(in srgb, var(--accent) 12%, transparent); }
  .copy-status { font-size: 12px; color: var(--text-dim); min-width: 6ch; text-align: left; }
  .hero-meta { font-size: 12px; color: var(--text-dim); display: flex; flex-wrap: wrap; justify-content: center; gap: 4px 18px; }
  .sky { position: absolute; inset-block: 0; inset-inline: calc(50% - 50vw); pointer-events: none; z-index: 1; overflow: hidden; }
  @media (prefers-reduced-motion: reduce) {
    .sky { display: none; }
  }
</style>

<script>
  import { deriveNyanGeometry, nyanFlightStyleProperties } from '../../../public/nyan-geometry-core.ts';
  import { createElement, prefersReducedMotion } from '../lib/dom.ts';
  import { detectInstallPlatform, INSTALL_PLATFORMS, installPlatformView } from '../lib/install-platform.ts';
  import type { InstallPlatform } from '../lib/install-platform.ts';

  interface SkyAnimal {
    sprite: string;
    trail: string;
  }

  const FIRST_FLIGHT_DELAY_MS = 1500;
  const FLIGHT_INTERVAL_MS = 11000;

  function isSkyAnimal(candidate: unknown): candidate is SkyAnimal {
    if (typeof candidate !== 'object' || candidate === null) return false;
    return 'sprite' in candidate && typeof candidate.sprite === 'string' && 'trail' in candidate && typeof candidate.trail === 'string';
  }

  function readSkyAnimals(sky: HTMLElement): SkyAnimal[] {
    const parsed: unknown = JSON.parse(sky.dataset.animals ?? '[]');
    if (!Array.isArray(parsed)) return [];
    return parsed.filter(isSkyAnimal);
  }

  function visibleInstallCommand(): HTMLElement | null {
    return document.querySelector<HTMLElement>('#install-command > [data-install-for]:not([hidden])');
  }

  function showInstallPlatform(platform: InstallPlatform): void {
    const view = installPlatformView(platform);
    for (const command of document.querySelectorAll<HTMLElement>('#install-command > [data-install-for]')) command.hidden = command.dataset.installFor !== view.visibleCommand;
    for (const button of document.querySelectorAll<HTMLButtonElement>('#platform-switch [data-platform]')) button.setAttribute('aria-pressed', String(button.dataset.platform === view.pressedPlatform));
    const linuxBuildNote = document.getElementById('linux-build-note');
    if (linuxBuildNote) linuxBuildNote.hidden = !view.isBuildNoteShown;
    const copyStatus = document.getElementById('copy-status');
    if (copyStatus) copyStatus.textContent = '';
  }

  function isInstallPlatform(value: string | undefined): value is InstallPlatform {
    return INSTALL_PLATFORMS.some((platform) => platform === value);
  }

  function userAgentDataPlatform(): string | null {
    const userAgentData: unknown = Reflect.get(navigator, 'userAgentData');
    if (typeof userAgentData !== 'object' || userAgentData === null) return null;
    const platform: unknown = Reflect.get(userAgentData, 'platform');
    return typeof platform === 'string' ? platform : null;
  }

  function wirePlatformSwitch(): void {
    const platformSwitch = document.getElementById('platform-switch');
    const platformNote = document.getElementById('install-platform-note');
    if (!platformSwitch || !platformNote) return;
    platformSwitch.hidden = false;
    platformNote.hidden = true;
    platformSwitch.addEventListener('click', (event) => {
      const button = event.target instanceof Element ? event.target.closest<HTMLButtonElement>('[data-platform]') : null;
      if (button && isInstallPlatform(button.dataset.platform)) showInstallPlatform(button.dataset.platform);
    });
    const detected = detectInstallPlatform({ userAgentDataPlatform: userAgentDataPlatform(), userAgent: navigator.userAgent });
    showInstallPlatform(detected ?? 'macos');
  }

  function wireCopyButton(): void {
    const copyButton = document.getElementById('copy-install');
    const copyStatus = document.getElementById('copy-status');
    if (!copyButton || !copyStatus) return;
    const selectCommand = () => {
      const installCommand = visibleInstallCommand();
      if (!installCommand) return;
      const range = document.createRange();
      range.selectNodeContents(installCommand);
      const selection = window.getSelection();
      selection?.removeAllRanges();
      selection?.addRange(range);
      copyStatus.textContent = 'Selected';
    };
    copyButton.addEventListener('click', () => {
      if (!navigator.clipboard) {
        selectCommand();
        return;
      }
      navigator.clipboard.writeText(visibleInstallCommand()?.textContent ?? '').then(() => {
        copyStatus.textContent = 'Copied';
      }, selectCommand);
    });
  }

  function startSky(): void {
    const sky = document.getElementById('sky');
    if (!sky || prefersReducedMotion()) return;
    const skyAnimals = readSkyAnimals(sky);
    if (skyAnimals.length === 0) return;
    const flyAnimal = () => {
      const { sprite, trail } = skyAnimals[Math.floor(Math.random() * skyAnimals.length)];
      const flight = createElement('div', 'nyan-flight');
      flight.append(createElement('div', `nyan-trail ${trail}`), createElement('div', `nyan-sprite ${sprite}`));
      const geometry = deriveNyanGeometry({ viewportWidthPx: sky.clientWidth, viewportHeightPx: sky.clientHeight, verticalProgress: 0 });
      const skyGeometry = { ...geometry, scale: 1, topPx: 20 + Math.random() * 120 };
      for (const [propertyName, value] of nyanFlightStyleProperties(skyGeometry, 1)) flight.style.setProperty(propertyName, value);
      flight.style.top = 'var(--nyan-top)';
      flight.style.left = '0';
      flight.style.width = 'var(--nyan-width)';
      flight.style.height = 'var(--nyan-height)';
      flight.style.animation = `nyan-fly ${7 + Math.random() * 4}s linear`;
      flight.addEventListener('animationend', (event) => {
        if (event.target === flight) flight.remove();
      });
      sky.append(flight);
    };
    setTimeout(flyAnimal, FIRST_FLIGHT_DELAY_MS);
    setInterval(flyAnimal, FLIGHT_INTERVAL_MS);
  }

  wirePlatformSwitch();
  wireCopyButton();
  startSky();
</script>
