---
const ACCENT_CHOICES = [
  { value: 'violet', label: 'Violet' },
  { value: 'green', label: 'Green' },
  { value: 'amber', label: 'Amber' },
];
const LAYOUT_CHOICES = [
  { value: 'list', label: 'List' },
  { value: 'cards', label: 'Cards' },
];
const SETTINGS_ROWS = [
  { name: 'Profile', detail: 'Name, avatar, email' },
  { name: 'Billing', detail: 'Plan and invoices' },
  { name: 'Alerts', detail: 'Email and push' },
  { name: 'Danger zone', detail: 'Delete account' },
];
const SERVICES = [
  { name: 'web', x: 8, y: 8 },
  { name: 'api', x: 104, y: 8 },
  { name: 'db', x: 56, y: 62 },
];
const WIRES = ['M48 22 L104 22', 'M124 36 L96 62', 'M28 36 L56 62'];
const PLAN_STEPS = ['planned', 'building', 'landed'];
---
<section id="boards">
  <div class="section-head reveal">
    <h2>Point, don't paragraph.</h2>
    <p>Today your agent describes the screen and you picture it. Here it puts the screen on a board beside its terminal. Turn a dial.</p>
  </div>
  <figure class="board-demo reveal" id="board-demo" aria-label="A whiteboard holding a settings page prototype an agent drew, framed on a phone, with the Save button circled in pen and a sticky note reading Save sits too low. Dials under the board change the prototype's accent, layout and density.">
    <div class="board-surface">
      <div class="phone-stage">
        <div class="phone-frame">
          <div class="prototype" id="board-prototype" data-accent="violet" data-layout="list" data-compact="false">
            <p class="prototype-title">Settings</p>
            <ul class="prototype-rows">
              {SETTINGS_ROWS.map(({ name, detail }) => (
                <li class="prototype-row"><span class="prototype-row-name">{name}</span><span class="prototype-row-detail">{detail}</span></li>
              ))}
            </ul>
            <span class="prototype-save">Save</span>
          </div>
          <svg class="pen-circle" viewBox="0 0 200 70" aria-hidden="true"><path class="pen-stroke" pathLength="1" d="M28 40 C 26 14, 172 8, 182 32 C 190 56, 40 66, 18 46 C 10 36, 40 20, 70 18" /></svg>
        </div>
        <p class="sticky-note" aria-hidden="true">Save sits too low.</p>
      </div>
    </div>
    <fieldset class="dials" id="board-dials">
      <legend class="dials-legend">Dials</legend>
      <label class="dial-pill"><span class="dial-name">Accent</span>
        <select name="accent">{ACCENT_CHOICES.map(({ value, label }) => <option value={value}>{label}</option>)}</select>
      </label>
      <label class="dial-pill"><span class="dial-name">Layout</span>
        <select name="layout">{LAYOUT_CHOICES.map(({ value, label }) => <option value={value}>{label}</option>)}</select>
      </label>
      <label class="dial-pill dial-toggle"><input type="checkbox" name="compact" /><span class="dial-name">Compact</span></label>
    </fieldset>
  </figure>
  <ul class="board-beats reveal" id="board-beats">
    <li class="beat">
      <div class="beat-scene scene-prototype" aria-hidden="true">
        <div class="mini-laptop">
          <div class="mini-screen"><span class="mini-bar"></span><span class="mini-line"></span><span class="mini-line is-short"></span></div>
          <div class="mini-base"></div>
        </div>
        <div class="mini-slider"><span class="mini-knob"></span></div>
      </div>
      <span class="board-beat-name">Prototypes</span>
      <span class="board-beat-line">A working screen framed on a phone or laptop, with dials for what the agent was unsure about.</span>
    </li>
    <li class="beat">
      <div class="beat-scene scene-architecture" aria-hidden="true">
        <svg class="arch-map" viewBox="0 0 152 92" aria-hidden="true">
          {WIRES.map((path, wireIndex) => <path class="arch-wire" pathLength="1" d={path} style={`--wire-index: ${wireIndex}`} />)}
          {SERVICES.map(({ name, x, y }) => (
            <g class="arch-service"><rect x={x} y={y} width="40" height="28" rx="5" /><text x={x + 20} y={y + 18}>{name}</text></g>
          ))}
        </svg>
        <div class="plan-strip">
          {PLAN_STEPS.map((step, stepIndex) => <span class="plan-step" style={`--step-index: ${stepIndex}`}>{step}</span>)}
        </div>
      </div>
      <span class="board-beat-name">Architecture</span>
      <span class="board-beat-line">Services and the wires between them, and the plan as steps marked building, then landed.</span>
    </li>
    <li class="beat">
      <div class="beat-scene scene-marks" aria-hidden="true">
        <span class="marks-slot"></span>
        <span class="marks-box">Header</span>
        <svg class="marks-pen" viewBox="0 0 120 60" aria-hidden="true"><path pathLength="1" d="M20 32 C 18 10, 100 6, 106 28 C 112 50, 24 56, 12 38 C 8 30, 30 16, 52 15" /></svg>
        <span class="marks-note">Bigger</span>
      </div>
      <span class="board-beat-name">Your marks</span>
      <span class="board-beat-line">Drag a box, circle with the pen, leave a sticky note or red-pen a doc. The agent sees each one on its next prompt.</span>
    </li>
  </ul>
</section>

<style>
  .board-demo { margin: 0; display: flex; flex-direction: column; gap: 14px; }
  .board-surface {
    position: relative; display: grid; place-items: center; min-height: 480px; padding: 36px 24px; overflow: hidden;
    border: 1px solid color-mix(in oklab, var(--accent) 35%, var(--border)); border-radius: 18px;
    background:
      radial-gradient(ellipse 60% 55% at 50% 45%, color-mix(in oklab, var(--accent) 22%, transparent), transparent 70%),
      radial-gradient(circle, color-mix(in oklab, var(--accent) 18%, var(--border-dim)) 1px, transparent 1.5px) 0 0 / 20px 20px,
      var(--bg-card);
    box-shadow: 0 30px 80px -30px color-mix(in oklab, var(--accent) 45%, transparent), inset 0 0 120px color-mix(in oklab, var(--bg) 70%, transparent);
  }
  .phone-stage { position: relative; perspective: 1200px; }
  .phone-frame {
    position: relative; width: 224px; height: 404px; padding: 12px; border: 2px solid color-mix(in oklab, var(--accent) 30%, var(--border-hover)); border-radius: 32px; background: var(--bg);
    transform: rotateY(-10deg) rotateX(4deg) rotateZ(-3deg);
    box-shadow: 24px 32px 50px -18px rgb(0 0 0 / 0.7), 0 0 40px -6px color-mix(in oklab, var(--accent) 35%, transparent);
  }
  .phone-frame::before { content: ''; position: absolute; top: 6px; left: 50%; translate: -50% 0; width: 54px; height: 6px; border-radius: 3px; background: var(--border); }
  .prototype {
    --prototype-accent: var(--accent); --row-padding: 10px;
    display: flex; flex-direction: column; gap: 10px; height: 100%; padding: 18px 10px 10px; border-radius: 22px; background: var(--bg-surface); font-size: 13px;
    transition: gap 240ms var(--ease-out-expo);
  }
  .prototype[data-accent="green"] { --prototype-accent: var(--state-running); }
  .prototype[data-accent="amber"] { --prototype-accent: var(--state-waiting); }
  .prototype[data-compact="true"] { --row-padding: 5px; gap: 6px; }
  .prototype-title { color: var(--prototype-accent); font-weight: 700; font-size: 16px; transition: color 240ms var(--ease-out-expo); }
  .prototype-rows { list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; }
  .prototype[data-layout="cards"] .prototype-rows { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .prototype-row { display: flex; flex-direction: column; min-width: 0; overflow-wrap: anywhere; padding: var(--row-padding) 10px; border: 1px solid var(--border-dim); border-left: 2px solid var(--prototype-accent); border-radius: 6px; background: var(--bg-card); transition: padding 240ms var(--ease-out-expo), border-color 240ms var(--ease-out-expo); }
  .prototype-row-name { color: var(--text-head); }
  .prototype-row-detail { color: var(--text-dim); font-size: 11px; }
  .prototype[data-compact="true"] .prototype-row-detail { display: none; }
  .prototype-save { margin-top: auto; padding: 8px; border-radius: 6px; text-align: center; font-weight: 700; color: var(--bg); background: var(--prototype-accent); box-shadow: 0 6px 18px -6px var(--prototype-accent); transition: background 240ms var(--ease-out-expo); }
  .pen-circle { position: absolute; left: -10px; bottom: -6px; width: calc(100% + 20px); height: auto; overflow: visible; pointer-events: none; }
  .pen-stroke { fill: none; stroke: var(--state-failed); stroke-width: 3; stroke-linecap: round; stroke-dasharray: 1; filter: drop-shadow(0 0 4px color-mix(in oklab, var(--state-failed) 60%, transparent)); }
  .board-demo[data-on-screen="true"] .pen-stroke { animation: draw-stroke 900ms var(--ease-out-expo) 300ms both; }
  .sticky-note {
    position: absolute; top: 46px; right: -96px; width: 128px; margin: 0; padding: 12px; rotate: 6deg; border-radius: 3px;
    background: var(--state-idle); color: var(--bg); font-size: 13px; font-weight: 700; line-height: 1.35;
    box-shadow: 6px 10px 20px -6px rgb(0 0 0 / 0.6);
  }
  .board-demo[data-on-screen="true"] .sticky-note { animation: drop-note 700ms var(--ease-out-expo) 900ms both; }
  .dials { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px; margin: 0; padding: 0; min-inline-size: 0; border: 0; }
  .dials-legend { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  .dial-pill {
    display: inline-flex; align-items: center; gap: 8px; min-height: 40px; padding: 0 6px 0 14px; border: 1px solid var(--border); border-radius: 999px;
    background: color-mix(in oklab, var(--bg-card) 85%, var(--accent)); color: var(--text-dim); font-size: 13px; cursor: pointer;
  }
  .dial-pill:focus-within { border-color: var(--accent); outline: 2px solid var(--accent); outline-offset: 2px; }
  .dial-pill select { font: inherit; color: var(--text-head); background: transparent; border: 0; padding: 6px 4px; cursor: pointer; }
  .dial-pill select:focus-visible, .dial-toggle input:focus-visible { outline: none; }
  .dial-toggle { padding: 0 14px; }
  .dial-toggle input { accent-color: var(--accent); width: 16px; height: 16px; margin: 0; }
  .board-beats { list-style: none; margin: 28px 0 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
  .beat { display: flex; flex-direction: column; gap: 6px; }
  .board-beat-name { color: var(--text-head); font-weight: 700; }
  .board-beat-line { color: var(--text-dim); font-size: 14px; }
  .beat-scene {
    position: relative; height: 156px; margin-bottom: 6px; overflow: hidden; border: 1px solid var(--border); border-radius: 12px;
    background: radial-gradient(circle, var(--border-dim) 1px, transparent 1.5px) 0 0 / 14px 14px, var(--bg-card);
  }
  .scene-prototype { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 14px; }
  .mini-laptop { display: flex; flex-direction: column; align-items: center; }
  .mini-screen { display: flex; flex-direction: column; gap: 5px; width: 104px; height: 60px; padding: 8px; border: 2px solid var(--border-hover); border-radius: 6px 6px 0 0; background: var(--bg-surface); }
  .mini-bar { height: 8px; width: 60%; border-radius: 2px; background: var(--state-waiting); }
  .mini-line { height: 5px; border-radius: 2px; background: var(--border); }
  .mini-line.is-short { width: 55%; }
  .mini-base { width: 124px; height: 6px; border-radius: 0 0 6px 6px; background: var(--border-hover); }
  .mini-slider { position: relative; width: 110px; height: 4px; border-radius: 2px; background: var(--border); }
  .mini-knob { position: absolute; top: 50%; left: 100%; width: 14px; height: 14px; translate: -50% -50%; border-radius: 50%; background: var(--text-head); box-shadow: 0 0 0 2px var(--accent); }
  .board-beats[data-on-screen="true"] .mini-knob { animation: sweep-knob 6s var(--ease-out-expo) infinite; }
  .board-beats[data-on-screen="true"] .mini-bar { animation: retheme-bar 6s steps(1) infinite; }
  .scene-architecture { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8px; }
  .arch-map { width: 140px; height: 85px; overflow: visible; }
  .arch-service rect { fill: var(--bg-surface); stroke: var(--border-hover); }
  .arch-service text { fill: var(--text-head); font-family: var(--font-mono); font-size: 10px; text-anchor: middle; }
  .arch-wire { fill: none; stroke: var(--accent); stroke-width: 1.5; stroke-dasharray: 1; }
  .board-beats[data-on-screen="true"] .arch-wire { animation: draw-wire 6s var(--ease-out-expo) infinite; animation-delay: calc(var(--wire-index) * 300ms); }
  .plan-strip { display: flex; gap: 6px; }
  .plan-step { padding: 1px 7px; border: 1px solid var(--state-complete); border-radius: 999px; font-size: 10px; color: var(--state-complete); background: var(--state-complete-bg); }
  .board-beats[data-on-screen="true"] .plan-step { animation: land-step 6s steps(1) infinite; animation-delay: calc(var(--step-index) * 600ms); }
  .marks-slot { position: absolute; top: 46px; left: 50%; width: 84px; height: 30px; translate: -50% 0; border: 1px dashed var(--border-hover); border-radius: 6px; }
  .marks-box { position: absolute; top: 46px; left: 50%; display: grid; place-items: center; width: 84px; height: 30px; translate: -50% 0; border: 1px solid var(--accent); border-radius: 6px; background: var(--bg-surface); color: var(--text-head); font-size: 11px; }
  .marks-pen { position: absolute; top: 32px; left: 50%; width: 120px; height: 60px; translate: -50% 0; overflow: visible; }
  .marks-pen path { fill: none; stroke: var(--state-failed); stroke-width: 2.5; stroke-linecap: round; stroke-dasharray: 1; }
  .marks-note { position: absolute; top: 14px; right: 18%; padding: 4px 8px; rotate: 6deg; border-radius: 2px; background: var(--state-idle); color: var(--bg); font-size: 10px; font-weight: 700; }
  .board-beats[data-on-screen="true"] .marks-box { animation: drag-box 6s var(--ease-out-expo) infinite; }
  .board-beats[data-on-screen="true"] .marks-pen path { animation: circle-box 6s var(--ease-out-expo) infinite; }
  .board-beats[data-on-screen="true"] .marks-note { animation: drop-mark-note 6s var(--ease-out-expo) infinite; }
  @keyframes draw-stroke { from { stroke-dashoffset: 1; } to { stroke-dashoffset: 0; } }
  @keyframes drop-note { from { opacity: 0; translate: 0 -24px; rotate: 14deg; } to { opacity: 1; translate: 0 0; rotate: 6deg; } }
  @keyframes sweep-knob { 0%, 8% { left: 0%; } 30%, 40% { left: 50%; } 62%, 100% { left: 100%; } }
  @keyframes retheme-bar { 0% { background: var(--accent); } 33% { background: var(--state-running); } 66% { background: var(--state-waiting); } }
  @keyframes draw-wire { 0%, 6% { stroke-dashoffset: 1; } 30%, 100% { stroke-dashoffset: 0; } }
  @keyframes land-step {
    0% { color: var(--text-dim); border-color: var(--border-hover); background: transparent; }
    40% { color: var(--state-waiting); border-color: var(--state-waiting); background: var(--state-waiting-bg); }
    70% { color: var(--state-complete); border-color: var(--state-complete); background: var(--state-complete-bg); }
  }
  @keyframes drag-box { 0%, 6% { translate: calc(-50% - 46px) 34px; rotate: -6deg; } 30%, 100% { translate: -50% 0; rotate: 0deg; } }
  @keyframes circle-box { 0%, 36% { stroke-dashoffset: 1; } 58%, 100% { stroke-dashoffset: 0; } }
  @keyframes drop-mark-note { 0%, 62% { opacity: 0; translate: 0 -16px; } 76%, 100% { opacity: 1; translate: 0 0; } }
  @media (max-width: 820px) {
    .board-surface { min-height: 0; padding: 28px 12px 40px; }
    .phone-stage { margin-right: 40px; }
    .sticky-note { right: -64px; top: 24px; width: 108px; padding: 10px; font-size: 12px; }
    .board-beats { grid-template-columns: minmax(0, 1fr); }
  }
  @media (prefers-reduced-motion: reduce) {
    .board-demo[data-on-screen="true"] :is(.pen-stroke, .sticky-note) { animation: none; }
    .board-beats[data-on-screen="true"] :is(.mini-knob, .mini-bar, .arch-wire, .plan-step, .marks-box, .marks-pen path, .marks-note) { animation: none; }
    .prototype, .prototype-title, .prototype-row, .prototype-save { transition: none; }
  }
</style>

<script>
  import { markWhileOnScreen } from '../lib/dom.ts';

  function applyDial(prototype: HTMLElement, control: HTMLInputElement | HTMLSelectElement): void {
    if (control instanceof HTMLInputElement) {
      prototype.dataset.compact = String(control.checked);
      return;
    }
    prototype.dataset[control.name] = control.value;
  }

  function wireBoardDemo(): void {
    const demo = document.getElementById('board-demo');
    const beats = document.getElementById('board-beats');
    const prototype = document.getElementById('board-prototype');
    const dials = document.getElementById('board-dials');
    if (!demo || !beats || !prototype || !dials) return;
    markWhileOnScreen(demo);
    markWhileOnScreen(beats);
    dials.addEventListener('change', (event) => {
      const control = event.target;
      if (!(control instanceof HTMLInputElement) && !(control instanceof HTMLSelectElement)) return;
      applyDial(prototype, control);
    });
  }

  wireBoardDemo();
</script>
