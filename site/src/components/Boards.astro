---
import { boardNoticeLineFor } from '../../../server/core/whiteboard-store-core.ts';

const DEMO_BOARD = { title: 'Settings page', id: '5f3c2a1e-8b7d-4c6a-9e2f-1d0b3a4c5e6f' };
const NOTICE_LINE = boardNoticeLineFor(DEMO_BOARD);
const ACCENT_CHOICES = [
  { value: 'violet', label: 'Violet' },
  { value: 'green', label: 'Green' },
  { value: 'amber', label: 'Amber' },
];
const LAYOUT_CHOICES = [
  { value: 'list', label: 'List' },
  { value: 'cards', label: 'Cards' },
];
const SETTINGS_ROWS = [
  { name: 'Profile', detail: 'Name, avatar, email' },
  { name: 'Billing', detail: 'Plan and invoices' },
  { name: 'Alerts', detail: 'Email and push' },
  { name: 'Danger zone', detail: 'Delete account' },
];
const BEATS = [
  { name: 'Prototypes', line: 'A working screen framed on a phone or laptop, with dials for what the agent was unsure about.' },
  { name: 'Architecture', line: 'Services and the wires between them, and the plan as steps marked building, then landed.' },
  { name: 'Your marks', line: 'Drag a box, circle with the pen, leave a sticky note or red-pen a doc. The agent sees each one on its next prompt.' },
];
---
<section id="boards">
  <div class="section-head reveal">
    <h2>Point, don't paragraph.</h2>
    <p>Today your agent describes the screen and you picture it. Here it puts the screen on a board beside its terminal. Turn a dial.</p>
  </div>
  <figure class="board-demo reveal" id="board-demo" aria-label="A whiteboard holding a settings page prototype an agent drew, framed on a phone, with the Save button circled in pen and a sticky note reading Save sits too low. A Dials panel beside it changes the prototype's accent, layout and density, and each change shows the line the agent reads on its next prompt.">
    <div class="board-surface">
      <div class="phone-frame">
        <div class="prototype" id="board-prototype" data-accent="violet" data-layout="list" data-compact="false">
          <p class="prototype-title">Settings</p>
          <ul class="prototype-rows">
            {SETTINGS_ROWS.map(({ name, detail }) => (
              <li class="prototype-row"><span class="prototype-row-name">{name}</span><span class="prototype-row-detail">{detail}</span></li>
            ))}
          </ul>
          <span class="prototype-save">Save</span>
        </div>
        <svg class="pen-circle" viewBox="0 0 200 70" aria-hidden="true"><path class="pen-stroke" pathLength="1" d="M28 40 C 26 14, 172 8, 182 32 C 190 56, 40 66, 18 46 C 10 36, 40 20, 70 18" /></svg>
      </div>
      <p class="sticky-note" aria-hidden="true">Save sits too low.</p>
    </div>
    <fieldset class="dials" id="board-dials">
      <legend>Dials</legend>
      <label class="dial">Accent
        <select name="accent">{ACCENT_CHOICES.map(({ value, label }) => <option value={value}>{label}</option>)}</select>
      </label>
      <label class="dial">Layout
        <select name="layout">{LAYOUT_CHOICES.map(({ value, label }) => <option value={value}>{label}</option>)}</select>
      </label>
      <label class="dial dial-toggle"><input type="checkbox" name="compact" /> Compact</label>
    </fieldset>
    <div class="agent-notice" id="board-notice" data-shown="false" aria-live="polite">
      <p class="agent-notice-label">The agent's next prompt</p>
      <pre class="agent-notice-line"><span class="agent-notice-prompt">&gt;</span> {NOTICE_LINE}</pre>
    </div>
  </figure>
  <ul class="board-beats reveal">
    {BEATS.map(({ name, line }) => <li><span class="board-beat-name">{name}</span><span class="board-beat-line">{line}</span></li>)}
  </ul>
</section>

<style>
  .board-demo {
    margin: 0; display: grid; gap: 16px; grid-template-columns: minmax(0, 1fr) 220px;
    grid-template-areas: "surface dials" "notice notice";
  }
  .board-surface {
    grid-area: surface; position: relative; display: flex; justify-content: center; align-items: center; gap: 28px; min-height: 460px; padding: 28px;
    border: 1px solid var(--border); border-radius: 6px;
    background: radial-gradient(circle, var(--border-dim) 1px, transparent 1.5px) 0 0 / 18px 18px, var(--bg-card);
  }
  .phone-frame { position: relative; width: 224px; height: 404px; padding: 12px; border: 2px solid var(--border-hover); border-radius: 30px; background: var(--bg); flex: none; }
  .phone-frame::before { content: ''; position: absolute; top: 6px; left: 50%; translate: -50% 0; width: 54px; height: 6px; border-radius: 3px; background: var(--border); }
  .prototype {
    --prototype-accent: var(--accent); --row-padding: 10px;
    display: flex; flex-direction: column; gap: 10px; height: 100%; padding: 18px 10px 10px; border-radius: 20px; background: var(--bg-surface); font-size: 13px;
    transition: gap 240ms var(--ease-out-expo);
  }
  .prototype[data-accent="green"] { --prototype-accent: var(--state-running); }
  .prototype[data-accent="amber"] { --prototype-accent: var(--state-waiting); }
  .prototype[data-compact="true"] { --row-padding: 5px; gap: 6px; }
  .prototype-title { color: var(--prototype-accent); font-weight: 700; font-size: 16px; transition: color 240ms var(--ease-out-expo); }
  .prototype-rows { list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; }
  .prototype[data-layout="cards"] .prototype-rows { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .prototype-row { display: flex; flex-direction: column; min-width: 0; overflow-wrap: anywhere; padding: var(--row-padding) 10px; border: 1px solid var(--border-dim); border-left: 2px solid var(--prototype-accent); border-radius: 6px; background: var(--bg-card); transition: padding 240ms var(--ease-out-expo), border-color 240ms var(--ease-out-expo); }
  .prototype-row-name { color: var(--text-head); }
  .prototype-row-detail { color: var(--text-dim); font-size: 11px; }
  .prototype[data-compact="true"] .prototype-row-detail { display: none; }
  .prototype-save { margin-top: auto; padding: 8px; border-radius: 6px; text-align: center; font-weight: 700; color: var(--bg); background: var(--prototype-accent); transition: background 240ms var(--ease-out-expo); }
  .pen-circle { position: absolute; left: -10px; right: -10px; bottom: -6px; width: calc(100% + 20px); height: auto; overflow: visible; pointer-events: none; }
  .pen-stroke { fill: none; stroke: var(--state-failed); stroke-width: 3; stroke-linecap: round; stroke-dasharray: 1; }
  .board-demo[data-on-screen="true"] .pen-stroke { animation: pen-draw 900ms var(--ease-out-expo) 300ms both; }
  @keyframes pen-draw { from { stroke-dashoffset: 1; } to { stroke-dashoffset: 0; } }
  .sticky-note { align-self: flex-end; margin-bottom: 24px; width: 132px; padding: 12px; rotate: -3deg; border-radius: 3px; background: var(--state-idle); color: var(--bg); font-size: 13px; font-weight: 700; line-height: 1.35; }
  .dials { grid-area: dials; align-self: start; display: flex; flex-direction: column; gap: 14px; margin: 0; padding: 16px; min-inline-size: 0; border: 1px solid var(--border); border-radius: 6px; background: var(--bg-card); }
  .dials legend { padding: 0 6px; color: var(--text-head); font-weight: 700; font-size: 14px; }
  .dial { display: flex; flex-direction: column; gap: 6px; color: var(--text-dim); font-size: 14px; }
  .dial select { font: inherit; color: var(--text-head); background: var(--bg-surface); border: 1px solid var(--border); border-radius: 4px; padding: 6px 8px; }
  .dial-toggle { flex-direction: row; align-items: center; gap: 8px; cursor: pointer; }
  .dial-toggle input { accent-color: var(--accent); width: 16px; height: 16px; margin: 0; }
  .dial select:focus-visible, .dial-toggle input:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .agent-notice { grid-area: notice; display: flex; flex-direction: column; gap: 6px; transition: opacity var(--arrive-ms) var(--ease-out-expo); }
  .agent-notice[data-shown="false"] { opacity: 0; }
  .agent-notice-label { color: var(--text-dim); font-size: 13px; }
  .agent-notice-line { margin: 0; padding: 10px 14px; border: 1px solid var(--border); border-radius: 6px; background: var(--bg); color: var(--text); font-family: var(--font-mono); font-size: 13px; white-space: pre-wrap; overflow-wrap: anywhere; }
  .agent-notice[data-flash="true"] .agent-notice-line { animation: notice-flash 900ms var(--ease-out-expo); }
  @keyframes notice-flash { from { border-color: var(--accent); box-shadow: 0 0 0 3px var(--accent-glow); } to { border-color: var(--border); box-shadow: none; } }
  .agent-notice-prompt { color: var(--accent); }
  .board-beats { list-style: none; margin: 28px 0 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
  .board-beats li { display: flex; flex-direction: column; gap: 4px; }
  .board-beat-name { color: var(--text-head); font-weight: 700; }
  .board-beat-line { color: var(--text-dim); font-size: 14px; }
  @media (max-width: 820px) {
    .board-demo { grid-template-columns: minmax(0, 1fr); grid-template-areas: "surface" "dials" "notice"; }
    .board-surface { flex-direction: column; min-height: 0; padding: 20px 12px; }
    .sticky-note { align-self: center; margin: 0; }
    .board-beats { grid-template-columns: minmax(0, 1fr); }
  }
  @media (prefers-reduced-motion: reduce) {
    .board-demo[data-on-screen="true"] .pen-stroke, .agent-notice[data-flash="true"] .agent-notice-line { animation: none; }
    .prototype, .prototype-title, .prototype-row, .prototype-save, .agent-notice { transition: none; }
  }
</style>

<script>
  import { markWhileOnScreen } from '../lib/dom.ts';

  function applyDial(prototype: HTMLElement, control: HTMLInputElement | HTMLSelectElement): void {
    if (control instanceof HTMLInputElement) {
      prototype.dataset.compact = String(control.checked);
      return;
    }
    prototype.dataset[control.name] = control.value;
  }

  function announceChange(notice: HTMLElement): void {
    notice.dataset.shown = 'true';
    notice.dataset.flash = 'false';
    void notice.offsetWidth;
    notice.dataset.flash = 'true';
  }

  function wireBoardDemo(): void {
    const demo = document.getElementById('board-demo');
    const prototype = document.getElementById('board-prototype');
    const dials = document.getElementById('board-dials');
    const notice = document.getElementById('board-notice');
    if (!demo || !prototype || !dials || !notice) return;
    markWhileOnScreen(demo);
    dials.addEventListener('change', (event) => {
      const control = event.target;
      if (!(control instanceof HTMLInputElement) && !(control instanceof HTMLSelectElement)) return;
      applyDial(prototype, control);
      announceChange(notice);
    });
  }

  wireBoardDemo();
</script>
