      <path data-git-step="b2" class="branch b2" pathLength="1" d="M20 90 C 20 106, 68 100, 68 116 L 68 260 C 68 276, 20 270, 20 286"/>
      <path data-git-step="b3" class="branch b3" pathLength="1" d="M20 140 C 20 156, 92 150, 92 166 L 92 384 C 92 400, 20 394, 20 410"/>
      <text class="lbl tag-b1" x="110" y="80">fix-auth-redirect</text>
      <text class="lbl tag-b2" x="110" y="140">flaky-upload-test</text>
      <text class="lbl tag-b3" x="110" y="216">migrate-billing</text>
      <g data-git-step="b1c1" class="dot"><circle class="commit-dot b1" cx="44" cy="76" r="6"/></g>
      <g data-git-step="b1c2" class="dot"><circle class="commit-dot b1" cx="44" cy="120" r="6"/></g>
      <g data-git-step="b1m" class="dot"><circle class="merged" cx="20" cy="200" r="7"/></g>
      <g data-git-step="b2c1" class="dot"><circle class="commit-dot b2" cx="68" cy="136" r="6"/></g>
      <g data-git-step="b2c2" class="dot"><circle class="commit-dot b2" cx="68" cy="236" r="6"/></g>
      <g data-git-step="b2m" class="dot"><circle class="merged" cx="20" cy="286" r="7"/></g>
      <g data-git-step="b3c1" class="dot"><circle class="commit-dot b3" cx="92" cy="212" r="6"/></g>
      <g data-git-step="b3p" class="dot"><path class="parked" d="M92 280 L 104 292 L 92 304 L 80 292 Z"/><text class="note parked-note" x="110" y="296">conflict: parked</text></g>
