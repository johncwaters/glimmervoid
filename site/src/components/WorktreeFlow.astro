<style>
  .git .main { stroke: var(--text-dim); stroke-width: 3; fill: none; }
  .git .branch { fill: none; stroke-width: 2.5; stroke-dasharray: 1; stroke-dashoffset: 1; transition: stroke-dashoffset 900ms ease-out; }
  .git .branch.on { stroke-dashoffset: 0; }
  .git .b1 { stroke: var(--state-running); }
  .git .b2 { stroke: var(--state-starting); }
  .git .b3 { stroke: var(--accent); }
  .git .dot { opacity: 0; transition: opacity 300ms; }
  .git .dot.on { opacity: 1; }
  .git .commit-dot { fill: var(--bg-card); stroke-width: 2.5; }
  .git .lbl { font-size: 11px; fill: var(--text-dim); }
  .git .lbl-main { font-size: 12px; fill: var(--text-head); font-weight: 700; }
  .git .parked { fill: var(--state-waiting); }
  .git .merged { fill: var(--state-complete); }
  .git .note { font-size: 11px; font-weight: 700; letter-spacing: 0.04em; }
  .git .parked-note { fill: var(--state-waiting); }
  .git .resolved-note { fill: var(--accent); }
  .git .diagram-compact .lbl, .git .diagram-compact .lbl-main { font-size: 13px; }
  .git .diagram-compact .note { font-size: 12.5px; }
  .git .tag-b1 { fill: var(--state-running); }
  .git .tag-b2 { fill: var(--state-starting); }
  .git .tag-b3 { fill: var(--accent); }
</style>

<script>
  import { prefersReducedMotion, runTimeline, type TimelineStep } from '../lib/dom.ts';

  const GIT_STEPS = [
    [200, 'b1'], [900, 'b1c1'], [1300, 'b2'], [1700, 'b1c2'], [2100, 'b3'], [2500, 'b2c1'], [3000, 'b1m'],
    [3400, 'b3c1'], [3800, 'b2c2'], [4500, 'b2m'], [5200, 'b3p'], [7000, 'b3r'], [8000, 'b3m'],
  ] as const;
  const GIT_LOOP_MS = 11000;

  function startWorktreeFlow(): void {
    const gitPartsByStep = GIT_STEPS.map(([, stepName]) => [...document.querySelectorAll(`[data-git-step="${stepName}"]`)]);
    const setAllVisible = (isVisible: boolean) => {
      for (const stepParts of gitPartsByStep) for (const part of stepParts) part.classList.toggle('on', isVisible);
    };
    if (prefersReducedMotion()) {
      setAllVisible(true);
      return;
    }
    const timeline: TimelineStep[] = GIT_STEPS.map(([atMs], index) => [atMs, () => {
      for (const part of gitPartsByStep[index]) part.classList.add('on');
    }]);
    runTimeline(timeline, GIT_LOOP_MS, () => setAllVisible(false));
  }

  startWorktreeFlow();
</script>
