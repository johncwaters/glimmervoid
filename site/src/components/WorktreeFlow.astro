      <text class="lbl" x="20" y="99">fix-auth-redirect</text>
      <text class="lbl" x="20" y="154">flaky-upload-test</text>
      <text class="lbl" x="20" y="209">migrate-billing</text>
      <g data-git-step="b1c1" class="dot"><circle class="commit-dot b1" cx="200" cy="95" r="6"/></g>
      <g data-git-step="b1c2" class="dot"><circle class="commit-dot b1" cx="260" cy="95" r="6"/></g>
      <g data-git-step="b1m" class="dot"><circle class="merged" cx="360" cy="40" r="7"/></g>
      <g data-git-step="b2c1" class="dot"><circle class="commit-dot b2" cx="330" cy="150" r="6"/></g>
      <g data-git-step="b2c2" class="dot"><circle class="commit-dot b2" cx="400" cy="150" r="6"/></g>
      <g data-git-step="b2m" class="dot"><circle class="merged" cx="510" cy="40" r="7"/></g>
      <g data-git-step="b3c1" class="dot"><circle class="commit-dot b3" cx="470" cy="205" r="6"/></g>
      <g data-git-step="b3p" class="dot"><path class="parked" d="M560 193 L 572 205 L 560 217 L 548 205 Z"/><text class="note parked-note" x="582" y="190">conflict: parked</text></g>
      <g data-git-step="b3r" class="dot"><circle class="commit-dot b3" cx="640" cy="205" r="6"/><text class="note resolved-note" x="560" y="240">resolved in session</text></g>
