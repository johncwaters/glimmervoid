---
import Base from '../layouts/Base.astro';
import Arena from '../components/Arena.astro';
import AsTheyAre from '../components/AsTheyAre.astro';
import Celebrations from '../components/Celebrations.astro';
import Faq from '../components/Faq.astro';
import Features from '../components/Features.astro';
import Footer from '../components/Footer.astro';
import Install from '../components/Install.astro';
import Reviews from '../components/Reviews.astro';
import UsedBy from '../components/UsedBy.astro';
import NextBoards from '../components/next/NextBoards.astro';
import NextHero from '../components/next/NextHero.astro';
import NextSaneYolo from '../components/next/NextSaneYolo.astro';
import NextStatus from '../components/next/NextStatus.astro';
---
<Base title="Glimmervoid: one needs you" unlisted>
  <div class="next-page">
    <NextHero />
    <UsedBy />
    <NextBoards />
    <NextStatus />
    <Arena />
    <NextSaneYolo />
    <Reviews />
    <Celebrations />
    <AsTheyAre />
    <Features />
    <Install commandLine="One command." />
    <Faq />
    <Footer />
  </div>
</Base>

<style is:global>
  .next-page section.band { padding-block: 72px; }
  .next-page .split { display: grid; grid-template-columns: 380px 1fr; gap: 40px; }
  .next-page .band-label { display: flex; align-items: center; gap: 8px; margin: 0; font-weight: 700; text-transform: uppercase; letter-spacing: .1em; font-size: var(--type-meta); color: var(--accent); }
  .next-page .band-label::before { content: ""; width: 7px; height: 7px; background: currentColor; rotate: 45deg; }
  .next-page section.band h2 { margin-top: 12px; font-size: clamp(30px, 4vw, 40px); letter-spacing: -.03em; line-height: 1.08; }
  .next-page .band-lede { margin-top: 14px; max-width: 34ch; color: var(--text-dim); font-family: var(--font-doc); font-size: 17px; }
  .next-page .panel { min-width: 0; padding: 24px 24px 8px; border: 1px solid var(--border); border-radius: var(--radius-lg); background: var(--bg-card); }
  .next-page .panel h3 { font-weight: 400; font-size: 20px; }
  .next-page .panel > p { margin-top: 4px; color: var(--text-dim); font-family: var(--font-doc); }
  .next-page .rows { list-style: none; margin: 20px 0 0; padding: 0; }
  .next-page .rows li { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; padding: 14px 0; border-top: 1px solid var(--border-dim); color: var(--text-head); font-size: var(--type-body); }
  @media (max-width: 820px) {
    .next-page .split { grid-template-columns: 1fr; gap: 24px; }
  }
</style>
