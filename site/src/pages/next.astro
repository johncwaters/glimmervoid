---
import { BRAND_ACCENT, BRAND_MARK_VIEWBOX, brandMarkMarkup } from '../../../shared/brand-mark.ts';
import Base from '../layouts/Base.astro';
import Footer from '../components/Footer.astro';
import NextAgents from '../components/next/NextAgents.astro';
import NextBoards from '../components/next/NextBoards.astro';
import NextHero from '../components/next/NextHero.astro';
import NextInstall from '../components/next/NextInstall.astro';
import NextOpenSource from '../components/next/NextOpenSource.astro';
import NextSaneYolo from '../components/next/NextSaneYolo.astro';
import NextStatus from '../components/next/NextStatus.astro';
import { sitePath } from '../lib/site-path.ts';

const NOTIFICATION_CHANNELS = [
  { label: 'Browser notification', reach: 'This machine' },
  { label: 'Telegram', reach: 'Anywhere' },
  { label: 'Paired phone', reach: 'The full dashboard' },
  { label: 'Streamer mode', reach: 'Hides secrets on stream' },
];
const USAGE_BAR_HEIGHTS = [30, 45, 38, 60, 52, 70, 48, 82, 66, 90];
const CONSOLE_FEATURES = [
  { title: 'Reviews', detail: "An agent reads your team's pull request and drafts the review for you to post." },
  { title: 'Radar', detail: 'PostHog errors to pull requests, opt-in.' },
  { title: 'Vault', detail: 'You approve every secret an agent reads.' },
  { title: 'Arena', detail: 'One prompt, five agents, a judge. Keep the best diff.' },
  { title: 'Worktrees', detail: 'One worktree each. One-click merge.' },
];
const pushMarkMarkup = brandMarkMarkup({ frame: 'currentColor', light: BRAND_ACCENT });
---
<Base title="Glimmervoid: one needs you" unlisted>
  <div class="next-page">
    <NextHero />
    <NextStatus />
    <NextBoards />
    <NextSaneYolo />

    <section class="band" id="phone">
      <div class="split reveal">
        <div>
          <p class="band-label">Phone</p>
          <h2>Answer from the couch.</h2>
          <p class="band-lede">Pair your phone once. When a session needs you it buzzes; answer, and the session carries on.</p>
        </div>
        <div class="panel">
          <h3>Where a question finds you</h3>
          <div class="phone-row">
            <div class="phone" aria-hidden="true">
              <div class="push"><small><svg viewBox={BRAND_MARK_VIEWBOX} aria-hidden="true" set:html={pushMarkMarkup}></svg>Glimmervoid</small>fix-auth-redirect needs input</div>
              <p class="phone-terminal"><span>&gt;</span> updated 3 callers<br /><span>&gt;</span> 41 passed<br /><br /><em>Keep /login as a redirect?</em></p>
              <div class="phone-answers"><b>Yes</b><b>No</b></div>
            </div>
            <ul class="rows">
              {NOTIFICATION_CHANNELS.map(({ label, reach }) => <li>{label}<span class="row-end">{reach}</span></li>)}
            </ul>
          </div>
        </div>
      </div>
    </section>

    <section class="band">
      <div class="reveal">
        <div class="grid-title">
          <div><p class="band-label">Also in the box</p><h2>The rest of the console.</h2></div>
          <a class="btn" href={sitePath('#features')}>All features</a>
        </div>
        <ul class="console-features">
          <li class="is-wide"><h3>Usage</h3><p>What each session costs, and your pace against the plan limit.</p><span class="usage-bars" aria-hidden="true">{USAGE_BAR_HEIGHTS.map((heightPercent) => <i style={`height: ${heightPercent}%`}></i>)}</span></li>
          <li><h3>Trace</h3><p>Every tool call, in order.</p><span class="trace-lines" aria-hidden="true"><b>Read</b> server/auth.ts<br /><b>Edit</b> routes/login.ts<br /><b>Bash</b> npm test</span></li>
          {CONSOLE_FEATURES.map(({ title, detail }) => <li><h3>{title}</h3><p>{detail}</p></li>)}
        </ul>
      </div>
    </section>

    <NextInstall />
    <NextAgents />
    <NextOpenSource />
    <Footer />
  </div>
</Base>

<style is:global>
  .next-page section.band { padding-block: 72px; }
  .next-page .split { display: grid; grid-template-columns: 380px 1fr; gap: 40px; }
  .next-page .band-label { display: flex; align-items: center; gap: 8px; margin: 0; font-weight: 700; text-transform: uppercase; letter-spacing: .1em; font-size: var(--type-meta); color: var(--accent); }
  .next-page .band-label::before { content: ""; width: 7px; height: 7px; background: currentColor; rotate: 45deg; }
  .next-page section.band h2 { margin-top: 12px; font-size: clamp(30px, 4vw, 40px); letter-spacing: -.03em; line-height: 1.08; }
  .next-page .band-lede { margin-top: 14px; max-width: 34ch; color: var(--text-dim); font-family: var(--font-doc); font-size: 17px; }
  .next-page .panel { min-width: 0; padding: 24px 24px 8px; border: 1px solid var(--border); border-radius: var(--radius-lg); background: var(--bg-card); }
  .next-page .panel h3 { font-weight: 400; font-size: 20px; }
  .next-page .panel > p { margin-top: 4px; color: var(--text-dim); font-family: var(--font-doc); }
  .next-page .rows { list-style: none; margin: 20px 0 0; padding: 0; }
  .next-page .rows li { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; padding: 14px 0; border-top: 1px solid var(--border-dim); color: var(--text-head); font-size: var(--type-body); }
  .next-page .row-end { margin-left: auto; color: var(--text-dim); }
  .next-page .btn-primary { background: var(--accent); border-color: var(--accent); color: var(--bg); font-weight: 700; }
  .next-page .btn-primary:hover { background: color-mix(in oklab, var(--accent) 85%, var(--text-head)); }
  @media (max-width: 820px) {
    .next-page .split { grid-template-columns: 1fr; gap: 24px; }
  }
</style>

<style>
  .phone-row { display: grid; grid-template-columns: 240px 1fr; gap: 28px; align-items: center; margin-top: 20px; padding-bottom: 16px; }
  .phone { position: relative; width: 228px; height: 440px; padding: 26px 14px; border: 8px solid var(--border-dim); border-radius: 34px; background: var(--bg); }
  .push { padding: 10px 12px; border: 1px solid var(--border-hover); border-radius: var(--radius-lg); background: var(--bg-surface); font-size: var(--type-meta); color: var(--text-head); }
  .push small { display: flex; gap: 6px; align-items: center; margin-bottom: 4px; color: var(--text-dim); font-size: 10px; text-transform: uppercase; letter-spacing: .08em; }
  .push svg { width: 10px; height: 10px; }
  .phone-terminal { margin-top: 18px; font-size: 11px; line-height: 1.7; }
  .phone-terminal span { color: var(--accent); }
  .phone-terminal em { font-style: normal; color: var(--state-waiting); }
  .phone-answers { position: absolute; left: 14px; right: 14px; bottom: 20px; display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
  .phone-answers b { display: grid; place-items: center; height: 36px; border: 1px solid var(--border-hover); border-radius: var(--radius); background: var(--bg-surface); color: var(--text-head); font-size: var(--type-meta); text-transform: uppercase; letter-spacing: .08em; }
  .phone-answers b:first-child { border-color: var(--accent); background: var(--accent); color: var(--bg); }
  .grid-title { display: flex; flex-wrap: wrap; gap: 20px; justify-content: space-between; align-items: end; }
  .grid-title .btn { text-decoration: none; }
  .console-features { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1px; list-style: none; margin: 28px 0 0; padding: 0; overflow: hidden; border: 1px solid var(--border-dim); border-radius: var(--radius-lg); background: var(--border-dim); }
  .console-features li { display: flex; flex-direction: column; min-height: 170px; padding: 22px; background: var(--bg-card); }
  .console-features li.is-wide { grid-column: span 2; }
  .console-features h3 { font-size: 15px; }
  .console-features p { margin-top: 4px; color: var(--text-dim); font-family: var(--font-doc); font-size: var(--type-body); }
  .usage-bars { display: flex; gap: 5px; align-items: end; height: 54px; margin-top: auto; padding-top: 14px; }
  .usage-bars i { flex: 1; border-radius: 2px 2px 0 0; background: var(--accent-dim); }
  .usage-bars i:last-child { background: var(--accent); }
  .trace-lines { margin-top: auto; padding-top: 14px; color: var(--text-dim); font-size: 11px; line-height: 1.8; }
  .trace-lines b { color: var(--text-head); font-weight: 400; }
  @media (max-width: 820px) {
    .phone-row { grid-template-columns: 1fr; justify-items: center; }
    .phone-row .rows { justify-self: stretch; }
    .console-features { grid-template-columns: repeat(2, 1fr); }
  }
</style>
