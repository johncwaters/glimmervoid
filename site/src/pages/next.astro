---
import Base from '../layouts/Base.astro';
import Arena from '../components/Arena.astro';
import Boards from '../components/Boards.astro';
import SaneYolo from '../components/SaneYolo.astro';
import Status from '../components/Status.astro';
import AsTheyAre from '../components/AsTheyAre.astro';
import Celebrations from '../components/Celebrations.astro';
import Faq from '../components/Faq.astro';
import Features from '../components/Features.astro';
import Footer from '../components/Footer.astro';
import Install from '../components/Install.astro';
import UsedBy from '../components/UsedBy.astro';
import NextCloud from '../components/next/NextCloud.astro';
import NextHero from '../components/next/NextHero.astro';
import NextPacks from '../components/next/NextPacks.astro';
import { HOME_TITLE, homeStructuredData } from '../lib/home-structured-data.ts';
import { HOME_DESCRIPTION } from '../lib/product-facts.ts';
---
<Base title={HOME_TITLE} description={HOME_DESCRIPTION} structuredData={homeStructuredData(Astro.site)} markdownPath="index.md" unlisted>
  <div class="next-page">
    <NextHero />
    <UsedBy />
    <NextPacks />
    <Boards />
    <Status />
    <Arena />
    <SaneYolo />
    <Celebrations />
    <AsTheyAre />
    <Features />
    <NextCloud />
    <Install commandLine="" showsNextCommands={false} />
    <Faq />
    <Footer />
  </div>
</Base>

<style is:global>
  .next-page section { padding-block: 128px; border-top: 0; }
  .next-page #status .all-clear-hint, .next-page #status .queue-row, .next-page #status .agent-row-label:has(+ .is-also), .next-page #status .agent-chips.is-also { display: none; }
  .next-page .section-head { margin-bottom: 64px; }
  .next-page .attention-board { max-width: none; }
  .next-page .celebration-demo { width: auto; flex-direction: row; flex-wrap: wrap; align-items: center; justify-content: space-between; }
  .next-page .celebration-demo .queue-row { padding-top: 0; border-top: 0; }
  @media (min-width: 1180px) {
    .next-page section { padding-block: 200px; }
    .next-page section:has(> .section-head) { display: grid; grid-template-columns: 340px minmax(0, 1fr); column-gap: 64px; align-items: start; }
    .next-page section > .section-head { grid-column: 1; grid-row: 1 / span 12; position: sticky; top: 48px; margin-bottom: 0; }
    .next-page section:has(> .section-head) > :not(.section-head) { grid-column: 2; }
    .next-page #sane-yolo .yolo { grid-template-columns: 340px minmax(0, 1fr); column-gap: 64px; }
    .next-page #sane-yolo .ledger-details { margin-left: 404px; }
  }
  @media (max-width: 1179px) {
    .next-page section > .section-head { display: contents; }
    .next-page section > .section-head > h2 { position: sticky; top: 0; z-index: 5; margin-inline: calc(50% - 50vw); padding: 14px calc(50vw - 50%); background: var(--bg); border-bottom: 1px solid var(--border-dim); }
    .next-page section > .section-head > p { margin-top: 14px; max-width: 54ch; }
    .next-page section > .section-head > :last-child { margin-bottom: 64px; }
  }
  @media (max-width: 640px) {
    .next-page section > .section-head > :last-child { margin-bottom: 48px; }
    .next-page section { padding-block: 96px; }
    .next-page .section-head { margin-bottom: 48px; }
  }
</style>
