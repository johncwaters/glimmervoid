---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { formatDate } from '../../lib/format-date.ts';
import { sitePath } from '../../lib/site-path.ts';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (left, right) => right.data.pubDate.valueOf() - left.data.pubDate.valueOf(),
);
---
<Base title="Glimmervoid Blog" description="Notes from building Glimmervoid, mission control for coding agents.">
  <Nav />
  <section class="blog-index">
    <h1>Blog</h1>
    <ul class="post-list">
      {posts.map((post) => (
        <li>
          <a class="post-link" href={sitePath(`blog/${post.id}/`)}>
            <h2>{post.data.title}</h2>
            <p class="post-meta">
              <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
              {post.data.tags.map((tag) => <span>#{tag}</span>)}
            </p>
            <p class="post-description">{post.data.description}</p>
          </a>
        </li>
      ))}
    </ul>
  </section>
  <Footer />
</Base>

<style>
  .blog-index { max-width: 72ch; margin-inline: auto; }
  .blog-index h1 { margin-bottom: 28px; }
  .post-list { list-style: none; margin: 0; padding: 0; }
  .post-list li { border-bottom: 1px solid var(--border-dim); }
  .post-link { display: block; padding-block: 24px; text-decoration: none; color: inherit; }
  .post-link h2 { font-size: clamp(19px, 2.6vw, 23px); line-height: 1.3; }
  .post-link:hover h2, .post-link:focus-visible h2 { color: var(--accent); }
  .post-meta { display: flex; flex-wrap: wrap; gap: 4px 12px; margin-top: 8px; font-size: 12px; color: var(--text-dim); }
  .post-description { margin-top: 8px; font-size: 14px; color: var(--text-dim); }
</style>
