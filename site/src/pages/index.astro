---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import UsedBy from '../components/UsedBy.astro';
import AsTheyAre from '../components/AsTheyAre.astro';
import Boards from '../components/Boards.astro';
import Status from '../components/Status.astro';
import Arena from '../components/Arena.astro';
import Reviews from '../components/Reviews.astro';
import SaneYolo from '../components/SaneYolo.astro';
import Features from '../components/Features.astro';
import Celebrations from '../components/Celebrations.astro';
import Install from '../components/Install.astro';
import Faq from '../components/Faq.astro';
import Footer from '../components/Footer.astro';
import { FAQ_ENTRIES } from '../lib/faq.ts';
import { PRODUCT_SUMMARY, PRODUCT_VERSION, REPOSITORY_URL } from '../lib/product-facts.ts';

const HOME_URL = new URL('/', Astro.site).href;
const HOME_STRUCTURED_DATA = {
  '@graph': [
    { '@type': 'WebSite', name: 'Glimmervoid', url: HOME_URL },
    {
      '@type': 'SoftwareApplication',
      name: 'Glimmervoid',
      url: HOME_URL,
      description: PRODUCT_SUMMARY,
      applicationCategory: 'DeveloperApplication',
      operatingSystem: 'Windows, macOS, Linux',
      softwareVersion: PRODUCT_VERSION,
      license: 'https://opensource.org/licenses/MIT',
      sameAs: REPOSITORY_URL,
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    },
    {
      '@type': 'FAQPage',
      mainEntity: FAQ_ENTRIES.map(({ question, answer }) => ({ '@type': 'Question', name: question, acceptedAnswer: { '@type': 'Answer', text: answer } })),
    },
  ],
};
---
<Base title="Glimmervoid: open-source orchestrator for terminal coding agents" structuredData={HOME_STRUCTURED_DATA} markdownPath="index.md">
  <Nav />
  <Hero />
  <UsedBy />
  <Boards />
  <Status />
  <Arena />
  <SaneYolo />
  <Reviews />
  <Celebrations />
  <AsTheyAre />
  <Features />
  <Install />
  <Faq />
  <Footer />
</Base>
