---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import UsedBy from '../components/UsedBy.astro';
import AsTheyAre from '../components/AsTheyAre.astro';
import Remote from '../components/Remote.astro';
import Status from '../components/Status.astro';
import WorktreeFlow from '../components/WorktreeFlow.astro';
import Reviews from '../components/Reviews.astro';
import Guardrails from '../components/Guardrails.astro';
import Features from '../components/Features.astro';
import Celebrations from '../components/Celebrations.astro';
import Install from '../components/Install.astro';
import Footer from '../components/Footer.astro';
import { PRODUCT_VERSION, REPOSITORY_URL } from '../lib/product-facts.ts';

const HOME_URL = new URL('/', Astro.site).href;
const HOME_STRUCTURED_DATA = {
  '@graph': [
    { '@type': 'WebSite', name: 'Glimmervoid', url: HOME_URL },
    {
      '@type': 'SoftwareApplication',
      name: 'Glimmervoid',
      url: HOME_URL,
      applicationCategory: 'DeveloperApplication',
      operatingSystem: 'Windows, macOS, Linux',
      softwareVersion: PRODUCT_VERSION,
      license: 'https://opensource.org/licenses/MIT',
      sameAs: REPOSITORY_URL,
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    },
  ],
};
---
<Base title="Glimmervoid: open-source orchestrator for Claude Code and Codex" structuredData={HOME_STRUCTURED_DATA} markdownPath="index.md">
  <Nav />
  <Hero />
  <UsedBy />
  <Status />
  <AsTheyAre />
  <WorktreeFlow />
  <Guardrails />
  <Reviews />
  <Remote />
  <Features />
  <Celebrations />
  <Install />
  <Footer />
</Base>
