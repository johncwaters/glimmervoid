---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import UsedBy from '../components/UsedBy.astro';
import AsTheyAre from '../components/AsTheyAre.astro';
import Remote from '../components/Remote.astro';
import Status from '../components/Status.astro';
import WorktreeFlow from '../components/WorktreeFlow.astro';
import Reviews from '../components/Reviews.astro';
import HelperAgents from '../components/HelperAgents.astro';
import Guardrails from '../components/Guardrails.astro';
import Features from '../components/Features.astro';
import Celebrations from '../components/Celebrations.astro';
import Install from '../components/Install.astro';
import Footer from '../components/Footer.astro';

const HOME_STRUCTURED_DATA = {
  '@type': 'WebSite',
  name: 'Glimmervoid',
  url: new URL('/', Astro.site).href,
};
---
<Base title="Glimmervoid: mission control for Claude Code and Codex agents" structuredData={HOME_STRUCTURED_DATA} markdownPath="index.md">
  <Nav />
  <Hero />
  <UsedBy />
  <Status />
  <AsTheyAre />
  <WorktreeFlow />
  <Guardrails />
  <HelperAgents />
  <Reviews />
  <Remote />
  <Features />
  <Celebrations />
  <Install />
  <Footer />
</Base>
