---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import UsedBy from '../components/UsedBy.astro';
import AsTheyAre from '../components/AsTheyAre.astro';
import Boards from '../components/Boards.astro';
import Status from '../components/Status.astro';
import Arena from '../components/Arena.astro';
import Reviews from '../components/Reviews.astro';
import SaneYolo from '../components/SaneYolo.astro';
import Features from '../components/Features.astro';
import Celebrations from '../components/Celebrations.astro';
import Install from '../components/Install.astro';
import Faq from '../components/Faq.astro';
import Footer from '../components/Footer.astro';
import { HOME_TITLE, homeStructuredData } from '../lib/home-structured-data.ts';
import { HOME_DESCRIPTION } from '../lib/product-facts.ts';

const HOME_STRUCTURED_DATA = homeStructuredData(Astro.site);
---
<Base title={HOME_TITLE} description={HOME_DESCRIPTION} structuredData={HOME_STRUCTURED_DATA} markdownPath="index.md">
  <Nav />
  <Hero />
  <UsedBy />
  <Boards />
  <Status />
  <Arena />
  <SaneYolo />
  <Reviews />
  <Celebrations />
  <AsTheyAre />
  <Features />
  <Install />
  <Faq />
  <Footer />
</Base>
