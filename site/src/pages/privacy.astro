---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { REPOSITORY_URL } from '../lib/product-facts.ts';
---
<Base title="Privacy | Glimmervoid" description="What glimmervoid.dev and the Glimmervoid app record, and how to choose.">
  <Nav />
  <section class="privacy">
    <h1>Privacy</h1>
    <p>glimmervoid.dev uses PostHog to see how the site is used: which pages are opened, how far down they are read, what is clicked, and when the install command is copied or a platform is picked. IP addresses are not stored.</p>
    <h2>Before you choose, or if you decline</h2>
    <p>Visits are counted without a cookie. PostHog groups events into a visit with an anonymous hash that changes every day. Nothing is recorded as a replay. Before you choose, nothing is stored in your browser; if you decline, your browser keeps one small entry that remembers the choice.</p>
    <h2>If you accept</h2>
    <p>A PostHog cookie, with a copy in your browser storage, keeps one random id across visits, so a return visit counts as the same visitor. Your visit is also recorded as a session replay, with everything typed into a field masked. Replays are kept for 30 days.</p>
    <h2>Your choice</h2>
    <p class="consent-status" data-consent-status></p>
    <div class="consent-actions" data-consent-controls hidden>
      <button type="button" class="btn" data-consent-choice="declined">Decline</button>
      <button type="button" class="btn" data-consent-choice="accepted">Accept</button>
    </div>
    <h2>The Glimmervoid app</h2>
    <p>The app sends anonymous usage and error data under a random install id, never paths, repository names, prompts or terminal output. <a href={`${REPOSITORY_URL}/blob/main/docs/configuration.md#telemetry`}>What it sends and how to turn it off</a>.</p>
  </section>
  <Footer />
</Base>

<script>
  import { acceptAnalytics, CONSENT_CHANGE_EVENT, consentChoice, declineAnalytics, isAnalyticsEnabled } from '../lib/analytics.ts';
  import type { ConsentChoice } from '../lib/analytics.ts';

  const STATUS_TEXT_BY_CHOICE: Record<ConsentChoice, string> = {
    pending: 'You have not chosen yet.',
    accepted: 'You accepted the cookie and session replay.',
    declined: 'You declined. No cookie, no replay.',
  };
  const consentStatus = document.querySelector<HTMLElement>('[data-consent-status]');
  const consentControls = document.querySelector<HTMLElement>('[data-consent-controls]');
  const showConsentStatus = () => {
    if (consentStatus) consentStatus.textContent = STATUS_TEXT_BY_CHOICE[consentChoice()];
  };
  if (consentStatus && consentControls && isAnalyticsEnabled) {
    showConsentStatus();
    consentControls.hidden = false;
    consentControls.addEventListener('click', (event) => {
      const choiceButton = event.target instanceof Element ? event.target.closest<HTMLElement>('[data-consent-choice]') : null;
      if (!choiceButton) return;
      if (choiceButton.dataset.consentChoice === 'accepted') acceptAnalytics();
      if (choiceButton.dataset.consentChoice === 'declined') declineAnalytics();
      document.querySelector<HTMLElement>('[data-consent-banner]')?.setAttribute('hidden', '');
    });
    window.addEventListener(CONSENT_CHANGE_EVENT, showConsentStatus);
  }
</script>

<style>
  .privacy { max-width: 72ch; margin-inline: auto; padding-bottom: 48px; }
  .privacy h1 { margin-bottom: 20px; }
  .privacy h2 { margin-top: 32px; margin-bottom: 8px; font-size: 18px; }
  .privacy p { color: var(--text); }
  .consent-status { color: var(--text-dim); }
  .consent-actions { display: flex; gap: 8px; margin-top: 12px; }
  .consent-actions[hidden] { display: none; }
</style>
