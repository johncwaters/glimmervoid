{
  "$id": "https://glimmervoid.dev/schema/pack.v1.json",
  "title": "Glimmervoid pack",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,39}$",
      "description": "Unique among installed packs; a second pack with the same name is refused. Theme and panel ids are scoped to it, so they never clash with another pack"
    },
    "version": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "description": "Your release number, shown to the operator beside the pack; raise it with each change. Approval follows the files, not this number: any changed file asks again"
    },
    "description": {
      "type": "string",
      "maxLength": 500
    },
    "requires": {
      "default": {
        "env": [],
        "programs": []
      },
      "type": "object",
      "properties": {
        "env": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          }
        },
        "programs": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$"
          }
        }
      },
      "additionalProperties": false
    },
    "prFlows": {
      "description": "PR flows this pack adds; one invalid entry skips the whole section",
      "type": "object",
      "properties": {
        "repos": {
          "description": "The default owner/name repositories, matched case-insensitively, for every prAction, source and rule of this pack that lists no repos of its own; an entry's own repos narrow this default to the repositories both list; every repository when absent",
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+\\/[A-Za-z0-9_.-]+$"
          }
        },
        "prActions": {
          "default": [],
          "description": "Buttons on a pull request; the command prints {\"outcome\":\"done|started|refused|failed\",\"message\":\"...\"}, and one that prints started reports later with glimmervoid pr-action report",
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
                "description": "Unique within its list; inside a pack it is shown as <pack>/<id>"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 24,
                "description": "The name shown to the operator; rules never match on it"
              },
              "command": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "description": "The program and its arguments, run without a shell from the Glimmervoid home folder; an argument may hold {prUrl}, {repo}, {number}, {head}, {headRef}, {baseRef}, and in a pack also {packDir}, the pack's folder. Its environment has GLIMMERVOID_PR_URL, GLIMMERVOID_PR_REPO, GLIMMERVOID_PR_NUMBER and GLIMMERVOID_PR_HEAD, GLIMMERVOID_PR_HEAD_REF, GLIMMERVOID_PR_BASE_REF and the pull request as GLIMMERVOID_PR_JSON. Exit 0 means done and any other exit failed, unless stdout prints the action outcome JSON (glimmervoid packs guide --schema pr-flows)"
              },
              "timeoutSeconds": {
                "default": 120,
                "description": "Seconds before the command is stopped",
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 3600
              },
              "repos": {
                "description": "The owner/name repositories this applies to; every repository when absent",
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_.-]+\\/[A-Za-z0-9_.-]+$"
                }
              }
            },
            "required": [
              "id",
              "label",
              "command"
            ],
            "additionalProperties": false
          }
        },
        "sources": {
          "default": [],
          "description": "Commands run on each pull request that print {\"findings\":[{\"path\",\"lineStart\",\"lineEnd\",\"priority\",\"body\",\"url\"}],\"status\":[{\"label\",\"state\"}]}, at most 200 findings and 4 status lines",
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
                "description": "Unique within its list; inside a pack it is shown as <pack>/<id>"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 24,
                "description": "The name shown to the operator; rules never match on it"
              },
              "command": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "description": "The program and its arguments, run without a shell from the Glimmervoid home folder; an argument may hold {prUrl}, {repo}, {number}, {head}, and in a pack also {packDir}, the pack's folder. Its environment has GLIMMERVOID_PR_URL, GLIMMERVOID_PR_REPO, GLIMMERVOID_PR_NUMBER and GLIMMERVOID_PR_HEAD. It must print the source output JSON (glimmervoid packs guide --schema pr-flows) on stdout; anything else shows as an error on the pull request"
              },
              "timeoutSeconds": {
                "default": 120,
                "description": "Seconds before the command is stopped",
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 3600
              },
              "repos": {
                "description": "The owner/name repositories this applies to; every repository when absent",
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_.-]+\\/[A-Za-z0-9_.-]+$"
                }
              }
            },
            "required": [
              "id",
              "label",
              "command"
            ],
            "additionalProperties": false
          }
        },
        "actions": {
          "default": [],
          "description": "Commands rules run on one review item with run:<id>; they print {\"outcome\":\"done|started|refused|failed\",\"message\":\"...\"} and are limited to repositories only through the rules that name them",
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
                "description": "Unique within its list; inside a pack it is shown as <pack>/<id>"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 24,
                "description": "The name shown to the operator; rules never match on it"
              },
              "command": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "description": "The program and its arguments, run without a shell from the Glimmervoid home folder; an argument may hold {prUrl}, {repo}, {number}, {head}, {itemPath}, {itemLine}, and in a pack also {packDir}, the pack's folder. Its environment has GLIMMERVOID_PR_URL, GLIMMERVOID_PR_REPO, GLIMMERVOID_PR_NUMBER and GLIMMERVOID_PR_HEAD, and the review item as GLIMMERVOID_ITEM_JSON. Exit 0 means done and any other exit failed, unless stdout prints the action outcome JSON (glimmervoid packs guide --schema pr-flows)"
              },
              "timeoutSeconds": {
                "default": 120,
                "description": "Seconds before the command is stopped",
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 3600
              }
            },
            "required": [
              "id",
              "label",
              "command"
            ],
            "additionalProperties": false
          }
        },
        "rules": {
          "default": [],
          "description": "Run after your own config.json rules; the first rule that matches an item decides it",
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80,
                "pattern": "\\S"
              },
              "sources": {
                "description": "The bare ids of this pack's sources the rule acts on. An item merged from several sources matches only when every one of them is listed here or under authors; any source when both are absent",
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
                }
              },
              "authors": {
                "description": "The GitHub logins of review comment authors this rule acts on, compared case-insensitively. An item merged from several sources matches only when every one of them is listed here or under authors; any source when both are absent",
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "priority": {
                "description": "The finding priorities this rule acts on; any priority when absent",
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "blocker",
                    "high",
                    "medium",
                    "low",
                    "unknown"
                  ]
                }
              },
              "paths": {
                "description": "Repository paths; an entry ending in / matches every path under it, any other matches that exact path",
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "text": {
                "description": "Text the finding must contain, compared case-insensitively",
                "type": "string",
                "minLength": 1
              },
              "scope": {
                "default": "mine",
                "description": "Rules act only on your own pull requests today, so mine and both act there and team never acts yet",
                "type": "string",
                "enum": [
                  "mine",
                  "team",
                  "both"
                ]
              },
              "repos": {
                "description": "The owner/name repositories this applies to; every repository when absent",
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_.-]+\\/[A-Za-z0-9_.-]+$"
                }
              },
              "action": {
                "anyOf": [
                  {
                    "type": "string",
                    "enum": [
                      "ask",
                      "fix-local",
                      "dismiss"
                    ]
                  },
                  {
                    "type": "string",
                    "pattern": "^run:[a-z0-9][a-z0-9-]{0,63}$"
                  }
                ],
                "description": "ask waits for you, fix-local hands the item to a local session, dismiss replies with reason and resolves it, run:<id> runs that action; run:<id> names an action of this pack by its bare id"
              },
              "reason": {
                "description": "The reply posted when the rule dismisses an item",
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              }
            },
            "required": [
              "name",
              "action"
            ],
            "additionalProperties": false,
            "if": {
              "properties": {
                "action": {
                  "const": "dismiss"
                }
              },
              "required": [
                "action"
              ]
            },
            "then": {
              "required": [
                "reason"
              ]
            }
          }
        }
      },
      "additionalProperties": false
    },
    "ui": {
      "type": "object",
      "properties": {
        "themes": {
          "default": [],
          "maxItems": 8,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40,
                "description": "The name shown in the Theme picker"
              },
              "mode": {
                "type": "string",
                "enum": [
                  "dark",
                  "light"
                ],
                "description": "Whether the theme is dark or light, which picks the terminal palette its ANSI colors are tuned for"
              },
              "accentAnsiSlot": {
                "type": "string",
                "enum": [
                  "blue",
                  "magenta",
                  "none"
                ],
                "description": "The terminal ANSI color the accent replaces, with a lighter mix of it as that color's bright variant; none leaves terminal colors alone"
              },
              "chrome": {
                "type": "object",
                "properties": {
                  "bg": {
                    "type": "string",
                    "pattern": "^#[0-9a-fA-F]{6}$",
                    "description": "Page background"
                  },
                  "bg-card": {
                    "type": "string",
                    "pattern": "^#[0-9a-fA-F]{6}$",
                    "description": "Cards, panes and the terminal background"
                  },
                  "bg-header": {
                    "type": "string",
                    "pattern": "^#[0-9a-fA-F]{6}$",
                    "description": "Headers and toolbars"
                  },
                  "bg-surface": {
                    "type": "string",
                    "pattern": "^#[0-9a-fA-F]{6}$",
                    "description": "Raised controls: chips, inputs, menus and hover fills"
                  },
                  "border": {
                    "type": "string",
                    "pattern": "^#[0-9a-fA-F]{6}$",
                    "description": "Default borders"
                  },
                  "border-dim": {
                    "type": "string",
                    "pattern": "^#[0-9a-fA-F]{6}$",
                    "description": "Faint dividers inside a card or list"
                  },
                  "border-hover": {
                    "type": "string",
                    "pattern": "^#[0-9a-fA-F]{6}$",
                    "description": "Borders of a hovered or focused control"
                  },
                  "text": {
                    "type": "string",
                    "pattern": "^#[0-9a-fA-F]{6}$",
                    "description": "Body text"
                  },
                  "text-dim": {
                    "type": "string",
                    "pattern": "^#[0-9a-fA-F]{6}$",
                    "description": "Secondary text such as hints and empty states"
                  },
                  "text-head": {
                    "type": "string",
                    "pattern": "^#[0-9a-fA-F]{6}$",
                    "description": "Headings and emphasized text"
                  },
                  "text-muted": {
                    "type": "string",
                    "pattern": "^#[0-9a-fA-F]{6}$",
                    "description": "Labels and metadata, between text and text-dim"
                  },
                  "accent": {
                    "type": "string",
                    "pattern": "^#[0-9a-fA-F]{6}$",
                    "description": "Links, focus rings, selection and primary actions"
                  },
                  "accent-dim": {
                    "type": "string",
                    "pattern": "^#[0-9a-fA-F]{6}$",
                    "description": "A quieter accent for selected borders"
                  }
                },
                "required": [
                  "bg",
                  "bg-card",
                  "bg-header",
                  "bg-surface",
                  "border",
                  "border-dim",
                  "border-hover",
                  "text",
                  "text-dim",
                  "text-head",
                  "text-muted",
                  "accent",
                  "accent-dim"
                ],
                "additionalProperties": false,
                "description": "Dashboard colors; each key becomes the CSS custom property --<key>"
              },
              "states": {
                "type": "object",
                "properties": {
                  "running": {
                    "type": "string",
                    "pattern": "^#[0-9a-fA-F]{6}$"
                  },
                  "waiting": {
                    "type": "string",
                    "pattern": "^#[0-9a-fA-F]{6}$"
                  },
                  "failed": {
                    "type": "string",
                    "pattern": "^#[0-9a-fA-F]{6}$"
                  },
                  "monitoring": {
                    "type": "string",
                    "pattern": "^#[0-9a-fA-F]{6}$"
                  },
                  "done": {
                    "type": "string",
                    "pattern": "^#[0-9a-fA-F]{6}$"
                  },
                  "initializing": {
                    "type": "string",
                    "pattern": "^#[0-9a-fA-F]{6}$"
                  },
                  "idle": {
                    "type": "string",
                    "pattern": "^#[0-9a-fA-F]{6}$"
                  },
                  "starting": {
                    "type": "string",
                    "pattern": "^#[0-9a-fA-F]{6}$"
                  },
                  "complete": {
                    "type": "string",
                    "pattern": "^#[0-9a-fA-F]{6}$"
                  }
                },
                "required": [
                  "running",
                  "waiting",
                  "failed",
                  "monitoring",
                  "done",
                  "initializing",
                  "idle",
                  "starting",
                  "complete"
                ],
                "additionalProperties": false,
                "description": "One color per session state, shown as --state-<state> on cards, dots and badges"
              },
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]{0,39}$"
              }
            },
            "required": [
              "label",
              "mode",
              "accentAnsiSlot",
              "chrome",
              "states",
              "id"
            ],
            "additionalProperties": false
          }
        },
        "panels": {
          "default": [],
          "maxItems": 8,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]{0,39}$"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 24
              },
              "entry": {
                "type": "string",
                "pattern": "^(?!\\/)(?!.*(?:^|\\/)\\.\\.?(?:\\/|$))[A-Za-z0-9._/-]{1,200}$",
                "description": "The HTML page the panel opens, relative to the pack folder"
              },
              "icon": {
                "type": "string",
                "pattern": "^(?!\\/)(?!.*(?:^|\\/)\\.\\.?(?:\\/|$))[A-Za-z0-9._/-]{1,200}$"
              },
              "reads": {
                "default": [],
                "description": "The bridge topics this panel may receive; the operator sees them before approving, and a subscribe for any other topic is ignored",
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "sessions",
                    "focus",
                    "theme",
                    "my-prs",
                    "usage",
                    "attention",
                    "team-reviews"
                  ]
                }
              }
            },
            "required": [
              "id",
              "label",
              "entry"
            ],
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "name",
    "version"
  ],
  "additionalProperties": false
}
