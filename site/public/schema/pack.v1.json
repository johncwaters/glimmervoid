{
  "$id": "https://glimmervoid.dev/schema/pack.v1.json",
  "title": "Glimmervoid pack",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,39}$"
    },
    "version": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "description": {
      "type": "string",
      "maxLength": 500
    },
    "requires": {
      "default": {
        "env": [],
        "programs": []
      },
      "type": "object",
      "properties": {
        "env": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          }
        },
        "programs": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$"
          }
        }
      },
      "additionalProperties": false
    },
    "prFlows": {
      "type": "object",
      "properties": {
        "prActions": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 24
              },
              "command": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "timeoutSeconds": {
                "default": 120,
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 3600
              },
              "repos": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_.-]+\\/[A-Za-z0-9_.-]+$"
                }
              }
            },
            "required": [
              "id",
              "label",
              "command"
            ],
            "additionalProperties": false
          }
        },
        "sources": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 24
              },
              "command": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "timeoutSeconds": {
                "default": 120,
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 3600
              }
            },
            "required": [
              "id",
              "label",
              "command"
            ],
            "additionalProperties": false
          }
        },
        "actions": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 24
              },
              "command": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "timeoutSeconds": {
                "default": 120,
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 3600
              }
            },
            "required": [
              "id",
              "label",
              "command"
            ],
            "additionalProperties": false
          }
        },
        "rules": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80,
                "pattern": "\\S"
              },
              "source": {
                "type": "string",
                "minLength": 1
              },
              "priority": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "blocker",
                    "high",
                    "medium",
                    "low",
                    "unknown"
                  ]
                }
              },
              "paths": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "text": {
                "type": "string",
                "minLength": 1
              },
              "scope": {
                "default": "mine",
                "type": "string",
                "enum": [
                  "mine",
                  "team",
                  "both"
                ]
              },
              "action": {
                "anyOf": [
                  {
                    "type": "string",
                    "enum": [
                      "ask",
                      "fix-local",
                      "dismiss"
                    ]
                  },
                  {
                    "type": "string",
                    "pattern": "^run:(?:[a-z0-9][a-z0-9-]{0,39}\\/)?[a-z0-9][a-z0-9-]{0,63}$"
                  }
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              }
            },
            "required": [
              "name",
              "action"
            ],
            "additionalProperties": false,
            "if": {
              "properties": {
                "action": {
                  "const": "dismiss"
                }
              },
              "required": [
                "action"
              ]
            },
            "then": {
              "required": [
                "reason"
              ]
            }
          }
        }
      },
      "additionalProperties": false
    },
    "ui": {
      "type": "object",
      "properties": {
        "themes": {
          "default": [],
          "maxItems": 8,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40
              },
              "mode": {
                "type": "string",
                "enum": [
                  "dark",
                  "light"
                ]
              },
              "accentAnsiSlot": {
                "type": "string",
                "enum": [
                  "blue",
                  "magenta",
                  "none"
                ]
              },
              "chrome": {
                "type": "object",
                "properties": {
                  "bg": {
                    "type": "string",
                    "pattern": "^#[0-9a-fA-F]{6}$"
                  },
                  "bg-card": {
                    "type": "string",
                    "pattern": "^#[0-9a-fA-F]{6}$"
                  },
                  "bg-header": {
                    "type": "string",
                    "pattern": "^#[0-9a-fA-F]{6}$"
                  },
                  "bg-surface": {
                    "type": "string",
                    "pattern": "^#[0-9a-fA-F]{6}$"
                  },
                  "border": {
                    "type": "string",
                    "pattern": "^#[0-9a-fA-F]{6}$"
                  },
                  "border-dim": {
                    "type": "string",
                    "pattern": "^#[0-9a-fA-F]{6}$"
                  },
                  "border-hover": {
                    "type": "string",
                    "pattern": "^#[0-9a-fA-F]{6}$"
                  },
                  "text": {
                    "type": "string",
                    "pattern": "^#[0-9a-fA-F]{6}$"
                  },
                  "text-dim": {
                    "type": "string",
                    "pattern": "^#[0-9a-fA-F]{6}$"
                  },
                  "text-head": {
                    "type": "string",
                    "pattern": "^#[0-9a-fA-F]{6}$"
                  },
                  "text-muted": {
                    "type": "string",
                    "pattern": "^#[0-9a-fA-F]{6}$"
                  },
                  "accent": {
                    "type": "string",
                    "pattern": "^#[0-9a-fA-F]{6}$"
                  },
                  "accent-dim": {
                    "type": "string",
                    "pattern": "^#[0-9a-fA-F]{6}$"
                  }
                },
                "required": [
                  "bg",
                  "bg-card",
                  "bg-header",
                  "bg-surface",
                  "border",
                  "border-dim",
                  "border-hover",
                  "text",
                  "text-dim",
                  "text-head",
                  "text-muted",
                  "accent",
                  "accent-dim"
                ],
                "additionalProperties": false
              },
              "states": {
                "type": "object",
                "properties": {
                  "running": {
                    "type": "string",
                    "pattern": "^#[0-9a-fA-F]{6}$"
                  },
                  "waiting": {
                    "type": "string",
                    "pattern": "^#[0-9a-fA-F]{6}$"
                  },
                  "failed": {
                    "type": "string",
                    "pattern": "^#[0-9a-fA-F]{6}$"
                  },
                  "monitoring": {
                    "type": "string",
                    "pattern": "^#[0-9a-fA-F]{6}$"
                  },
                  "done": {
                    "type": "string",
                    "pattern": "^#[0-9a-fA-F]{6}$"
                  },
                  "initializing": {
                    "type": "string",
                    "pattern": "^#[0-9a-fA-F]{6}$"
                  },
                  "idle": {
                    "type": "string",
                    "pattern": "^#[0-9a-fA-F]{6}$"
                  },
                  "starting": {
                    "type": "string",
                    "pattern": "^#[0-9a-fA-F]{6}$"
                  },
                  "complete": {
                    "type": "string",
                    "pattern": "^#[0-9a-fA-F]{6}$"
                  }
                },
                "required": [
                  "running",
                  "waiting",
                  "failed",
                  "monitoring",
                  "done",
                  "initializing",
                  "idle",
                  "starting",
                  "complete"
                ],
                "additionalProperties": false
              },
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]{0,39}$"
              }
            },
            "required": [
              "label",
              "mode",
              "accentAnsiSlot",
              "chrome",
              "states",
              "id"
            ],
            "additionalProperties": false
          }
        },
        "panels": {
          "default": [],
          "maxItems": 8,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]{0,39}$"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 24
              },
              "entry": {
                "type": "string",
                "pattern": "^(?!\\/)(?!.*(?:^|\\/)\\.\\.?(?:\\/|$))[A-Za-z0-9._/-]{1,200}$"
              },
              "icon": {
                "type": "string",
                "pattern": "^(?!\\/)(?!.*(?:^|\\/)\\.\\.?(?:\\/|$))[A-Za-z0-9._/-]{1,200}$"
              },
              "reads": {
                "default": [],
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "sessions",
                    "focus",
                    "theme",
                    "my-prs",
                    "usage",
                    "attention",
                    "team-reviews"
                  ]
                }
              }
            },
            "required": [
              "id",
              "label",
              "entry"
            ],
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "name",
    "version"
  ],
  "additionalProperties": false
}
