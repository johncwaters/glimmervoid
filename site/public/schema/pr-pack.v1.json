{
  "$id": "https://glimmervoid.dev/schema/pr-pack.v1.json",
  "title": "Glimmervoid PR flows pack",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,39}$"
    },
    "version": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "description": {
      "type": "string",
      "maxLength": 500
    },
    "requires": {
      "default": {
        "env": [],
        "programs": []
      },
      "type": "object",
      "properties": {
        "env": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          }
        },
        "programs": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$"
          }
        }
      },
      "additionalProperties": false
    },
    "prActions": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 24
          },
          "command": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "timeoutSeconds": {
            "default": 120,
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 3600
          },
          "repos": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.-]+\\/[A-Za-z0-9_.-]+$"
            }
          }
        },
        "required": [
          "id",
          "label",
          "command"
        ],
        "additionalProperties": false
      }
    },
    "sources": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 24
          },
          "command": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "timeoutSeconds": {
            "default": 120,
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 3600
          }
        },
        "required": [
          "id",
          "label",
          "command"
        ],
        "additionalProperties": false
      }
    },
    "actions": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 24
          },
          "command": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "timeoutSeconds": {
            "default": 120,
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 3600
          }
        },
        "required": [
          "id",
          "label",
          "command"
        ],
        "additionalProperties": false
      }
    },
    "rules": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "\\S"
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "priority": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "blocker",
                "high",
                "medium",
                "low",
                "unknown"
              ]
            }
          },
          "paths": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "default": "mine",
            "type": "string",
            "enum": [
              "mine",
              "team",
              "both"
            ]
          },
          "action": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "ask",
                  "fix-local",
                  "dismiss"
                ]
              },
              {
                "type": "string",
                "pattern": "^run:(?:[a-z0-9][a-z0-9-]{0,39}\\/)?[a-z0-9][a-z0-9-]{0,63}$"
              }
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "required": [
          "name",
          "action"
        ],
        "additionalProperties": false,
        "if": {
          "properties": {
            "action": {
              "const": "dismiss"
            }
          },
          "required": [
            "action"
          ]
        },
        "then": {
          "required": [
            "reason"
          ]
        }
      }
    }
  },
  "required": [
    "name",
    "version"
  ],
  "additionalProperties": false
}
