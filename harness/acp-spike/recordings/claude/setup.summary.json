          {
            "value": "architecture-reviewer",
            "name": "architecture-reviewer",
            "description": "The architecture lane of qa-swarm. Takes every contract a supplied diff publishes or consumes across a repo or release line — a name, an id, a schema, a version, a folder another tool writes — and asks whether it is declared, versioned, and owned, so the next ordinary change on either side cannot break the other, in the shared STRUCTURED_FINDINGS format. Read-only, never edits. Spawned by qa-swarm only; a caller that spawns it directly skips scope pinning, lane selection, triage, and the verdict."
          },
          {
            "value": "boundary-reviewer",
            "name": "boundary-reviewer",
            "description": "The boundary lane of qa-swarm. Takes everything a supplied diff reads from or writes to that it does not own — a peer process, a worker, a cache, a shared file, git, the environment — and runs the states the happy path never sends, in the shared STRUCTURED_FINDINGS format. Read-only, never edits. Spawned by qa-swarm only; a caller that spawns it directly skips scope pinning, lane selection, triage, and the verdict."
          },
          {
            "value": "caveman:cavecrew-builder",
            "name": "caveman:cavecrew-builder",
            "description": "Surgical 1-2 file edit. Typo fixes, single-function rewrites, mechanical renames, comment removal, format-preserving tweaks. Hard refuses 3+ file scope. Returns caveman diff receipt. Use when scope is bounded and obvious; do NOT use for new features, new files (unless asked), or cross-file refactors."
          },
          {
            "value": "caveman:cavecrew-investigator",
            "name": "caveman:cavecrew-investigator",
            "description": "Read-only code locator. Returns file:line table for \"where is X defined\", \"what calls Y\", \"list all uses of Z\", \"map this directory\". Output is caveman-compressed, one row per hit, to keep main-thread context small. Refuses to suggest fixes."
          },
          {
            "value": "caveman:cavecrew-reviewer",
            "name": "caveman:cavecrew-reviewer",
            "description": "Diff/branch/file reviewer. One line per finding, severity-tagged, no praise, no scope creep. Output format `path:line: <emoji> <severity>: <problem>. <fix>.` Use for \"review this PR\", \"review my diff\", \"audit this file\". Skips formatting nits unless they change meaning."
          },
          {
            "value": "plan-challenger",
            "name": "plan-challenger",
            "description": "The adversarial challenger lane of plan-challenge. Argues CUT/SHRINK/KEEP for every numbered step of a supplied plan according to its lane brief, in the shared STEP_VERDICTS format. Read-only, never edits. Spawned by plan-challenge only; a caller that spawns it directly skips lane dispatch, convergence, and the stamp."
          },
          {
            "value": "qa-code-reviewer",
            "name": "qa-code-reviewer",
            "description": "The general-correctness lane of qa-swarm. Produces severity-rated findings on a supplied diff, logic defects first, in the shared STRUCTURED_FINDINGS format. Read-only, never edits. Spawned by qa-swarm only; a caller that spawns it directly skips scope pinning, lane selection, triage, and the verdict."
          },
          {
            "value": "redteam-reviewer",
            "name": "redteam-reviewer",
            "description": "The red-team lane of qa-swarm. Takes every guarantee a supplied diff adds or leans on — a gate, a limit, a revocation, a charge, a cleanup — and tries to make it not happen, in the shared STRUCTURED_FINDINGS format. Read-only, never edits. Spawned by qa-swarm only; a caller that spawns it directly skips scope pinning, lane selection, triage, and the verdict."
          },
          {
            "value": "security-reviewer",
            "name": "security-reviewer",
            "description": "The security lane of qa-swarm. Hunts vulnerabilities, secrets, unsafe patterns, and missing authorization in a supplied diff, in the shared STRUCTURED_FINDINGS format. Read-only, never edits. Spawned by qa-swarm only; a caller that spawns it directly skips scope pinning, lane selection, triage, and the verdict."
          }
        ]
