import fs from 'node:fs/promises';
import http from 'node:http';
import path from 'node:path';

const port = Number(process.argv[2] ?? 4173);
const demoLifetimeMs = 90_000;
const root = path.resolve('web');
const types = { '.html': 'text/html', '.css': 'text/css', '.js': 'text/javascript', '.svg': 'image/svg+xml' };

http.createServer(async (request, response) => {
  const pathname = new URL(request.url, 'http://localhost').pathname.replace(/^\/app-preview\/[^/]+/, '');
  const relative = pathname.endsWith('/') ? `${pathname}index.html` : pathname;
  const file = path.join(root, path.normalize(relative));
  if (!file.startsWith(root)) { response.writeHead(403).end(); return; }
  const body = await fs.readFile(file).catch(() => null);
  if (!body) { response.writeHead(404).end('not found'); return; }
  response.writeHead(200, { 'content-type': types[path.extname(file)] ?? 'application/octet-stream' }).end(body);
}).listen(port, '127.0.0.1', () => console.log(`serving web/ on http://localhost:${port}`));

setTimeout(() => process.exit(0), demoLifetimeMs);
