{
  "name": "glimmervoid",
  "version": "0.28.2",
  "description": "Mission control for coding agents: run and supervise Claude Code, Codex and Grok sessions in parallel git worktrees from one local browser dashboard",
  "main": "dist/server/index.js",
  "type": "module",
  "imports": {
    "#shared/*": "./shared/*"
  },
  "bin": {
    "glimmervoid": "dist/bin/glimmervoid.js"
  },
  "files": [
    "dist/",
    "!dist/client/pictures/",
    "!dist/client/AGENTS.md",
    "scripts/postinstall.mjs",
    "scripts/recover-handoff.mjs",
    "scripts/prepare-build.js"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "author": "John C. Waters <john@johncwaters.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johncwaters/glimmervoid.git"
  },
  "homepage": "https://github.com/johncwaters/glimmervoid#readme",
  "bugs": {
    "url": "https://github.com/johncwaters/glimmervoid/issues"
  },
  "keywords": [
    "claude",
    "claude-code",
    "codex",
    "coding-agents",
    "ai-agents",
    "agent-orchestrator",
    "agent-manager",
    "parallel-agents",
    "git-worktree",
    "terminal",
    "dashboard",
    "session-manager",
    "xterm",
    "windows",
    "linux",
    "macos"
  ],
  "scripts": {
    "start": "node dist/server/index.js",
    "lint": "biome check .",
    "test": "node --import ./tests/helpers/isolate-home.ts --test \"tests/**/*.test.ts\"",
    "typecheck": "tsc --project tsconfig.json && tsc --project tsconfig.public.json && tsc --project tsconfig.browser-harness.json",
    "test:browser": "node test/browser/harness.ts",
    "site:capture": "node test/site-capture/capture.ts",
    "site:record": "node test/site-capture/record.ts",
    "site:dev": "npm --prefix site run dev",
    "site:build": "npm --prefix site run build",
    "test:container": "docker build -f test/container/Dockerfile -t glimmervoid-remote-test . && docker run --rm glimmervoid-remote-test",
    "dev": "vite",
    "build": "node scripts/build.mjs",
    "postinstall": "node scripts/postinstall.mjs",
    "prepare": "node scripts/prepare-build.js",
    "release": "node scripts/release.ts",
    "docs:config": "node scripts/generate-config-docs.ts"
  },
  "dependencies": {
    "@parcel/watcher": "^2.6.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/headless": "^6.0.0",
    "@xterm/xterm": "^6.0.0",
    "express": "^5.2.1",
    "node-pty": "^1.1.0",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "allowScripts": {
    "node-pty": true
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.3",
    "playwright-core": "1.63.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  }
}
