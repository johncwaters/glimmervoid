{
  "name": "glimmervoid",
  "version": "0.54.1-next.0",
  "description": "See it before it's built. Every terminal coding agent shows its prototypes, architecture and plans on a whiteboard you mark up, and works in its own git worktree. Only the one that needs you asks for your attention.",
  "main": "dist/server/index.js",
  "type": "module",
  "imports": {
    "#shared/*": "./shared/*"
  },
  "bin": {
    "glimmervoid": "dist/bin/glimmervoid.js"
  },
  "files": [
    "dist/",
    "!dist/client/pictures/",
    "!dist/client/AGENTS.md",
    "scripts/postinstall.mjs",
    "scripts/recover-handoff.mjs",
    "scripts/prepare-build.js"
  ],
  "engines": {
    "node": ">=24.15.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "author": "John C. Waters <john@johncwaters.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johncwaters/glimmervoid.git"
  },
  "homepage": "https://glimmervoid.dev",
  "bugs": {
    "url": "https://github.com/johncwaters/glimmervoid/issues"
  },
  "keywords": [
    "claude",
    "claude-code",
    "codex",
    "kimi-code",
    "coding-agents",
    "ai-agents",
    "agent-orchestrator",
    "agent-manager",
    "parallel-agents",
    "git-worktree",
    "terminal",
    "dashboard",
    "session-manager",
    "xterm",
    "windows",
    "linux",
    "macos"
  ],
  "scripts": {
    "start": "node dist/server/index.js",
    "lint": "biome check . --max-diagnostics=none",
    "test": "coherence spec --check && coherence lexicon --check && node --import ./tests/helpers/isolate-home.ts --test \"tests/**/*.test.ts\"",
    "test:files": "node --import ./tests/helpers/isolate-home.ts --test \"tests/gates/*.test.ts\"",
    "check:fast": "coherence spec --check && coherence lexicon --check && node --import ./tests/helpers/isolate-home.ts --test \"tests/gates/*.test.ts\" \"tests/*contract*.test.ts\"",
    "typecheck": "tsc --project tsconfig.json && tsc --project tsconfig.public.json && tsc --project tsconfig.browser-harness.json",
    "test:browser": "node harness/browser/harness.ts",
    "test:e2e": "node scripts/e2e.ts",
    "site:capture": "node harness/site-capture/capture.ts",
    "site:record": "node harness/site-capture/record.ts",
    "site:dev": "npm --prefix site run dev",
    "site:build": "npm --prefix site run build",
    "test:container": "docker build -f harness/container/Dockerfile -t glimmervoid-remote-test . && docker run --rm glimmervoid-remote-test",
    "dev": "vite",
    "build": "node scripts/build.mjs",
    "postinstall": "node scripts/postinstall.mjs",
    "prepare": "node scripts/prepare-build.js",
    "release": "node scripts/release.ts",
    "docs:config": "node scripts/generate-config-docs.ts",
    "animals:build": "node scripts/generate-animal-sprites.ts",
    "dist": "node scripts/build.mjs --binary --binary-out ."
  },
  "dependencies": {
    "@1password/sdk": "0.5.0",
    "@modelcontextprotocol/node": "2.1.2",
    "@modelcontextprotocol/server": "2.4.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-serialize": "0.14.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/headless": "6.0.0",
    "@xterm/xterm": "6.0.0",
    "cc-safety-net": "2.7.1",
    "express": "5.3.0",
    "fs-native-extensions": "1.5.3",
    "httpxy": "0.5.6",
    "node-pty": "1.1.0",
    "sharp": "0.35.5",
    "ws": "8.22.1",
    "zod": "4.6.7"
  },
  "optionalDependencies": {
    "ffmpeg-static": "5.3.0"
  },
  "allowScripts": {
    "node-pty": true
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@posthog/coherence": "1.13.0",
    "@tailwindcss/vite": "4.3.4",
    "@types/node": "26.6.6",
    "@yao-pkg/pkg": "6.25.0",
    "playwright-core": "1.64.1",
    "tailwindcss": "4.3.4",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "pkg": {
    "scripts": [
      "dist/**/*.mjs",
      "node_modules/cc-safety-net/dist/**/*.js"
    ],
    "assets": [
      "dist/client/**/*",
      "dist/examples/**/*",
      "dist/schema/**/*",
      "dist/session/remote-setup/**/*",
      "dist/package.json",
      "package.json",
      "node_modules/@img/**/*",
      "node_modules/ffmpeg-static/ffmpeg*",
      "node_modules/node-pty/build/Release/*.node",
      "node_modules/node-pty/prebuilds/**/*",
      "node_modules/fs-native-extensions/prebuilds/**/*",
      "node_modules/cc-safety-net/package.json",
      "node_modules/cc-safety-net/dist/**/package.json"
    ]
  }
}
