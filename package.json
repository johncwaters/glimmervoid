{
  "name": "glimmervoid",
  "version": "0.45.1-next.0",
  "description": "Mission control that ships. Not a terminal multiplexer: Claude Code, Codex and Grok each work in their own git worktree, and the one session that needs you comes to the front",
  "main": "dist/server/index.js",
  "type": "module",
  "imports": {
    "#shared/*": "./shared/*"
  },
  "bin": {
    "glimmervoid": "dist/bin/glimmervoid.js"
  },
  "files": [
    "dist/",
    "!dist/client/pictures/",
    "!dist/client/AGENTS.md",
    "scripts/postinstall.mjs",
    "scripts/recover-handoff.mjs",
    "scripts/prepare-build.js"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "author": "John C. Waters <john@johncwaters.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johncwaters/glimmervoid.git"
  },
  "homepage": "https://glimmervoid.dev",
  "bugs": {
    "url": "https://github.com/johncwaters/glimmervoid/issues"
  },
  "keywords": [
    "claude",
    "claude-code",
    "codex",
    "coding-agents",
    "ai-agents",
    "agent-orchestrator",
    "agent-manager",
    "parallel-agents",
    "git-worktree",
    "terminal",
    "dashboard",
    "session-manager",
    "xterm",
    "windows",
    "linux",
    "macos"
  ],
  "scripts": {
    "start": "node dist/server/index.js",
    "lint": "biome check . --max-diagnostics=none",
    "test": "coherence spec --check && coherence lexicon --check && node --import ./tests/helpers/isolate-home.ts --test \"tests/**/*.test.ts\"",
    "test:files": "node --import ./tests/helpers/isolate-home.ts --test",
    "typecheck": "tsc --project tsconfig.json && tsc --project tsconfig.public.json && tsc --project tsconfig.browser-harness.json",
    "test:browser": "node harness/browser/harness.ts",
    "site:capture": "node harness/site-capture/capture.ts",
    "site:record": "node harness/site-capture/record.ts",
    "site:dev": "npm --prefix site run dev",
    "site:build": "npm --prefix site run build",
    "test:container": "docker build -f harness/container/Dockerfile -t glimmervoid-remote-test . && docker run --rm glimmervoid-remote-test",
    "dev": "vite",
    "build": "node scripts/build.mjs",
    "postinstall": "node scripts/postinstall.mjs",
    "prepare": "node scripts/prepare-build.js",
    "release": "node scripts/release.ts",
    "docs:config": "node scripts/generate-config-docs.ts",
    "animals:build": "node scripts/generate-animal-sprites.ts"
  },
  "dependencies": {
    "@anthropic-ai/sandbox-runtime": "0.0.79",
    "@parcel/watcher": "^2.6.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/headless": "^6.0.0",
    "@xterm/xterm": "^6.0.0",
    "cc-safety-net": "2.6.16",
    "express": "^5.3.0",
    "fs-native-extensions": "1.5.2",
    "node-pty": "^1.1.0",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "allowScripts": {
    "node-pty": true
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@posthog/coherence": "1.8.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "playwright-core": "1.64.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
